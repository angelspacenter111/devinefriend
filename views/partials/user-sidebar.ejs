<!-- Left Sidebar User Panel -->
<aside class="sidebar-panel">
  <div class="sidebar-brand">
    <a class="navbar-brand d-flex align-items-center" href="/">
      <i class="bi bi-heart-pulse-fill text-primary-pink me-2" style="font-size: 1.3rem; color: #E91E8F;"></i>
      <span class="text-white fw-extrabold text-uppercase brand-text">Friend</span>
    </a>
  </div>

  <div class="px-3 py-2 mx-3 mb-3 rounded-3 advisor-sidebar-status text-white-50">
    <div class="d-flex align-items-center justify-content-between">
      <span class="small text-white"><i class="bi bi-person-heart me-1 text-primary-pink"></i> Life Advisor</span>
      <span class="badge <%= typeof isAdvisorOnline !== 'undefined' && isAdvisorOnline ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-secondary-subtle text-secondary border border-secondary-subtle' %> rounded-pill px-2.5 py-0.5 small advisor-status-badge">
        <span class="status-indicator-dot <%= typeof isAdvisorOnline !== 'undefined' && isAdvisorOnline ? 'online' : 'offline' %> me-1"></span>
        <span class="advisor-status-text"><%= typeof isAdvisorOnline !== 'undefined' && isAdvisorOnline ? 'Online' : 'Offline' %></span>
      </span>
    </div>
  </div>

  <ul class="sidebar-menu">
    <li class="<%= (typeof activeTab !== 'undefined' && activeTab === 'dashboard') ? 'active' : '' %>">
      <a href="/user/dashboard"><i class="bi bi-grid-fill"></i> Dashboard</a>
    </li>
    <li class="<%= (typeof activeTab !== 'undefined' && activeTab === 'wallet') ? 'active' : '' %>">
      <a href="/user/wallet"><i class="bi bi-wallet2"></i> My Wallet</a>
    </li>
    <li class="<%= (typeof activeTab !== 'undefined' && activeTab === 'buy-credits') ? 'active' : '' %>">
      <a href="/user/buy-credits"><i class="bi bi-credit-card-2-front"></i> Buy Credits</a>
    </li>
    <li class="<%= (typeof activeTab !== 'undefined' && activeTab === 'transactions') ? 'active' : '' %>">
      <a href="/user/transactions"><i class="bi bi-receipt"></i> Transactions</a>
    </li>
    <li class="<%= (typeof activeTab !== 'undefined' && activeTab === 'call-history') ? 'active' : '' %>">
      <a href="/user/call-history"><i class="bi bi-clock-history"></i> Call History</a>
    </li>
    <li class="<%= (typeof activeTab !== 'undefined' && activeTab === 'profile') ? 'active' : '' %>">
      <a href="/user/profile"><i class="bi bi-person-fill-gear"></i> Profile Settings</a>
    </li>
    <li class="border-top border-secondary-subtle my-3 pt-3">
      <a href="/faq"><i class="bi bi-question-circle"></i> Help & Support</a>
    </li>
  </ul>
  <div class="sidebar-footer p-3">
    <a href="/logout" class="btn btn-outline-danger w-100 rounded-pill py-2 d-flex align-items-center justify-content-center gap-2 fw-semibold">
      <i class="bi bi-box-arrow-right"></i> Logout
    </a>
  </div>
</aside>

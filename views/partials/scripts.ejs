<!-- Application State & Scripts -->
<script>
  <% if (typeof user !== 'undefined' && user) { %>
    window.sessionUser = {
      id: "<%= user._id %>",
      name: "<%= user.name %>",
      mobile: "<%= user.mobile %>",
      email: "<%= user.email || '' %>",
      credits: <%= user.credits %>,
      role: "<%= user.role || 'user' %>",
      joined: "<%= user.joined ? user.joined.toISOString().split('T')[0] : '' %>"
    };
  <% } else { %>
    window.sessionUser = null;
  <% } %>
  window.isAdvisorOnline = <%= typeof isAdvisorOnline !== 'undefined' && isAdvisorOnline ? 'true' : 'false' %>;
</script>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/custom.js"></script>



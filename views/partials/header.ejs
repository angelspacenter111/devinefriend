          <a class="nav-link <%= (typeof activeTab !== 'undefined' && activeTab === 'how-it-works') ? 'active' : '' %>" href="/how-it-works">How It Works</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= (typeof activeTab !== 'undefined' && activeTab === 'support') ? 'active' : '' %>" href="/support">How I Support</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= (typeof activeTab !== 'undefined' && activeTab === 'pricing') ? 'active' : '' %>" href="/pricing">Pricing</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= (typeof activeTab !== 'undefined' && activeTab === 'faq') ? 'active' : '' %>" href="/faq">FAQ</a>
        </li>
      </ul>

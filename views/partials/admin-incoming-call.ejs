<!-- Global Admin Incoming Call Modal & WebRTC Signaling Receiver -->
<div class="modal fade" id="incomingCallModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true" style="z-index: 9999;">
  <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
    <div class="modal-content rounded-4 border-0 shadow-lg text-center p-4">
      <div class="modal-body py-4">
        <div class="call-circle-avatar mb-3" style="width: 100px; height: 100px; margin: 0 auto; position: relative;">
          <div class="call-pulse-animation"></div>
          <div class="call-pulse-animation-2"></div>
          <div class="rounded-circle d-flex align-items-center justify-content-center text-white" id="modal-call-icon-bg" style="width: 100%; height: 100%; font-size: 2.2rem; background: var(--brand-gradient, linear-gradient(135deg, #1769E0 0%, #E91E8F 100%));">
            <i class="bi bi-telephone-inbound-fill" id="modal-call-icon"></i>
          </div>
        </div>
        <div class="mb-2">
          <span class="badge rounded-pill px-3 py-1.5" id="modal-call-type-badge" style="background: rgba(23,105,224,0.1); color: #1769E0; font-size: 0.8rem;">
            Voice Call (1 Coin/min)
          </span>
        </div>
        <h4 class="fw-bold mb-1" id="modal-call-title">Incoming Call</h4>
        <p class="text-muted small mb-0">Client <strong id="modal-caller-name">User</strong> is requesting to Talk With Ashu.</p>
      </div>
      <div class="d-flex gap-2 justify-content-center mt-3">
        <button type="button" class="btn btn-outline-danger px-4 py-2.5 rounded-pill" id="btn-incoming-decline">Decline</button>
        <button type="button" class="btn btn-brand px-4 py-2.5 rounded-pill" id="btn-incoming-accept">Accept Call</button>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    let adminSocket = null;
    let activeCallId = null;
    let activeCallerId = null;
    let activeCallType = 'Voice';
    let isProcessingAction = false;
    let ringtoneTimer = null;
    let audioCtx = null;
    let originalDocTitle = document.title;
    let titleFlashTimer = null;

    function playRingChime() {
      try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!AudioContext) return;
        if (!audioCtx || audioCtx.state === 'closed') {
          audioCtx = new AudioContext();
        }
        if (audioCtx.state === 'suspended') {
          audioCtx.resume().catch(function() {});
        }

        const now = audioCtx.currentTime;
        const osc1 = audioCtx.createOscillator();
        const osc2 = audioCtx.createOscillator();
        const gainNode = audioCtx.createGain();

        osc1.type = 'sine';
        osc1.frequency.setValueAtTime(440, now);
        osc2.type = 'sine';
        osc2.frequency.setValueAtTime(480, now);

        gainNode.gain.setValueAtTime(0, now);
        gainNode.gain.linearRampToValueAtTime(0.18, now + 0.05);
        gainNode.gain.setValueAtTime(0.18, now + 1.0);
        gainNode.gain.linearRampToValueAtTime(0, now + 1.2);

        osc1.connect(gainNode);
        osc2.connect(gainNode);
        gainNode.connect(audioCtx.destination);

        osc1.start(now);
        osc2.start(now);
        osc1.stop(now + 1.25);
        osc2.stop(now + 1.25);
      } catch (e) {
        console.warn("[Admin Ringtone] Audio playback warning:", e);
      }
    }

    function triggerAdminVibrate() {
      try {
        if ('vibrate' in navigator) {
          navigator.vibrate([800, 300, 800, 300, 800]);
        }
      } catch (e) {}
    }

    function unlockAudioContext() {
      try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!AudioContext) return;
        if (!audioCtx || audioCtx.state === 'closed') {
          audioCtx = new AudioContext();
        }
        if (audioCtx.state === 'suspended') {
          audioCtx.resume().catch(function() {});
        }
      } catch (e) {}
    }
    document.addEventListener('click', unlockAudioContext, { passive: true });
    document.addEventListener('touchstart', unlockAudioContext, { passive: true });

    function startAdminRingtone(callerName) {
      stopAdminRingtone();
      playRingChime();
      triggerAdminVibrate();
      ringtoneTimer = setInterval(function() {
        playRingChime();
        triggerAdminVibrate();
      }, 3000);

      originalDocTitle = document.title;
      let toggle = false;
      titleFlashTimer = setInterval(function() {
        document.title = toggle ? `🔔 CALL FROM ${callerName || 'Client'}!` : `📞 INCOMING CALL - ANSWER NOW`;
        toggle = !toggle;
      }, 700);

      if ("Notification" in window && Notification.permission === "granted") {
        try {
          new Notification(`Incoming Call from ${callerName || 'Companion User'}`, {
            body: 'Click here to answer the call.',
            icon: '/images/logo.png'
          });
        } catch (nErr) {}
      }
    }

    function stopAdminRingtone() {
      if (ringtoneTimer) {
        clearInterval(ringtoneTimer);
        ringtoneTimer = null;
      }
      try {
        if ('vibrate' in navigator) navigator.vibrate(0);
      } catch (e) {}
      if (titleFlashTimer) {
        clearInterval(titleFlashTimer);
        titleFlashTimer = null;
        if (originalDocTitle) document.title = originalDocTitle;
      }
      if (audioCtx && audioCtx.state === 'running') {
        try { audioCtx.suspend(); } catch (e) {}
      }
    }

    function getIncomingModalInstance() {
      const modalEl = document.getElementById('incomingCallModal');
      return modalEl && typeof bootstrap !== 'undefined' ? bootstrap.Modal.getOrCreateInstance(modalEl) : null;
    }

    function resetIncomingCallState() {
      stopAdminRingtone();
      activeCallId = null;
      activeCallerId = null;
      isProcessingAction = false;
      const declineBtn = document.getElementById('btn-incoming-decline');
      const acceptBtn = document.getElementById('btn-incoming-accept');
      if (declineBtn) {
        declineBtn.disabled = false;
        declineBtn.innerText = 'Decline';
      }
      if (acceptBtn) {
        acceptBtn.disabled = false;
        acceptBtn.innerText = 'Accept Call';
      }
    }

    function sendAdminJoin() {
      if (adminSocket && adminSocket.connected) {
        console.log(`[Admin Signaling] Emitting admin-join. Socket ID: ${adminSocket.id}`);
        adminSocket.emit('admin-join', {
          adminId: (window.sessionUser && window.sessionUser.id) || null,
          name: (window.sessionUser && window.sessionUser.name) || 'Ashu'
        });
      }
    }

    function initAdminIncomingCall() {
      if (window.location.pathname.startsWith('/admin/call')) {
        return;
      }
      if (typeof io === 'undefined') {
        setTimeout(initAdminIncomingCall, 150);
        return;
      }

      // Request browser notification permission once on user interaction
      if ("Notification" in window && Notification.permission === "default") {
        document.addEventListener('click', function reqNotif() {
          Notification.requestPermission();
          document.removeEventListener('click', reqNotif);
        }, { once: true });
      }

      console.log("[Admin Signaling] Initializing socket connection...");
      adminSocket = io({ transports: ['websocket', 'polling'] });

      adminSocket.on('connect', function() {
        console.log(`[Admin Signaling] Connected. Socket ID: ${adminSocket.id}`);
        sendAdminJoin();
      });

      adminSocket.on('connect_error', function(err) {
        console.error("[Admin Signaling Error] Connection error:", err);
      });

      adminSocket.on('disconnect', function(reason) {
        console.warn(`[Admin Signaling Warning] Disconnected: ${reason}`);
      });

      // Handle incoming call alert from any user
      adminSocket.on('incoming-call-alert', function(data) {
        console.log("[Admin Signaling] Received incoming-call-alert:", data);
        if (!data || !data.callId) return;

        activeCallId = data.callId;
        activeCallerId = data.callerId || '';
        activeCallType = data.callType || 'Voice';
        isProcessingAction = false;

        const isVideo = activeCallType === 'Video';
        const callerNameEl = document.getElementById('modal-caller-name');
        if (callerNameEl) {
          callerNameEl.innerText = data.callerName || 'Companion User';
        }

        const typeBadge = document.getElementById('modal-call-type-badge');
        const callTitle = document.getElementById('modal-call-title');
        const callIcon = document.getElementById('modal-call-icon');

        if (typeBadge) {
          if (isVideo) {
            typeBadge.className = 'badge rounded-pill px-3 py-1.5 bg-purple-subtle text-purple border border-purple-subtle';
            typeBadge.innerHTML = '<i class="bi bi-camera-video-fill me-1"></i> Video Call (2 Coins/min)';
          } else {
            typeBadge.className = 'badge rounded-pill px-3 py-1.5 bg-primary-subtle text-primary border border-primary-subtle';
            typeBadge.innerHTML = '<i class="bi bi-telephone-fill me-1"></i> Voice Call (1 Coin/min)';
          }
        }
        if (callTitle) {
          callTitle.innerText = isVideo ? 'Incoming Video Call' : 'Incoming Voice Call';
        }
        if (callIcon) {
          callIcon.className = isVideo ? 'bi bi-camera-video-fill' : 'bi bi-telephone-inbound-fill';
        }

        // Persist in localStorage for /admin/call
        localStorage.setItem("active_call_id", data.callId);
        localStorage.setItem("active_call_type", activeCallType);
        if (data.callerId) localStorage.setItem("webrtc_caller_id", data.callerId);
        if (data.callerName) localStorage.setItem("webrtc_caller_name", data.callerName);

        // Start ringing sound and flash document title
        startAdminRingtone(data.callerName);

        const modal = getIncomingModalInstance();
        if (modal) {
          console.log("[Admin UI] Showing incomingCallModal for Call ID:", activeCallId);
          modal.show();
        }
      });

      // Dismiss modal if caller cancels or disconnects
      adminSocket.on('call-cancelled', function(data) {
        if (data && activeCallId && data.callId === activeCallId) {
          console.log(`[Admin Signaling] Call ${data.callId} cancelled by caller.`);
          stopAdminRingtone();
          const callTitle = document.getElementById('modal-call-title');
          if (callTitle) callTitle.innerHTML = '<span class="text-danger"><i class="bi bi-x-circle me-1"></i> Call Cancelled</span>';
          const acceptBtn = document.getElementById('btn-incoming-accept');
          if (acceptBtn) {
            acceptBtn.disabled = true;
            acceptBtn.innerText = 'Cancelled by User';
          }
          const declineBtn = document.getElementById('btn-incoming-decline');
          if (declineBtn) declineBtn.disabled = true;

          setTimeout(function() {
            const modal = getIncomingModalInstance();
            if (modal) modal.hide();
            resetIncomingCallState();
          }, 1500);
        }
      });

      adminSocket.on('call-dismissed', function(data) {
        if (data && activeCallId && data.callId === activeCallId) {
          console.log(`[Admin Signaling] Call ${data.callId} dismissed.`);
          const modal = getIncomingModalInstance();
          if (modal) modal.hide();
          resetIncomingCallState();
        }
      });

      const modalEl = document.getElementById('incomingCallModal');
      if (modalEl) {
        modalEl.addEventListener('hidden.bs.modal', function() {
          resetIncomingCallState();
        });
      }

      // Accept Call Action
      const acceptBtn = document.getElementById('btn-incoming-accept');
      if (acceptBtn) {
        acceptBtn.addEventListener('click', function() {
          if (isProcessingAction) return;
          if (!activeCallId) {
            console.warn("[Admin UI] Cannot accept: activeCallId is missing.");
            return;
          }
          isProcessingAction = true;
          stopAdminRingtone();

          console.log(`[Admin UI] Accepting call ID: ${activeCallId}. Redirecting to /admin/call...`);
          acceptBtn.disabled = true;
          acceptBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Connecting...';
          const declineBtn = document.getElementById('btn-incoming-decline');
          if (declineBtn) declineBtn.disabled = true;

          const targetCallId = activeCallId;
          const targetCallerId = activeCallerId || '';
          const targetCallType = activeCallType || 'Voice';
          window.location.href = `/admin/call?callId=${encodeURIComponent(targetCallId)}&callerId=${encodeURIComponent(targetCallerId)}&type=${encodeURIComponent(targetCallType.toLowerCase())}`;
        });
      }

      // Decline Call Action
      const declineBtn = document.getElementById('btn-incoming-decline');
      if (declineBtn) {
        declineBtn.addEventListener('click', function() {
          if (isProcessingAction) return;
          isProcessingAction = true;

          console.log(`[Admin UI] Declining call ID: ${activeCallId}...`);
          declineBtn.disabled = true;
          declineBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Declining...';
          const acceptBtn = document.getElementById('btn-incoming-accept');
          if (acceptBtn) acceptBtn.disabled = true;

          if (adminSocket && activeCallId) {
            adminSocket.emit('admin-reject-call', { callId: activeCallId, callerId: activeCallerId });
          }
          const modal = getIncomingModalInstance();
          if (modal) modal.hide();
          resetIncomingCallState();
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAdminIncomingCall);
    } else {
      initAdminIncomingCall();
    }
  })();
</script>

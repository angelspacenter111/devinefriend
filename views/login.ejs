<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>

	<body class="bg-soft-gradient min-vh-100 d-flex align-items-center py-5 position-relative">
		<div class="backdrop-glow"></div>

		<div class="container position-relative z-3">
			<div class="row justify-content-center">
				<div class="col-md-6 col-lg-5">

					<div class="text-center mb-4">
						<a class="navbar-brand d-inline-flex align-items-center mb-2" href="/">
							<i class="bi bi-heart-pulse-fill text-primary-pink me-2"
								style="font-size: 1.8rem; color: #E91E8F;"></i>
							<span class="brand-text text-uppercase fw-extrabold fs-3">Friend</span>
						</a>
						<p class="text-muted small">Talk. Be Heard. Feel Lighter.</p>
					</div>

					<div class="card-premium border-0 bg-white shadow-lg p-4 p-md-5">
						<div class="text-center mb-4">
							<h3 class="fw-bold text-dark">Welcome Back</h3>
							<p class="text-muted small">"Sometimes, you just need someone to talk to."</p>
						</div>

						<% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
							<div class="alert alert-danger mb-3 py-2.5 rounded-3 text-center small" role="alert">
								<i class="bi bi-exclamation-triangle-fill me-2"></i><%= errorMessage %>
							</div>
						<% } %>

						<form action="/login" method="POST" class="auth-form-validate">
							<div class="mb-3">
								<label for="login-mobile" class="form-label form-label-custom">Mobile Number</label>
								<div class="input-group">
									<span class="input-group-text bg-white border-end-0 border-1"
										style="border-radius: 10px 0 0 10px; border-color: rgba(24,32,51,0.1);"><i
											class="bi bi-telephone text-muted"></i></span>
									<input type="text" class="form-control form-control-custom border-start-0 ps-2"
										id="login-mobile" name="mobile" placeholder="+91 XXXXX XXXXX" required
										style="border-radius: 0 10px 10px 0;">
								</div>
							</div>

							<div class="mb-3">
								<label for="login-password" class="form-label form-label-custom">Password</label>
								<div class="input-group">
									<span class="input-group-text bg-white border-end-0 border-1"
										style="border-radius: 10px 0 0 10px; border-color: rgba(24,32,51,0.1);"><i
											class="bi bi-lock text-muted"></i></span>
									<input type="password" class="form-control form-control-custom border-start-0 ps-2"
										id="login-password" name="password" placeholder="••••••••" required
										style="border-radius: 0 10px 10px 0;">
								</div>
							</div>

							<div class="d-flex align-items-center justify-content-between mb-4 small">
								<div class="form-check">
									<input type="checkbox" class="form-check-input" id="remember-me">
									<label class="form-check-label text-muted" for="remember-me">Remember Me</label>
								</div>
								<a href="/forgot-password" class="text-primary-blue fw-semibold">Forgot Password?</a>
							</div>

							<button type="submit" class="btn btn-brand w-100 py-3 mb-3">Login</button>
						</form>

						<div class="text-center mt-3 small">
							<span class="text-muted">Don't have an account?</span>
							<a href="/register" class="text-primary-pink fw-semibold ms-1">Create Account</a>
						</div>
					</div>

					<div class="text-center mt-4">
						<a href="/" class="text-muted small"><i class="bi bi-arrow-left me-1"></i> Back to public
							home</a>
					</div>

				</div>
			</div>
		</div>

		<%- include('partials/scripts') %>
	</body>

</html>
<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>

	<body class="bg-soft-gradient min-vh-100 d-flex align-items-center py-5 position-relative">
		<div class="backdrop-glow"></div>

		<div class="container position-relative z-3">
			<div class="row justify-content-center">
				<div class="col-md-6 col-lg-5">

					<div class="text-center mb-4">
						<a class="navbar-brand d-inline-flex flex-column align-items-center mb-2" href="/">
							<img src="/images/logo.png" alt="Talk With Ashu Logo"
								class="brand-logo-img brand-logo-lg mb-2">
							<span class="brand-text text-uppercase fw-extrabold fs-3">Talk With Ashu</span>
						</a>
						<p class="text-muted small">Talk. Be Heard. Feel Lighter.</p>
					</div>

					<div class="card-premium border-0 bg-white shadow-lg p-4 p-md-5">
						<div class="text-center mb-4">
							<h3 class="fw-bold text-dark">Welcome Back</h3>
							<p class="text-muted small">"Sometimes, you just need someone to talk to."</p>
						</div>

						<% if (typeof successMessage !== 'undefined' && successMessage) { %>
							<div class="alert alert-success mb-3 py-2.5 rounded-3 text-center small" role="alert">
								<i class="bi bi-check-circle-fill me-2"></i>
								<%= successMessage %>
							</div>
						<% } %>

						<% if (typeof errorMessage !=='undefined' && errorMessage) { %>
							<div class="alert alert-danger mb-3 py-2.5 rounded-3 text-center small" role="alert">
								<i class="bi bi-exclamation-triangle-fill me-2"></i>
								<%= errorMessage %>
							</div>
						<% } %>

								<form action="/login" method="POST" class="auth-form-validate" id="login-form">
									<div class="mb-3">
										<label for="login-mobile" class="form-label form-label-custom">Contact Number</label>
										<div class="input-group">
											<span class="input-group-text bg-white border-end-0 border-1"
												style="border-radius: 10px 0 0 10px; border-color: rgba(24,32,51,0.1);"><i
													class="bi bi-telephone text-muted"></i></span>
											<input type="tel"
												class="form-control form-control-custom border-start-0 ps-2"
												id="login-mobile" name="mobile"
												value="<%= typeof formData !== 'undefined' && formData && formData.mobile ? formData.mobile : '' %>"
												placeholder="Enter contact number" 
												maxlength="10"
												inputmode="numeric"
												pattern="[0-9]*"
												autocomplete="tel"
												required
												style="border-radius: 0 10px 10px 0;">
										</div>
									</div>

									<div class="mb-3">
										<label for="login-password"
											class="form-label form-label-custom">Password</label>
										<div class="input-group">
											<span class="input-group-text bg-white border-end-0 border-1"
												style="border-radius: 10px 0 0 10px; border-color: rgba(24,32,51,0.1);"><i
													class="bi bi-lock text-muted"></i></span>
											<input type="password"
												class="form-control form-control-custom border-start-0 border-end-0 ps-2"
												id="login-password" 
												name="password" 
												placeholder="••••••••" 
												autocomplete="current-password"
												autocapitalize="none"
												autocorrect="off"
												spellcheck="false"
												required>
											<button type="button" class="input-group-text bg-white border-start-0 border-1 toggle-password-btn" data-target="login-password" style="border-radius: 0 10px 10px 0; border-color: rgba(24,32,51,0.1); cursor: pointer;">
												<i class="bi bi-eye text-muted"></i>
											</button>
										</div>
									</div>

									<div class="d-flex align-items-center justify-content-between mb-4 small">
										<div class="form-check">
											<input type="checkbox" class="form-check-input" id="remember-me">
											<label class="form-check-label text-muted" for="remember-me">Remember
												Me</label>
										</div>
										<a href="/forgot-password" class="text-primary-blue fw-semibold">Forgot
											Password?</a>
									</div>

									<button type="submit" class="btn btn-brand w-100 py-3 mb-3">Login</button>
								</form>

								<div class="text-center mt-3 small">
									<span class="text-muted">Don't have an account?</span>
									<a href="/register" class="text-primary-pink fw-semibold ms-1">Create Account</a>
								</div>
					</div>

					<div class="text-center mt-4">
						<a href="/" class="text-muted small"><i class="bi bi-arrow-left me-1"></i> Back to public
							home</a>
					</div>

				</div>
			</div>
		</div>

		<%- include('partials/scripts') %>

		<!-- Contact Number Validation & Input Formatting Script -->
		<script>
			(function () {
				const mobileInput = document.getElementById('login-mobile');
				const passwordInput = document.getElementById('login-password');
				const form = document.getElementById('login-form');

				// Password toggle visibility
				document.querySelectorAll('.toggle-password-btn').forEach(btn => {
					btn.addEventListener('click', function () {
						const targetId = this.getAttribute('data-target');
						const targetInput = document.getElementById(targetId);
						const icon = this.querySelector('i');
						if (targetInput) {
							if (targetInput.type === 'password') {
								targetInput.type = 'text';
								icon.classList.remove('bi-eye');
								icon.classList.add('bi-eye-slash');
							} else {
								targetInput.type = 'password';
								icon.classList.remove('bi-eye-slash');
								icon.classList.add('bi-eye');
							}
						}
					});
				});

				// Only numeric values accepted and maximum 10 digits
				if (mobileInput) {
					mobileInput.addEventListener('input', function () {
						this.value = this.value.replace(/\D/g, '').slice(0, 10);
					});
				}

				if (form && mobileInput) {
					form.addEventListener('submit', function (e) {
						const val = mobileInput.value.trim();

						if (!val || !/^\d+$/.test(val)) {
							e.preventDefault();
							e.stopPropagation();
							mobileInput.focus();
							mobileInput.classList.add('is-invalid');
							alert('Please enter a valid numeric contact number.');
							return false;
						}

						if (val.length > 10) {
							e.preventDefault();
							e.stopPropagation();
							mobileInput.focus();
							mobileInput.classList.add('is-invalid');
							alert('Contact number cannot exceed 10 digits.');
							return false;
						}

						mobileInput.classList.remove('is-invalid');
					});
				}
			})();
		</script>
	</body>

</html>

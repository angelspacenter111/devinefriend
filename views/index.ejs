<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>

	<body>

		<%- include('partials/header') %>

			<!-- Hero Section -->
			<section class="section-padding bg-soft-gradient position-relative overflow-hidden">
				<div class="backdrop-glow"></div>
				<div class="backdrop-glow-left"></div>
				<div class="container position-relative z-3">
					<div class="row align-items-center g-5">
						<!-- Hero Text -->
						<div class="col-lg-6">
							<span class="badge-category mb-3"><i class="bi bi-chat-heart me-2"></i> Someone to Talk
								To</span>
							<h1 class="display-4 fw-extrabold mb-4" style="line-height: 1.15; color: #182033;">
								Sometimes, You Just Need <span class="text-primary-blue" style="color: #1769E0;">Someone
									Who
									Listens.</span>
							</h1>
							<p class="lead text-muted mb-4 font-primary" style="font-size: 1.15rem; font-weight: 300;">
								Life can feel heavy when you have no one to talk to. I provide a private, respectful
								space where you can
								talk openly, share what you're going through, and simply be heard.
							</p>
							<div class="d-flex flex-column flex-sm-row gap-3">
								<a href="/user/dashboard" class="btn btn-brand px-5 py-3 fs-5">Talk With Ashu</a>
								<a href="/how-it-works" class="btn btn-outline-brand px-5 py-3 fs-5">How It Works</a>
							</div>
						</div>

						<!-- Hero Visual (Official Logo Showcase) -->
						<div class="col-lg-6 text-center">
							<div class="hero-logo-wrapper">
								<div class="hero-logo-glow"></div>
								<img src="/images/logo.png" alt="Talk With Ashu - Voice Companion and Emotional Support" class="hero-logo-img img-fluid">
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Trust Strip Section -->
			<section class="py-5 bg-white border-divider shadow-sm position-relative z-3">
				<div class="container">
					<div class="row g-4 justify-content-center text-center">
						<div class="col-md-3 col-6">
							<div class="d-flex align-items-center justify-content-center gap-3">
								<div class="fs-2 text-primary-pink"><i class="bi bi-shield-lock"></i></div>
								<div class="text-start">
									<h6 class="mb-0 fw-bold">Private Conversations</h6>
									<small class="text-muted">Strictly confidential</small>
								</div>
							</div>
						</div>
						<div class="col-md-3 col-6">
							<div class="d-flex align-items-center justify-content-center gap-3">
								<div class="fs-2 text-primary-blue"><i class="bi bi-people"></i></div>
								<div class="text-start">
									<h6 class="mb-0 fw-bold">Live Human Support</h6>
									<small class="text-muted">No bots or templates</small>
								</div>
							</div>
						</div>
						<div class="col-md-3 col-6">
							<div class="d-flex align-items-center justify-content-center gap-3">
								<div class="fs-2 text-purple"><i class="bi bi-wallet2"></i></div>
								<div class="text-start">
									<h6 class="mb-0 fw-bold">Simple Coin System</h6>
									<small class="text-muted">Pay only for active time</small>
								</div>
							</div>
						</div>
						<div class="col-md-3 col-6">
							<div class="d-flex align-items-center justify-content-center gap-3">
								<div class="fs-2 text-primary-blue"><i class="bi bi-emoji-smile"></i></div>
								<div class="text-start">
									<h6 class="mb-0 fw-bold">Respectful & Caring</h6>
									<small class="text-muted">Completely non-judgmental</small>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Video Carousel Showcase Section -->
			

			<!-- How I Can Support You Section -->
			<section class="section-padding bg-light">
				<div class="container">
					<div class="text-center max-width-600 mx-auto mb-5">
						<span class="badge-category mb-2">My Focus Areas</span>
						<h2 class="fw-bold mb-3">How I Can Support You</h2>
						<p class="text-muted">Every conversation is designed around your comfort. Here are common
							situations where
							talking to me can help you feel lighter.</p>
					</div>

					<div class="row g-4">
						<!-- 1. Lonely -->
						<div class="col-md-4">
							<div class="card-premium h-100 text-center text-sm-start">
								<div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light-lavender text-purple mb-4"
									style="width: 60px; height: 60px; font-size: 1.5rem;">
									<i class="bi bi-chat-quote"></i>
								</div>
								<h5 class="fw-bold mb-3">When You Feel Lonely</h5>
								<p class="text-muted mb-0">Sometimes life moves fast and leaves us behind. I am here as
									an attentive,
									supportive presence when you simply need someone to listen.</p>
							</div>
						</div>
						<!-- 2. Overwhelming -->
						<div class="col-md-4">
							<div class="card-premium h-100 text-center text-sm-start">
								<div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light-lavender text-primary-blue mb-4"
									style="width: 60px; height: 60px; font-size: 1.5rem; color: #1769E0;">
									<i class="bi bi-wind"></i>
								</div>
								<h5 class="fw-bold mb-3">When Life Feels Overwhelming</h5>
								<p class="text-muted mb-0">Work, family, or relationships can pile up quickly. Take a
									breath, speak your
									mind, and unpack the stress in a quiet space.</p>
							</div>
						</div>
						<!-- 3. Understand -->
						<div class="col-md-4">
							<div class="card-premium h-100 text-center text-sm-start">
								<div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light-lavender text-primary-pink mb-4"
									style="width: 60px; height: 60px; font-size: 1.5rem; color: #E91E8F;">
									<i class="bi bi-heart"></i>
								</div>
								<h5 class="fw-bold mb-3">When You Need to Be Understood</h5>
								<p class="text-muted mb-0">Share your thoughts without fear of evaluation. You don't
									need to justify
									your feelings; your experience is valid as it is.</p>
							</div>
						</div>
						<!-- 4. Difficult Day -->
						<div class="col-md-4">
							<div class="card-premium h-100 text-center text-sm-start">
								<div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light-lavender text-primary-blue mb-4"
									style="width: 60px; height: 60px; font-size: 1.5rem; color: #1769E0;">
									<i class="bi bi-brightness-high"></i>
								</div>
								<h5 class="fw-bold mb-3">When You Have a Difficult Day</h5>
								<p class="text-muted mb-0">A tough meeting or frustrating conversation can linger.
									Offloading that
									negative energy helps you close the day on a positive note.</p>
							</div>
						</div>
						<!-- 5. Encouragement -->
						<div class="col-md-4">
							<div class="card-premium h-100 text-center text-sm-start">
								<div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light-lavender text-purple mb-4"
									style="width: 60px; height: 60px; font-size: 1.5rem;">
									<i class="bi bi-award"></i>
								</div>
								<h5 class="fw-bold mb-3">When You Need Encouragement</h5>
								<p class="text-muted mb-0">Facing a hurdle or unsure of your direction? Talk it through
									to organize your
									thoughts and find validation to keep moving forward.</p>
							</div>
						</div>
						<!-- 6. Just Want to Talk -->
						<div class="col-md-4">
							<div class="card-premium h-100 text-center text-sm-start">
								<div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light-lavender text-primary-pink mb-4"
									style="width: 60px; height: 60px; font-size: 1.5rem; color: #E91E8F;">
									<i class="bi bi-telephone-inbound"></i>
								</div>
								<h5 class="fw-bold mb-3">When You Just Want to Talk</h5>
								<p class="text-muted mb-0">You don't need to be in crisis to talk to someone. You might
									want to share a
									small win or just chat with a friendly, welcoming voice.</p>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- How It Works Section -->
			<section class="section-padding bg-white border-divider">
				<div class="container">
					<div class="text-center max-width-600 mx-auto mb-5">
						<span class="badge-category mb-2">Simplicity First</span>
						<h2 class="fw-bold mb-3">How It Works</h2>
						<p class="text-muted">Connecting with me takes just a few steps. Everything is managed through a
							simple
							system.</p>
					</div>

					<div class="row g-4 text-center">
						<div class="col-md-3 step-card">
							<div class="step-number">01</div>
							<h5 class="fw-bold mb-2">Create Your Account</h5>
							<p class="text-muted px-3">Sign up with your mobile number to create your profile securely.
							</p>
						</div>
						<div class="col-md-3 step-card">
							<div class="step-number">02</div>
							<h5 class="fw-bold mb-2">Purchase Coins</h5>
							<p class="text-muted px-3">Buy conversation coins. 1 coin equals 1 minute of calling time.
							</p>
						</div>
						<div class="col-md-3 step-card">
							<div class="step-number">03</div>
							<h5 class="fw-bold mb-2">Start a Voice & Video Call</h5>
							<p class="text-muted px-3">Press the call button inside the dashboard to connect instantly.
							</p>
						</div>
						<div class="col-md-3 step-card">
							<div class="step-number">04</div>
							<h5 class="fw-bold mb-2">Conect With Us</h5>
							<p class="text-muted px-3">Start conversation with us and get support you need.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Simple Coin System Section -->
			<section class="section-padding bg-light">
				<div class="container">
					<div class="row align-items-center g-5">
						<div class="col-lg-5">
							<span class="badge-category mb-2">Fair Pricing</span>
							<h2 class="fw-bold mb-3">Simple Coin System</h2>
							<p class="text-muted mb-4">
								Your conversations are based entirely on coins. There are no monthly commitments,
								subscriptions, or
								hidden charges. You purchase exactly what you need, when you need it.
							</p>
							<div class="d-flex align-items-center gap-3 mb-4">
								<span class="display-3 fw-extrabold text-primary-pink" style="color: #E91E8F;">1</span>
								<div class="text-start">
									<span class="fw-bold d-block text-dark" style="font-size: 1.25rem;">Coin</span>
									<span class="text-muted">equals</span>
								</div>
								<span class="display-3 fw-extrabold text-primary-blue" style="color: #1769E0;">1</span>
								<div class="text-start">
									<span class="fw-bold d-block text-dark" style="font-size: 1.25rem;">Minute</span>
									<span class="text-muted">of conversation</span>
								</div>
							</div>
							<a href="/pricing" class="btn btn-brand px-4 py-2.5">View Coin Plans</a>
						</div>

						<div class="col-lg-7">
							<div class="row g-4">
								<div class="col-sm-6">
									<div class="card-premium text-center p-4">
										<span class="text-muted d-block mb-1">Starter Plan</span>
										<h4 class="fw-bold mb-2 text-primary-blue">5 Coins</h4>
										<div class="badge-category mb-3">5 Minutes Talk Time</div>
										<p class="text-muted small">Perfect for a brief conversation to talk through a
											single issue.</p>
									</div>
								</div>
								<div class="col-sm-6">
									<div class="card-premium text-center p-4" style="border: 1.5px solid #7B4DCE;">
										<span class="text-muted d-block mb-1">Popular Plan</span>
										<h4 class="fw-bold mb-2 text-purple">30 Coins</h4>
										<div class="badge-category mb-3">30 Minutes Talk Time</div>
										<p class="text-muted small">The ideal session length to unpack a stressful day
											and breathe.</p>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Quote Banner Section -->
			<section class="section-padding bg-soft-gradient text-center position-relative overflow-hidden">
				<div class="backdrop-glow"></div>
				<div class="container position-relative z-3">
					<div class="max-width-800 mx-auto">
						<i class="bi bi-quote fs-1 text-primary-pink mb-4" style="color: #E91E8F; font-size: 3rem;"></i>
						<h2 class="fw-bold font-secondary mb-4"
							style="line-height: 1.4; color: #182033; font-weight: 600;">
							"You don't always need someone to fix everything. Sometimes you just need someone who stays,
							listens and
							understands."
						</h2>
						<p class="text-muted mb-4">— Talk. Be Heard. Feel Lighter. —</p>
						<a href="/user/dashboard" class="btn btn-brand px-5 py-3 fs-5">Start a Conversation</a>
					</div>
				</div>
			</section>

			<!-- Customer Ratings & Reviews Section -->
			<section id="customer-reviews" class="reviews-section position-relative overflow-hidden">
				<div class="backdrop-glow"></div>
				<div class="backdrop-glow-left"></div>

				<div class="container-fluid px-xl-5 px-lg-4 px-md-3 px-2 position-relative z-3">
					<!-- Section Header -->
					<div class="text-center max-width-700 mx-auto mb-4">
						<span class="badge-category mb-2">
							<i class="bi bi-star-fill text-warning me-1"></i> Heartfelt Testimonials
						</span>
						<h2 class="fw-bold mb-3">Customer Ratings &amp; Real Reviews</h2>
						<p class="text-muted mb-0">
							See how compassionate, 1-on-1 confidential conversations have helped individuals find calm, peace of mind, and clarity.
						</p>

						<!-- Overall Rating Summary -->
						<div class="reviews-summary-badge">
							<div class="stars-gold">
								<i class="bi bi-star-fill"></i>
								<i class="bi bi-star-fill"></i>
								<i class="bi bi-star-fill"></i>
								<i class="bi bi-star-fill"></i>
								<i class="bi bi-star-fill"></i>
							</div>
							<span class="rating-number"><%= typeof averageRating !== 'undefined' ? averageRating : '5.0' %> / 5.0</span>
							<span class="rating-sub">Based on <%= typeof totalReviews !== 'undefined' ? totalReviews : 5 %>+ Verified Conversations</span>
						</div>
					</div>

					<!-- Reviews Responsive Carousel Slider -->
					<div class="reviews-carousel-wrapper">
						<div class="reviews-viewport" id="reviewsViewport">
							<div class="reviews-track" id="reviewsTrack">
								<% if (typeof reviews !== 'undefined' && reviews.length > 0) { %>
									<% reviews.forEach(function(item) { %>
										<div class="review-card-slide">
											<div class="review-card">
												<i class="bi bi-quote review-quote-icon"></i>
												<div>
													<div class="review-card-top">
														<div class="review-stars">
															<% for(var i = 1; i <= 5; i++) { %>
																<% if(i <= (item.rating || 5)) { %>
																	<i class="bi bi-star-fill text-warning"></i>
																<% } else { %>
																	<i class="bi bi-star text-muted"></i>
																<% } %>
															<% } %>
														</div>
														<span class="review-verified-badge">
															<i class="bi bi-patch-check-fill"></i> <%= item.badge || 'Verified Conversation' %>
														</span>
													</div>
													<div class="review-comment-body">
														<p class="review-comment-text">"<%= item.comment %>"</p>
													</div>
												</div>
												<div class="review-author-row">
													<div class="review-avatar-circle" style="background: <%= item.avatarColor || '#1769E0' %>;">
														<%= item.name ? item.name.charAt(0).toUpperCase() : 'U' %>
													</div>
													<div class="review-author-info">
														<h6 class="review-author-name"><%= item.name %></h6>
														<span class="review-author-tag">
															<%= item.createdAt ? new Date(item.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Verified Companion User' %>
														</span>
													</div>
												</div>
											</div>
										</div>
									<% }); %>
								<% } %>
							</div>
						</div>

						<!-- Slider Navigation Controls -->
						<div class="reviews-controls-bar">
							<!-- Previous Button -->
							<button type="button" class="rev-nav-btn" id="revPrevBtn" aria-label="Previous Reviews">
								<i class="bi bi-chevron-left"></i>
							</button>

							<!-- Pagination Dots -->
							<div class="reviews-dots-container" id="revDotsContainer">
								<!-- Injected by reviews.js -->
							</div>

							

							<!-- Next Button -->
							<button type="button" class="rev-nav-btn" id="revNextBtn" aria-label="Next Reviews">
								<i class="bi bi-chevron-right"></i>
							</button>
						</div>
					</div>

					<!-- Simple Review Submission Form -->
					<div class="row justify-content-center">
						<div class="col-xxl-12 col-lg-10 col-12">
							<div class="review-form-card">
								<div class="review-form-header">
									<span class="badge-category mb-2">
										<i class="bi bi-chat-heart-fill me-1"></i> Your Voice Matters
									</span>
									<h3 class="review-form-title">Share Your Experience with Ashu</h3>
									<p class="review-form-subtitle">
										Had a talk or call session? Your honest review helps others feel confident to reach out and speak their heart.
									</p>
								</div>

								<!-- Alert box for success / error messages -->
								<div id="reviewFormAlert" class="alert review-alert mb-3" role="alert"></div>

								<form id="reviewSubmitForm" novalidate>
									<!-- Honeypot anti-spam field -->
									<input type="text" name="hp_website" class="hp-field" tabindex="-1" autocomplete="off">

									<div class="row g-3 mb-3">
										<div class="col-md-6">
											<!-- Name Field -->
											<label for="reviewNameInput" class="form-label form-label-custom">
												Your Name <span class="text-danger">*</span>
											</label>
											<div class="review-input-group">
												<i class="bi bi-person review-input-icon"></i>
												<input type="text" class="form-control-review" id="reviewNameInput" name="name" placeholder="e.g. Rahul Sharma or Priya S." required minlength="2" maxlength="50" autocomplete="name">
											</div>
											<small class="text-muted d-block mt-1">You may use your first name or a nickname.</small>
										</div>
										<div class="col-md-6">
											<!-- Interactive Star Rating Picker -->
											<div class="star-rating-widget">
												<label class="form-label-custom mb-1">Your Star Rating</label>
												<div class="stars-interactive" role="radiogroup" aria-label="Star Rating 1 to 5">
													<span class="star-choice" data-rating="1" title="1 Star"><i class="bi bi-star-fill"></i></span>
													<span class="star-choice" data-rating="2" title="2 Stars"><i class="bi bi-star-fill"></i></span>
													<span class="star-choice" data-rating="3" title="3 Stars"><i class="bi bi-star-fill"></i></span>
													<span class="star-choice" data-rating="4" title="4 Stars"><i class="bi bi-star-fill"></i></span>
													<span class="star-choice" data-rating="5" title="5 Stars"><i class="bi bi-star-fill"></i></span>
												</div>
												<input type="hidden" name="rating" id="reviewRatingInput" value="5">
												<div class="star-rating-label text-primary-pink" id="starRatingLabel">5 Stars - Truly Wonderful &amp; Heartwarming!</div>
											</div>
										</div>
									</div>

									<!-- Review Comment Field -->
									<div class="mb-4">
										<label for="reviewCommentInput" class="form-label form-label-custom">
											Your Review &amp; Experience <span class="text-danger">*</span>
										</label>
										<textarea class="form-control-review form-textarea-review" id="reviewCommentInput" name="comment" rows="4" placeholder="How did talking with Ashu help you? Describe how you felt before and after the conversation..." required minlength="5" maxlength="600"></textarea>
										<div class="char-counter" id="reviewCharCounter">0 / 600 characters</div>
									</div>

									<!-- Submit Button -->
									<div class="text-center">
										<button type="submit" id="reviewSubmitBtn" class="btn btn-brand btn-submit-review px-5 py-3 shadow-brand">
											<i class="bi bi-send-fill me-2"></i> Submit My Review
										</button>
									</div>
								</form>
							</div>
						</div>
					</div>

				</div>
			</section>

			<%- include('partials/footer') %>
				<%- include('partials/scripts') %>
	</body>

</html>
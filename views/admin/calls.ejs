<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="app-mode">

  <!-- Admin Mobile Top App Bar -->
  <%- include('../partials/admin-header') %>

  <div class="panel-wrapper">
    <!-- Admin Sidebar Partial -->
    <%- include('../partials/admin-sidebar') %>

    <!-- Main Content Panel -->
    <div class="content-panel">
      <!-- Top Header (Desktop) -->
      <header class="header-panel shadow-sm d-none d-lg-flex">
        <div class="d-flex align-items-center gap-3">
          <h4 class="mb-0 fw-bold">Call History Database</h4>
        </div>
        
        <div class="d-flex align-items-center gap-3">
          <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill fw-semibold">
            <span class="status-indicator-dot online me-1"></span> Live Console Active
          </span>
          <a href="/admin/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 d-flex align-items-center gap-1.5 fw-semibold" title="Logout from Admin Panel">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
          </a>
        </div>
      </header>

      <!-- Main Contents Canvas -->
      <main class="main-content-inner">
        <div class="app-container">
          <!-- Calls Directory Card -->
        <div class="card-premium border-0 bg-white shadow-sm p-4">
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
            <div>
              <h5 class="fw-bold mb-1">Voice Connection Records</h5>
              <small class="text-muted">Total records: <span class="fw-semibold"><%= typeof totalCalls !== 'undefined' ? totalCalls : calls.length %></span></small>
            </div>
            
            <!-- Filters Form: Date, User Name, Status -->
            <form method="GET" action="/admin/calls" class="row g-2 align-items-center w-100 mt-2 mt-md-0" style="max-width: 680px;">
              <div class="col-12 col-md-4">
                <div class="input-group input-group-sm">
                  <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                  <input type="text" name="userName" class="form-control form-control-custom border-start-0" placeholder="User name or phone..." value="<%= typeof userNameQuery !== 'undefined' ? userNameQuery : (typeof searchQuery !== 'undefined' ? searchQuery : '') %>">
                </div>
              </div>

              <div class="col-6 col-md-3">
                <div class="input-group input-group-sm">
                  <span class="input-group-text bg-light border-end-0"><i class="bi bi-calendar3 text-muted"></i></span>
                  <input type="date" name="date" class="form-control form-control-custom border-start-0" title="Filter by date" value="<%= typeof selectedDate !== 'undefined' ? selectedDate : '' %>">
                </div>
              </div>

              <div class="col-6 col-md-3">
                <select name="status" class="form-select form-control-custom form-select-sm" onchange="this.form.submit()">
                  <% const statuses = ['All', 'Completed', 'Cancelled', 'Missed', 'Rejected', 'Failed', 'Auto-Disconnected (No Credits)']; %>
                  <% statuses.forEach(st => { %>
                    <option value="<%= st %>" <%= (typeof selectedStatus !== 'undefined' && selectedStatus === st) ? 'selected' : '' %>>
                      <%= st === 'All' ? 'All Statuses' : st %>
                    </option>
                  <% }) %>
                </select>
              </div>

              <div class="col-12 col-md-2 d-flex gap-1.5">
                <button type="submit" class="btn btn-sm btn-brand px-3 flex-grow-1"><i class="bi bi-funnel-fill me-1"></i> Filter</button>
                <% if ((typeof userNameQuery !== 'undefined' && userNameQuery) || (typeof selectedDate !== 'undefined' && selectedDate) || (typeof selectedStatus !== 'undefined' && selectedStatus !== 'All')) { %>
                  <a href="/admin/calls" class="btn btn-sm btn-outline-secondary px-2" title="Reset Filters"><i class="bi bi-arrow-clockwise"></i></a>
                <% } %>
              </div>
            </form>
          </div>

          <!-- Mobile Feed View (Native App Style for Phones) -->
          <div class="mobile-card-feed d-md-none mb-3">
            <% if (calls.length === 0) { %>
              <div class="text-center py-5 px-3 bg-light rounded-4 border border-dashed my-3">
                <div class="rounded-circle bg-white shadow-xs d-inline-flex align-items-center justify-content-center p-3 mb-2 text-muted">
                  <i class="bi bi-telephone-x fs-2 text-muted"></i>
                </div>
                <h6 class="fw-bold text-dark mb-1">No Call Records Found</h6>
                <p class="text-muted small mb-3">No voice connection records match the selected filters.</p>
                <a href="/admin/calls" class="btn btn-sm btn-outline-brand rounded-pill px-3">
                  <i class="bi bi-arrow-clockwise me-1"></i> Clear Filters
                </a>
              </div>
            <% } else { %>
              <% calls.forEach(call => { %>
                <% 
                  let badgeClass = "bg-success-subtle text-success";
                  if (call.status === "Cancelled" || call.status === "Missed" || call.status === "Rejected") badgeClass = "bg-warning-subtle text-warning";
                  if (call.status === "Failed") badgeClass = "bg-danger-subtle text-danger";
                  if (call.status && call.status.includes("No Credits")) badgeClass = "bg-danger text-white";

                  let creditBadgeClass = "bg-secondary-subtle text-secondary";
                  if (call.creditStatus === "deducted") creditBadgeClass = "bg-success-subtle text-success";
                  if (call.creditStatus === "waived") creditBadgeClass = "bg-info-subtle text-info";
                  if (call.creditStatus === "failed") creditBadgeClass = "bg-danger-subtle text-danger";

                  const advisorName = (call.admin && call.admin.name) ? call.admin.name : (call.receiverName || 'System Admin');
                  const userName = call.user ? call.user.name : (call.callerName || 'Deleted User');
                  const userMobile = call.user ? call.user.mobile : '';
                %>
                <div class="mobile-data-card">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="badge <%= badgeClass %> rounded-pill px-2.5 py-1"><%= call.status %></span>
                    <span class="text-muted small font-monospace"><%= call.callId %></span>
                  </div>
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <div>
                      <strong class="d-block text-dark small"><%= userName %></strong>
                      <small class="text-muted"><%= userMobile ? userMobile + ' • ' : '' %><%= call.date ? new Date(call.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }) : '' %> <%= call.time %></small>
                    </div>
                    <div class="text-end">
                      <strong class="text-dark d-block small"><%= call.duration %></strong>
                      <small class="text-purple fw-bold"><%= call.credits %> cr</small>
                    </div>
                  </div>
                  <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                    <small class="text-muted"><i class="bi bi-person-check me-1"></i><%= advisorName %></small>
                    <button type="button" class="btn btn-sm btn-outline-primary py-1 px-3 rounded-pill" onclick="openCallDetailsModal('<%= call.callId %>')">
                      <i class="bi bi-info-circle me-1"></i> Details
                    </button>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>

          <!-- Desktop Table View -->
          <div class="table-responsive-custom d-none d-md-block">
            <table class="table table-premium mb-0 align-middle">
              <thead>
                <tr>
                  <th>Call ID</th>
                  <th>User</th>
                  <th>Advisor</th>
                  <th>Type</th>
                  <th>Date & Time</th>
                  <th>Duration</th>
                  <th>Credits</th>
                  <th>Status</th>
                  <th>Credit Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (calls.length === 0) { %>
                  <tr>
                    <td colspan="10" class="text-center py-5">
                      <div class="py-4">
                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center p-3 mb-2 text-muted">
                          <i class="bi bi-telephone-x fs-2 text-muted"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">No Call Records Found</h6>
                        <p class="text-muted small mb-3">No voice connection records match the selected filters.</p>
                        <a href="/admin/calls" class="btn btn-sm btn-outline-brand rounded-pill px-3">
                          <i class="bi bi-arrow-clockwise me-1"></i> Clear Filters
                        </a>
                      </div>
                    </td>
                  </tr>
                <% } else { %>
                  <% calls.forEach(call => { %>
                    <% 
                      let badgeClass = "bg-success-subtle text-success";
                      if (call.status === "Cancelled" || call.status === "Missed" || call.status === "Rejected") badgeClass = "bg-warning-subtle text-warning";
                      if (call.status === "Failed") badgeClass = "bg-danger-subtle text-danger";
                      if (call.status && call.status.includes("No Credits")) badgeClass = "bg-danger text-white";

                      let creditBadgeClass = "bg-secondary-subtle text-secondary";
                      if (call.creditStatus === "deducted") creditBadgeClass = "bg-success-subtle text-success";
                      if (call.creditStatus === "waived") creditBadgeClass = "bg-info-subtle text-info";
                      if (call.creditStatus === "failed") creditBadgeClass = "bg-danger-subtle text-danger";

                      const advisorName = (call.admin && call.admin.name) ? call.admin.name : (call.receiverName || 'System Admin');
                      const userName = call.user ? call.user.name : (call.callerName || 'Deleted User');
                      const userMobile = call.user ? call.user.mobile : '';
                    %>
                    <tr>
                      <td><span class="fw-semibold text-dark"><%= call.callId %></span></td>
                      <td>
                        <div>
                          <span class="fw-semibold text-dark d-block"><%= userName %></span>
                          <small class="text-muted"><%= userMobile %></small>
                        </div>
                      </td>
                      <td><span class="text-muted small"><%= advisorName %></span></td>
                      <td><span class="badge bg-light text-secondary border rounded-pill px-2 py-0.5 small"><%= call.callType || 'Voice' %></span></td>
                      <td>
                        <span class="d-block text-dark"><%= call.date ? new Date(call.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '' %></span>
                        <small class="text-muted"><%= call.time %></small>
                      </td>
                      <td><span class="fw-semibold"><%= call.duration %></span></td>
                      <td><span class="fw-bold text-purple"><%= call.credits %> Credits</span></td>
                      <td><span class="badge <%= badgeClass %> rounded-pill px-2.5 py-1"><%= call.status %></span></td>
                      <td><span class="badge <%= creditBadgeClass %> rounded-pill px-2.5 py-1 text-capitalize"><%= call.creditStatus || 'none' %></span></td>
                      <td>
                        <button type="button" class="btn btn-sm btn-outline-primary py-1 px-2.5 rounded-pill" onclick="openCallDetailsModal('<%= call.callId %>')">
                          <i class="bi bi-info-circle me-1"></i> Details
                        </button>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Pagination Controls -->
          <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
            <nav class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 mt-4 pt-3 border-top">
              <span class="text-muted small">Showing page <%= currentPage %> of <%= totalPages %> (<%= totalCalls %> total records)</span>
              <ul class="pagination pagination-sm mb-0">
                <% 
                  const queryParams = (typeof userNameQuery !== 'undefined' && userNameQuery ? `&userName=${encodeURIComponent(userNameQuery)}` : '') + 
                                      (typeof selectedDate !== 'undefined' && selectedDate ? `&date=${encodeURIComponent(selectedDate)}` : '') + 
                                      (typeof selectedStatus !== 'undefined' && selectedStatus !== 'All' ? `&status=${encodeURIComponent(selectedStatus)}` : '');
                %>
                <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                  <a class="page-link" href="/admin/calls?page=<%= currentPage - 1 %><%= queryParams %>">Previous</a>
                </li>
                <% for (let p = 1; p <= totalPages; p++) { %>
                  <% if (p === 1 || p === totalPages || (p >= currentPage - 2 && p <= currentPage + 2)) { %>
                    <li class="page-item <%= p === currentPage ? 'active' : '' %>">
                      <a class="page-link" href="/admin/calls?page=<%= p %><%= queryParams %>"><%= p %></a>
                    </li>
                  <% } else if (p === currentPage - 3 || p === currentPage + 3) { %>
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                  <% } %>
                <% } %>
                <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                  <a class="page-link" href="/admin/calls?page=<%= currentPage + 1 %><%= queryParams %>">Next</a>
                </li>
              </ul>
            </nav>
          <% } %>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- Admin Mobile Bottom Navigation -->
  <%- include('../partials/admin-bottom-nav') %>

  <!-- Admin Incoming Call Notification Modal -->
  <%- include('../partials/admin-incoming-call') %>

  <!-- Interactive Call Details Modal -->
  <div class="modal fade" id="callDetailsModal" tabindex="-1" aria-labelledby="callDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
        <div class="modal-header border-0 bg-light p-4">
          <div>
            <span class="badge bg-primary-pink text-white rounded-pill px-3 py-1 text-uppercase fw-bold small" style="background: linear-gradient(135deg, #E91E8F 0%, #1769E0 100%);">Call Audit Log</span>
            <h4 class="fw-bold mb-0 mt-2" id="modal-call-id">CALL-XXXX</h4>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4" id="modal-call-body">
          <div class="text-center py-4">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted small">Loading call record...</p>
          </div>
        </div>
        <div class="modal-footer border-0 bg-light p-3">
          <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
  <script>
    function openCallDetailsModal(callId) {
      const modalElement = document.getElementById('callDetailsModal');
      const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
      $("#modal-call-id").text(callId);
      $("#modal-call-body").html('<div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div><p class="mt-2 text-muted small">Loading call record...</p></div>');
      modal.show();

      $.ajax({
        url: `/admin/calls/${callId}/details`,
        method: 'GET',
        success: function(res) {
          if (res.success && res.data) {
            const d = res.data;
            let statusBadge = `<span class="badge bg-success-subtle text-success px-2.5 py-1 rounded-pill">${d.status}</span>`;
            if (d.status === 'Cancelled' || d.status === 'Missed' || d.status === 'Rejected') statusBadge = `<span class="badge bg-warning-subtle text-warning px-2.5 py-1 rounded-pill">${d.status}</span>`;
            if (d.status === 'Failed' || d.status.includes('No Credits')) statusBadge = `<span class="badge bg-danger-subtle text-danger px-2.5 py-1 rounded-pill">${d.status}</span>`;

            const html = `
              <div class="row g-3">
                <div class="col-md-6">
                  <div class="p-3 bg-light rounded-3 h-100">
                    <span class="text-muted small d-block mb-1 text-uppercase fw-semibold">Caller Details</span>
                    <h6 class="fw-bold mb-1">${d.user.name}</h6>
                    <p class="text-muted small mb-1"><i class="bi bi-telephone me-1"></i> ${d.user.mobile}</p>
                    <small class="text-muted">User ID: <code>${d.user.id}</code></small>
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="p-3 bg-light rounded-3 h-100">
                    <span class="text-muted small d-block mb-1 text-uppercase fw-semibold">Advisor Details</span>
                    <h6 class="fw-bold mb-1">${d.admin.name}</h6>
                    <small class="text-muted">Advisor ID: <code>${d.admin.id}</code></small>
                  </div>
                </div>

                <div class="col-12"><hr class="my-2 border-secondary-subtle"></div>

                <div class="col-6 col-md-3">
                  <span class="text-muted small d-block">Call Type</span>
                  <strong>${d.callType}</strong>
                </div>
                <div class="col-6 col-md-3">
                  <span class="text-muted small d-block">Call Status</span>
                  ${statusBadge}
                </div>
                <div class="col-6 col-md-3">
                  <span class="text-muted small d-block">Duration</span>
                  <strong class="fs-5">${d.duration}</strong> <small class="text-muted">(${d.durationSeconds}s)</small>
                </div>
                <div class="col-6 col-md-3">
                  <span class="text-muted small d-block">Credit Rate</span>
                  <strong>${d.creditRate} Credit / Min</strong>
                </div>

                <div class="col-6 col-md-3">
                  <span class="text-muted small d-block">Started Time</span>
                  <span>${d.startTime}</span>
                </div>
                <div class="col-6 col-md-3">
                  <span class="text-muted small d-block">Connected Time</span>
                  <span>${d.connectedTime}</span>
                </div>
                <div class="col-6 col-md-3">
                  <span class="text-muted small d-block">Ended Time</span>
                  <span>${d.endTime}</span>
                </div>
                <div class="col-6 col-md-3">
                  <span class="text-muted small d-block">Call Date</span>
                  <span>${d.date}</span>
                </div>

                <div class="col-12"><hr class="my-2 border-secondary-subtle"></div>

                <div class="col-md-6">
                  <div class="p-3 rounded-3 border bg-white">
                    <span class="text-muted small d-block mb-1">Total Credits Billed</span>
                    <h4 class="fw-extrabold text-purple mb-0">${d.credits} <span class="fs-6 fw-normal text-muted">Credits</span></h4>
                    <span class="badge bg-${d.creditStatus === 'deducted' ? 'success' : 'secondary'}-subtle text-${d.creditStatus === 'deducted' ? 'success' : 'secondary'} rounded-pill mt-2 text-capitalize">Deduction: ${d.creditStatus}</span>
                  </div>
                </div>

                <div class="col-md-6">
                  <div class="p-3 rounded-3 border bg-white">
                    <span class="text-muted small d-block mb-1">Linked Transaction</span>
                    <h6 class="fw-bold mb-0 text-dark">${d.transactionId}</h6>
                    <small class="text-muted">Audited in financial ledger</small>
                  </div>
                </div>
              </div>
            `;
            $("#modal-call-body").html(html);
          } else {
            $("#modal-call-body").html('<div class="alert alert-danger mb-0">Failed to load call details.</div>');
          }
        },
        error: function() {
          $("#modal-call-body").html('<div class="alert alert-danger mb-0">Error connecting to server.</div>');
        }
      });
    }
  </script>
</body>
</html>


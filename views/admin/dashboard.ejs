<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="app-mode">

  <!-- Admin Mobile Top App Bar -->
  <%- include('../partials/admin-header') %>

  <div class="panel-wrapper">
    <!-- Desktop Left Sidebar -->
    <%- include('../partials/admin-sidebar') %>

    <!-- Main Content Panel -->
    <div class="content-panel">
      <!-- Desktop Header Panel (Visible on Desktop) -->
      <header class="header-panel shadow-sm d-none d-lg-flex">
        <div class="d-flex align-items-center gap-3">
          <h4 class="mb-0 fw-bold text-dark">Talk With Ashu Operational Console</h4>
        </div>
        
        <div class="d-flex align-items-center gap-3">
          <!-- Today's Revenue Quick Pill -->
          <div class="header-stat-pill">
            <i class="bi bi-cash-stack text-success fs-5"></i>
            <div>
              <small class="text-muted d-block lh-1" style="font-size: 0.68rem; text-transform: uppercase; font-weight: 700;">Today's Income</small>
              <strong class="text-success fs-6">₹<%= ((typeof stats !== 'undefined' && stats && stats.todayRevenue) || 0).toLocaleString('en-IN') %></strong>
            </div>
          </div>

          <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-semibold d-flex align-items-center gap-1.5">
            <span class="status-indicator-dot online"></span> Console Online (Ready)
          </span>

          <a href="/admin/settings" class="btn btn-light d-flex align-items-center gap-2 border rounded-pill py-1.5 px-3">
            <i class="bi bi-shield-lock-fill text-primary"></i>
            <span class="fw-semibold text-dark small">Ashu</span>
          </a>

          <a href="/admin/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 d-flex align-items-center gap-1.5 fw-semibold" title="Logout">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
          </a>
        </div>
      </header>

      <!-- Main Contents Canvas -->
      <main class="main-content-inner">
        <div class="app-container">

          <!-- 1. HERO EARNINGS CARD: TODAY'S REVENUE & COINS USAGE -->
          <div class="admin-earning-hero-card">
            <div class="row align-items-center g-4 position-relative z-3">
              <div class="col-lg-8">
                <!-- Grouped Status Badges -->
                <div class="d-flex align-items-center gap-2 mb-3">
                  <span class="badge rounded-pill px-3 py-1.5 text-white border" style="background: rgba(255, 255, 255, 0.15); border-color: rgba(255, 255, 255, 0.22) !important; font-size: 0.75rem; font-weight: 600;">
                    <i class="bi bi-calendar-check me-1.5"></i> Today's Summary
                  </span>
                  <span class="badge bg-success text-white rounded-pill px-3 py-1.5 d-inline-flex align-items-center" style="font-size: 0.75rem; font-weight: 600;">
                    <span class="status-indicator-dot online me-1.5 bg-white"></span> Live Tracking
                  </span>
                </div>

                <span class="hero-stat-label text-white-50 d-block mb-2 text-uppercase fw-bold" style="letter-spacing: 0.8px; font-size: 0.75rem;">Today's Revenue & Consultation Usage</span>
                
                <!-- Stat Values (Desktop bold side-by-side, mobile stacked) -->
                <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-3 gap-md-4 mb-3">
                  <div class="hero-stat-box">
                    <div class="hero-stat-value text-white">₹<%= ((typeof stats !== 'undefined' && stats && stats.todayRevenue) || 0).toLocaleString('en-IN') %></div>
                    <span class="hero-stat-caption text-white-50">Net Revenue Inflow</span>
                  </div>

                  <div class="hero-divider d-none d-sm-block"></div>

                  <div class="hero-stat-box">
                    <div class="hero-stat-value text-warning"><%= ((typeof stats !== 'undefined' && stats && stats.creditsUsedToday) || 0) %> <span class="fs-4 fw-normal text-white-50">coins</span></div>
                    <span class="hero-stat-caption text-white-50">Consultation Coins Used</span>
                  </div>
                </div>

                <!-- Descriptive Summary Bar -->
                <div class="d-flex flex-wrap align-items-center gap-2 text-white-50 small mt-3 pt-2 border-top border-white-20" style="font-size: 0.8rem;">
                  <span><i class="bi bi-telephone-inbound text-white me-1"></i> <strong class="text-white"><%= ((typeof stats !== 'undefined' && stats && stats.callsToday) || 0) %></strong> calls today</span>
                  <span class="text-white-20">•</span>
                  <span><i class="bi bi-clock-history text-warning me-1"></i> <strong class="text-white"><%= ((typeof stats !== 'undefined' && stats && stats.minsToday) || 0) %></strong> mins talk time</span>
                  <span class="text-white-20">•</span>
                  <span><i class="bi bi-bag-check text-success me-1"></i> <strong class="text-white"><%= ((typeof stats !== 'undefined' && stats && stats.todayRechargesCount) || 0) %></strong> recharge packs bought</span>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="col-lg-4 text-start text-lg-end">
                <div class="d-flex flex-column flex-sm-row flex-lg-column gap-2.5 justify-content-lg-end">
                  <a href="/admin/transactions" class="hero-action-btn-primary app-tap-active">
                    <i class="bi bi-receipt-cutoff"></i>
                    <span>View Transactions</span>
                  </a>
                  <a href="/admin/calls" class="hero-action-btn-secondary app-tap-active">
                    <i class="bi bi-telephone-inbound"></i>
                    <span>Active Call Records</span>
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- 2. TODAY'S OPERATIONAL SUMMARY METRICS -->
          <div class="row g-3 mb-4">
            
            <!-- Today's Revenue -->
            <div class="col-6 col-lg-3">
              <div class="admin-metric-card">
                <div>
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="admin-metric-label">Today's Inflow</span>
                    <div class="admin-metric-icon bg-success-subtle text-success">
                      <i class="bi bi-cash-stack"></i>
                    </div>
                  </div>
                  <div class="admin-metric-value text-success">₹<%= ((typeof stats !== 'undefined' && stats && stats.todayRevenue) || 0).toLocaleString('en-IN') %></div>
                </div>
                <div class="mt-2 pt-2 border-top">
                  <span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1 fw-semibold small">
                    <i class="bi bi-bag-check-fill me-1"></i><%= stats.todayRechargesCount %> Packs Purchased
                  </span>
                </div>
              </div>
            </div>

            <!-- Coins Consumed Today -->
            <div class="col-6 col-lg-3">
              <div class="admin-metric-card">
                <div>
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="admin-metric-label">Coins Used</span>
                    <div class="admin-metric-icon bg-warning-subtle text-warning-emphasis">
                      <i class="bi bi-coin"></i>
                    </div>
                  </div>
                  <div class="admin-metric-value text-dark"><%= stats.creditsUsedToday %> <span class="fs-6 text-muted fw-normal">coins</span></div>
                </div>
                <div class="mt-2 pt-2 border-top">
                  <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2.5 py-1 fw-semibold small">
                    <i class="bi bi-clock-history me-1"></i><%= stats.minsToday %> mins Talk Time
                  </span>
                </div>
              </div>
            </div>

            <!-- Today's Total Calls -->
            <div class="col-6 col-lg-3">
              <div class="admin-metric-card">
                <div>
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="admin-metric-label">Calls Today</span>
                    <div class="admin-metric-icon bg-primary-subtle text-primary">
                      <i class="bi bi-telephone-inbound-fill"></i>
                    </div>
                  </div>
                  <div class="admin-metric-value text-dark"><%= stats.callsToday %> <span class="fs-6 text-muted fw-normal">calls</span></div>
                </div>
                <div class="mt-2 pt-2 border-top">
                  <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-1 fw-semibold small">
                    <i class="bi bi-activity me-1"></i>Live & Completed
                  </span>
                </div>
              </div>
            </div>

            <!-- Coins Bought Today -->
            <div class="col-6 col-lg-3">
              <div class="admin-metric-card">
                <div>
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="admin-metric-label">Recharged</span>
                    <div class="admin-metric-icon bg-purple-subtle text-purple">
                      <i class="bi bi-wallet2"></i>
                    </div>
                  </div>
                  <div class="admin-metric-value text-dark"><%= stats.creditsToday %> <span class="fs-6 text-muted fw-normal">coins</span></div>
                </div>
                <div class="mt-2 pt-2 border-top">
                  <span class="badge bg-purple-subtle text-purple rounded-pill px-2.5 py-1 fw-semibold small">
                    <i class="bi bi-people me-1"></i><%= stats.totalUsers %> Total Clients
                  </span>
                </div>
              </div>
            </div>

          </div>

          <!-- 3. PLATFORM CUMULATIVE METRICS STRIP -->
          <div class="row g-3 g-md-4 mb-4">
            <div class="col-sm-4">
              <div class="app-card mb-0 p-3.5 p-md-4 d-flex align-items-center gap-3">
                <div class="rounded-3 bg-primary-subtle text-primary p-3 fs-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                  <i class="bi bi-people-fill"></i>
                </div>
                <div>
                  <span class="text-muted small d-block fw-medium">Total Registered Clients</span>
                  <h4 class="fw-extrabold text-dark mb-0"><%= stats.totalUsers %> Users</h4>
                </div>
              </div>
            </div>

            <div class="col-sm-4">
              <div class="app-card mb-0 p-3.5 p-md-4 d-flex align-items-center gap-3">
                <div class="rounded-3 bg-purple-subtle text-purple p-3 fs-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                  <i class="bi bi-telephone-fill"></i>
                </div>
                <div>
                  <span class="text-muted small d-block fw-medium">All-Time Calls Placed</span>
                  <h4 class="fw-extrabold text-dark mb-0"><%= stats.totalCalls %> Calls</h4>
                </div>
              </div>
            </div>

            <div class="col-sm-4">
              <div class="app-card mb-0 p-3.5 p-md-4 d-flex align-items-center gap-3">
                <div class="rounded-3 bg-success-subtle text-success p-3 fs-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                  <i class="bi bi-currency-rupee"></i>
                </div>
                <div>
                  <span class="text-muted small d-block fw-medium">All-Time Net Revenue</span>
                  <h4 class="fw-extrabold text-success mb-0">₹<%= ((typeof stats !== 'undefined' && stats && stats.totalRevenue) || 0).toLocaleString('en-IN') %></h4>
                </div>
              </div>
            </div>
          </div>

          <!-- 4. TODAY'S CLIENT CREDIT USAGE BREAKDOWN -->
          <div class="card-premium border-0 bg-white shadow-sm p-4 mb-4">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-3">
              <div>
                <div class="d-flex align-items-center gap-2">
                  <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2.5 py-1 small fw-bold">
                    <i class="bi bi-coin me-1"></i> Client Consumption
                  </span>
                  <span class="badge bg-light text-muted border rounded-pill px-2.5 py-1 small">Today</span>
                </div>
                <h5 class="fw-bold mb-1 mt-2 text-dark">Today's Client Coin Consumption</h5>
                <p class="text-muted small mb-0">Total <strong><%= stats.creditsUsedToday %> Coins</strong> (<%= stats.minsToday %> mins) used by clients today, generating approx <strong>₹<%= ((typeof stats !== 'undefined' && stats && stats.todayRevenue) || 0).toLocaleString('en-IN') %></strong> revenue inflow.</p>
              </div>
              <a href="/admin/calls" class="btn btn-sm btn-outline-brand rounded-pill px-3">
                <i class="bi bi-telephone-inbound me-1"></i> Filter Calls
              </a>
            </div>

            <% if (typeof todayUserUsageList !== 'undefined' && todayUserUsageList && todayUserUsageList.length > 0) { %>
              <div class="table-responsive-custom">
                <table class="table table-premium mb-0 align-middle">
                  <thead>
                    <tr>
                      <th>Client Name</th>
                      <th>Mobile Number</th>
                      <th>Coins Consumed</th>
                      <th>Talk Duration</th>
                      <th>Calls Today</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% todayUserUsageList.forEach(item => { %>
                      <tr>
                        <td>
                          <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold small" style="width: 32px; height: 32px;">
                              <%= item.name ? item.name.charAt(0).toUpperCase() : 'C' %>
                            </div>
                            <strong class="text-dark"><%= item.name %></strong>
                          </div>
                        </td>
                        <td><span class="font-monospace text-muted"><%= item.mobile || 'N/A' %></span></td>
                        <td><span class="badge bg-purple-subtle text-purple px-3 py-1.5 rounded-pill fw-bold"><i class="bi bi-coin me-1"></i><%= item.creditsUsed %> coins consumed</span></td>
                        <td><span class="fw-semibold text-dark"><%= item.totalDurationMins %> mins</span></td>
                        <td><span class="badge bg-light text-dark border rounded-pill px-2.5 py-1"><%= item.callsCount %> calls</span></td>
                        <td>
                          <a href="/admin/calls?userName=<%= encodeURIComponent(item.name) %>" class="btn btn-sm btn-light border rounded-pill px-3 py-1 text-primary small">
                            <i class="bi bi-search me-1"></i> View Calls
                          </a>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="text-center py-4 px-3 bg-light rounded-4 border border-dashed">
                <i class="bi bi-chat-square-dots text-muted fs-3 d-block mb-1"></i>
                <p class="text-muted small mb-0">No client has consumed consultation coins today yet.</p>
              </div>
            <% } %>
          </div>

          <!-- 5. RECENT CALLS & RECENT USERS DUAL FEEDS -->
          <div class="row g-4 mb-4">
            
            <!-- Recent Calls Stream -->
            <div class="col-lg-7">
              <div class="app-card p-0 overflow-hidden h-100">
                <div class="p-3.5 px-4 d-flex align-items-center justify-content-between border-bottom bg-white">
                  <h5 class="fw-bold mb-0 text-dark">Recent Consultations</h5>
                  <a href="/admin/calls" class="small fw-semibold text-primary text-decoration-none">View All Logs</a>
                </div>

                <% if (recentCalls.length === 0) { %>
                  <div class="text-center py-5 px-3">
                    <p class="text-muted small mb-0">No calls registered yet.</p>
                  </div>
                <% } else { %>
                  <div class="app-list-group border-0 rounded-0">
                    <% recentCalls.forEach(call => { %>
                      <% 
                        let badgeClass = "bg-success-subtle text-success";
                        if (call.status === "Cancelled" || call.status === "Missed" || call.status === "Rejected") badgeClass = "bg-warning-subtle text-warning";
                        if (call.status === "Failed" || (call.status && (call.status.includes("No Points") || call.status.includes("No Coins") || call.status.includes("No Credits")))) badgeClass = "bg-danger-subtle text-danger";
                        const clientName = (call.user && call.user.name) ? call.user.name : (call.callerName || 'Client');
                      %>
                      <div class="app-list-item">
                        <div class="d-flex align-items-center">
                          <div class="app-list-icon bg-primary-subtle text-primary">
                            <i class="bi bi-person-fill"></i>
                          </div>
                          <div>
                            <strong class="d-block text-dark small"><%= clientName %></strong>
                            <small class="text-muted font-monospace"><%= call.callId %> • <%= call.time %></small>
                          </div>
                        </div>
                        <div class="text-end">
                          <span class="badge <%= badgeClass %> rounded-pill px-2.5 py-1 small mb-1 d-inline-block"><%= call.status %></span>
                          <small class="d-block text-muted font-monospace"><%= call.duration %> (<%= call.credits %> coins)</small>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            </div>

            <!-- Recent Clients Stream -->
            <div class="col-lg-5">
              <div class="app-card p-0 overflow-hidden h-100">
                <div class="p-3.5 px-4 d-flex align-items-center justify-content-between border-bottom bg-white">
                  <h5 class="fw-bold mb-0 text-dark">Newly Joined Clients</h5>
                  <a href="/admin/users" class="small fw-semibold text-primary text-decoration-none">Manage Users</a>
                </div>

                <% if (recentUsers.length === 0) { %>
                  <div class="text-center py-5 px-3">
                    <p class="text-muted small mb-0">No users found.</p>
                  </div>
                <% } else { %>
                  <div class="app-list-group border-0 rounded-0">
                    <% recentUsers.forEach(u => { %>
                      <div class="app-list-item">
                        <div class="d-flex align-items-center">
                          <div class="app-list-icon bg-light text-dark font-monospace fw-bold">
                            <%= u.name ? u.name.charAt(0).toUpperCase() : 'U' %>
                          </div>
                          <div>
                            <strong class="d-block text-dark small"><%= u.name %></strong>
                            <small class="text-muted"><%= u.mobile %></small>
                          </div>
                        </div>
                        <div class="text-end">
                          <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-1 small"><%= u.credits %> coins</span>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            </div>

          </div>

        </div>
      </main>
    </div>
  </div>

  <!-- Admin Mobile Bottom Navigation Bar -->
  <%- include('../partials/admin-bottom-nav') %>

  <!-- Global Incoming Call Alert Receiver & WebRTC Modal for Admin -->
  <%- include('../partials/admin-incoming-call') %>

  <!-- Shared JavaScript Scripts -->
  <%- include('../partials/scripts') %>
</body>
</html>

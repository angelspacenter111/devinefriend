<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body>

  <div class="panel-wrapper">
    <!-- Admin Sidebar Partial -->
    <%- include('../partials/admin-sidebar') %>

    <!-- Main Content Panel -->
    <div class="content-panel">
      <!-- Top Header -->
      <header class="header-panel shadow-sm">
        <div class="d-flex align-items-center gap-3">
          <button class="btn btn-light d-lg-none sidebar-toggle-btn" type="button">
            <i class="bi bi-list fs-4"></i>
          </button>
          <h4 class="mb-0 fw-bold">Admin Dashboard</h4>
        </div>
        
        <div class="d-flex align-items-center gap-3">
          <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill fw-semibold"><span class="status-indicator-dot online me-1"></span> Console: Online (Listening)</span>
          <div class="dropdown">
            <button class="btn btn-light d-flex align-items-center gap-2 border rounded-pill py-1 px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <div class="rounded-circle bg-light-lavender d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                <i class="bi bi-shield-lock text-purple"></i>
              </div>
              <span class="fw-semibold text-dark d-none d-md-block small">System Admin</span>
              <i class="bi bi-chevron-down text-muted small ms-1"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 rounded-3">
              <li><h6 class="dropdown-header">Admin Control</h6></li>
              <li><a class="dropdown-item" href="/admin/settings"><i class="bi bi-gear me-2 text-muted"></i>Settings</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item text-danger fw-semibold" href="/admin/logout"><i class="bi bi-box-arrow-right me-2 text-danger"></i>Logout</a></li>
            </ul>
          </div>

          <a href="/admin/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 d-flex align-items-center gap-1.5 fw-semibold" title="Logout from Admin Panel">
            <i class="bi bi-box-arrow-right"></i>
            <span class="d-none d-sm-inline">Logout</span>
          </a>
        </div>
      </header>

      <!-- Main Contents Canvas -->
      <main class="main-content-inner">
        <!-- Today Statistics Strip -->
        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-clock-history me-1 text-primary-pink"></i> Today's Summary</h5>
        <div class="row g-4 mb-5">
          <div class="col-6 col-lg-3">
            <div class="p-3 bg-white rounded-3 shadow-sm border">
              <span class="text-muted small d-block mb-1">New Users Today</span>
              <h3 class="fw-extrabold text-primary-blue mb-0"><%= stats.newUsersToday %></h3>
            </div>
          </div>
          <div class="col-6 col-lg-3">
            <div class="p-3 bg-white rounded-3 shadow-sm border">
              <span class="text-muted small d-block mb-1">Calls Today</span>
              <h3 class="fw-extrabold text-purple mb-0"><%= stats.callsToday %></h3>
            </div>
          </div>
          <div class="col-6 col-lg-3">
            <div class="p-3 bg-white rounded-3 shadow-sm border">
              <span class="text-muted small d-block mb-1">Minutes Spoken Today</span>
              <h3 class="fw-extrabold text-success mb-0"><%= stats.minsToday %> min</h3>
            </div>
          </div>
          <div class="col-6 col-lg-3">
            <div class="p-3 bg-white rounded-3 shadow-sm border">
              <span class="text-muted small d-block mb-1">Credits Purchased Today</span>
              <h3 class="fw-extrabold text-dark mb-0"><%= stats.creditsToday %></h3>
            </div>
          </div>
        </div>

        <!-- Global Cumulative Stats Cards -->
        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-globe me-1 text-primary-blue"></i> Cumulative Metrics</h5>
        <div class="row g-4 mb-5">
          <div class="col-sm-6 col-lg-3">
            <div class="card-premium border-0 bg-white shadow-sm p-4 text-center">
              <i class="bi bi-people-fill text-primary-blue fs-2 mb-2"></i>
              <span class="text-muted small d-block mb-1">Total Users Registered</span>
              <h2 class="fw-bold text-dark mb-0"><%= stats.totalUsers %></h2>
            </div>
          </div>
          <div class="col-sm-6 col-lg-3">
            <div class="card-premium border-0 bg-white shadow-sm p-4 text-center">
              <i class="bi bi-telephone-inbound-fill text-purple fs-2 mb-2"></i>
              <span class="text-muted small d-block mb-1">Total Calls Initiated</span>
              <h2 class="fw-bold text-dark mb-0"><%= stats.totalCalls %></h2>
            </div>
          </div>
          <div class="col-sm-6 col-lg-3">
            <div class="card-premium border-0 bg-white shadow-sm p-4 text-center">
              <i class="bi bi-clock-fill text-primary-pink fs-2 mb-2"></i>
              <span class="text-muted small d-block mb-1">Total Minutes Transacted</span>
              <h2 class="fw-bold text-dark mb-0"><%= stats.totalMins %></h2>
            </div>
          </div>
          <div class="col-sm-6 col-lg-3">
            <div class="card-premium border-0 bg-white shadow-sm p-4 text-center">
              <i class="bi bi-currency-rupee text-success fs-2 mb-2"></i>
              <span class="text-muted small d-block mb-1">Overall Revenue Earned</span>
              <h2 class="fw-bold text-success mb-0">₹<%= stats.totalRevenue.toLocaleString('en-IN') %></h2>
            </div>
          </div>
        </div>

        <!-- Graphs Section (CSS-Based Bar Chart) -->
        <div class="row g-4 mb-4">
          <div class="col-lg-6">
            <div class="card-premium border-0 bg-white shadow-sm p-4">
              <h5 class="fw-bold mb-2">Weekly Calls Activity</h5>
              <p class="text-muted small">Number of conversations weekly</p>
              
              <div class="chart-container-css">
                <div class="chart-bar-css-wrapper">
                  <div class="chart-bar-css" data-val="120" style="height: 40%;"></div>
                  <span class="chart-bar-label">Mon</span>
                </div>
                <div class="chart-bar-css-wrapper">
                  <div class="chart-bar-css" data-val="190" style="height: 65%;"></div>
                  <span class="chart-bar-label">Tue</span>
                </div>
                <div class="chart-bar-css-wrapper">
                  <div class="chart-bar-css" data-val="250" style="height: 85%;"></div>
                  <span class="chart-bar-label">Wed</span>
                </div>
                <div class="chart-bar-css-wrapper">
                  <div class="chart-bar-css" data-val="140" style="height: 50%;"></div>
                  <span class="chart-bar-label">Thu</span>
                </div>
                <div class="chart-bar-css-wrapper">
                  <div class="chart-bar-css" data-val="290" style="height: 95%;"></div>
                  <span class="chart-bar-label">Fri</span>
                </div>
                <div class="chart-bar-css-wrapper">
                  <div class="chart-bar-css" data-val="320" style="height: 100%;"></div>
                  <span class="chart-bar-label">Sat</span>
                </div>
                <div class="chart-bar-css-wrapper">
                  <div class="chart-bar-css" data-val="180" style="height: 60%;"></div>
                  <span class="chart-bar-label">Sun</span>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-6">
            <div class="card-premium border-0 bg-white shadow-sm p-4">
              <h5 class="fw-bold mb-2">Monthly Sales Revenue</h5>
              <p class="text-muted small">Earnings in thousands (₹)</p>
              
              <div class="chart-container-css">
                <div class="chart-bar-css-wrapper">
                  <div class="chart-bar-css" data-val="₹45k" style="height: 50%; background: var(--purple-pink-gradient);"></div>
                  <span class="chart-bar-label">Apr</span>
                </div>
                <div class="chart-bar-css-wrapper">
                  <div class="chart-bar-css" data-val="₹55k" style="height: 60%; background: var(--purple-pink-gradient);"></div>
                  <span class="chart-bar-label">May</span>
                </div>
                <div class="chart-bar-css-wrapper">
                  <div class="chart-bar-css" data-val="₹72k" style="height: 75%; background: var(--purple-pink-gradient);"></div>
                  <span class="chart-bar-label">Jun</span>
                </div>
                <div class="chart-bar-css-wrapper">
                  <div class="chart-bar-css" data-val="₹68k" style="height: 70%; background: var(--purple-pink-gradient);"></div>
                  <span class="chart-bar-label">Jul</span>
                </div>
                <div class="chart-bar-css-wrapper">
                  <div class="chart-bar-css" data-val="₹94k" style="height: 95%; background: var(--purple-pink-gradient);"></div>
                  <span class="chart-bar-label">Aug</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>

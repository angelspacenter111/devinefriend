<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="app-mode">

  <!-- Admin Mobile Top App Bar -->
  <%- include('../partials/admin-header') %>

  <div class="panel-wrapper">
    <!-- Admin Sidebar Partial -->
    <%- include('../partials/admin-sidebar') %>

    <!-- Main Content Panel -->
    <div class="content-panel">
      <!-- Top Header (Desktop) -->
      <header class="header-panel shadow-sm d-none d-lg-flex">
        <div class="d-flex align-items-center gap-3">
          <h4 class="mb-0 fw-bold">Manage Pricing & Points</h4>
        </div>
        
        <div class="d-flex align-items-center gap-3">
          <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill fw-semibold">
            <span class="status-indicator-dot online me-1"></span> Dynamic Pricing Active
          </span>
          <a href="/admin/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 d-flex align-items-center gap-1.5 fw-semibold" title="Logout from Admin Panel">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
          </a>
        </div>
      </header>

      <!-- Main Contents Canvas -->
      <main class="main-content-inner">
        <div class="app-container">
          
          <!-- Pricing Config Panel -->
          <div class="card-premium border-0 bg-white shadow-sm p-4 mb-4">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3 mb-4">
              <div>
                <h5 class="fw-bold mb-1">Point Packages & Pricing</h5>
                <small class="text-muted">Total packages: <span class="fw-semibold"><%= typeof totalPlans !== 'undefined' ? totalPlans : plans.length %></span></small>
              </div>

              <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2 w-100 w-lg-auto">
                <!-- Filter Form: Search, Status -->
                <form method="GET" action="/admin/pricing" class="d-flex align-items-center gap-2 flex-grow-1">
                  <div class="input-group input-group-sm" style="min-width: 180px;">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="q" class="form-control form-control-custom border-start-0" placeholder="Search plan name/ID..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
                  </div>

                  <select name="status" class="form-select form-control-custom form-select-sm" onchange="this.form.submit()" style="min-width: 120px;">
                    <option value="all" <%= (typeof selectedStatus !== 'undefined' && selectedStatus === 'all') ? 'selected' : '' %>>All Status</option>
                    <option value="active" <%= (typeof selectedStatus !== 'undefined' && selectedStatus === 'active') ? 'selected' : '' %>>Active Only</option>
                    <option value="disabled" <%= (typeof selectedStatus !== 'undefined' && selectedStatus === 'disabled') ? 'selected' : '' %>>Disabled Only</option>
                  </select>

                  <select name="category" class="form-select form-control-custom form-select-sm" onchange="this.form.submit()" style="min-width: 130px;">
                    <option value="all" <%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'all') ? 'selected' : '' %>>All Types</option>
                    <option value="Voice" <%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Voice') ? 'selected' : '' %>>Voice Packs</option>
                    <option value="Video" <%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Video') ? 'selected' : '' %>>Video Packs</option>
                    <option value="All" <%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'All') ? 'selected' : '' %>>General</option>
                  </select>

                  <button type="submit" class="btn btn-sm btn-brand px-2.5"><i class="bi bi-funnel-fill"></i></button>
                  <% if ((typeof searchQuery !== 'undefined' && searchQuery) || (typeof selectedStatus !== 'undefined' && selectedStatus !== 'all') || (typeof selectedCategory !== 'undefined' && selectedCategory !== 'all')) { %>
                    <a href="/admin/pricing" class="btn btn-sm btn-outline-secondary px-2" title="Reset Filters"><i class="bi bi-arrow-clockwise"></i></a>
                  <% } %>
                </form>

                <button class="btn btn-brand btn-sm px-3 text-nowrap" data-bs-toggle="modal" data-bs-target="#addPlanModal">
                  <i class="bi bi-plus-lg me-1"></i> Add Plan
                </button>
              </div>
            </div>

            <!-- Mobile View: Modern Cards (visible on phones) -->
            <div class="d-block d-lg-none">
              <div class="row g-3">
                <% if (typeof plans !== 'undefined' && plans && plans.length > 0) { %>
                  <% plans.forEach(plan => { %>
                    <div class="col-12">
                      <div class="p-3.5 border rounded-4 bg-white shadow-xs position-relative">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                          <div class="d-flex align-items-center gap-1.5 flex-wrap">
                            <span class="badge <%= plan.isPopular ? 'bg-primary text-white' : 'bg-light text-dark border' %> rounded-pill px-2.5 py-1 small">
                              <%= plan.badge || plan.name %>
                            </span>
                            <% if (plan.category === 'Video') { %>
                              <span class="badge bg-purple-subtle text-purple border border-purple-subtle rounded-pill px-2 py-0.5" style="font-size: 0.72rem;">
                                <i class="bi bi-camera-video-fill me-1"></i> Video
                              </span>
                            <% } else if (plan.category === 'All') { %>
                              <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2 py-0.5" style="font-size: 0.72rem;">
                                <i class="bi bi-asterisk me-1"></i> All
                              </span>
                            <% } else { %>
                              <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-0.5" style="font-size: 0.72rem;">
                                <i class="bi bi-telephone-fill me-1"></i> Voice
                              </span>
                            <% } %>
                            <span class="text-muted font-monospace" style="font-size: 0.75rem;"><%= plan.planId %></span>
                          </div>
                          <span class="badge <%= plan.isActive ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary' %> rounded-pill px-2.5 py-1.5 btn-admin-toggle-plan" data-id="<%= plan._id %>" style="cursor: pointer;" title="Click to toggle status">
                            <i class="bi <%= plan.isActive ? 'bi-check-circle-fill' : 'bi-dash-circle-fill' %> me-1"></i><%= plan.isActive ? 'Active' : 'Disabled' %>
                          </span>
                        </div>

                        <div class="d-flex justify-content-between align-items-baseline mb-2">
                          <div>
                            <h6 class="fw-bold mb-0 text-dark"><%= plan.name %></h6>
                            <span class="text-muted small">
                              <%= plan.credits %> Points 
                              (<%= plan.category === 'Video' ? Math.floor(plan.credits / 2) + ' Video Mins' : plan.credits + ' Voice Mins' %>)
                            </span>
                          </div>
                          <div class="fs-4 fw-extrabold text-primary">₹<%= plan.price.toLocaleString('en-IN') %></div>
                        </div>

                        <% if (plan.description) { %>
                          <p class="text-muted small mb-3"><%= plan.description %></p>
                        <% } %>

                        <div class="d-flex gap-2 pt-2 border-top">
                          <button class="btn btn-sm btn-light border w-100 py-2 btn-edit-plan" 
                                  data-id="<%= plan._id %>" 
                                  data-name="<%= plan.name %>" 
                                  data-credits="<%= plan.credits %>" 
                                  data-price="<%= plan.price %>" 
                                  data-desc="<%= plan.description || '' %>" 
                                  data-badge="<%= plan.badge || '' %>" 
                                  data-category="<%= plan.category || 'Voice' %>" 
                                  data-popular="<%= plan.isPopular ? 'true' : 'false' %>">
                            <i class="bi bi-pencil-square me-1"></i> Edit Plan
                          </button>
                          <button class="btn btn-sm btn-outline-danger px-3 py-2 btn-delete-plan" 
                                  data-id="<%= plan._id %>" 
                                  data-name="<%= plan.name %>" 
                                  title="Delete Recharge Pack">
                            <i class="bi bi-trash"></i>
                          </button>
                        </div>
                      </div>
                    </div>
                  <% }) %>
                <% } else { %>
                  <div class="col-12 text-center py-5 px-3 bg-light rounded-4 border border-dashed my-2">
                    <div class="rounded-circle bg-white shadow-xs d-inline-flex align-items-center justify-content-center p-3 mb-2 text-muted">
                      <i class="bi bi-box-seam fs-2 text-muted"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-1">No Pricing Plans Found</h6>
                    <p class="text-muted small mb-3">No plans match your filter criteria.</p>
                    <a href="/admin/pricing" class="btn btn-sm btn-outline-brand rounded-pill px-3">
                      <i class="bi bi-arrow-clockwise me-1"></i> Clear Filters
                    </a>
                  </div>
                <% } %>
              </div>
            </div>

            <!-- Desktop View: High Density Table (visible on desktop) -->
            <div class="table-responsive-custom d-none d-lg-block">
              <table class="table table-premium mb-0 align-middle">
                <thead>
                  <tr>
                    <th>Plan ID</th>
                    <th>Name / Tag</th>
                    <th>Category</th>
                    <th>Points Value</th>
                    <th>Call Duration</th>
                    <th>Price Pack (₹)</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (typeof plans !== 'undefined' && plans && plans.length > 0) { %>
                    <% plans.forEach(plan => { %>
                      <tr>
                        <td><span class="fw-semibold font-monospace"><%= plan.planId %></span></td>
                        <td>
                          <strong class="d-block text-dark"><%= plan.name %></strong>
                          <% if (plan.badge) { %>
                            <span class="badge bg-light text-muted border rounded-pill px-2 py-0.5" style="font-size: 0.72rem;"><%= plan.badge %></span>
                          <% } %>
                          <% if (plan.isPopular) { %>
                            <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-0.5" style="font-size: 0.72rem;">Popular</span>
                          <% } %>
                        </td>
                        <td>
                          <% if (plan.category === 'Video') { %>
                            <span class="badge bg-purple-subtle text-purple border border-purple-subtle rounded-pill px-2.5 py-1 small">
                              <i class="bi bi-camera-video-fill me-1"></i> Video Pack
                            </span>
                          <% } else if (plan.category === 'All') { %>
                            <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2.5 py-1 small">
                              <i class="bi bi-asterisk me-1"></i> General
                            </span>
                          <% } else { %>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 small">
                              <i class="bi bi-telephone-fill me-1"></i> Voice Pack
                            </span>
                          <% } %>
                        </td>
                        <td><span class="fw-bold text-dark"><%= plan.credits %> Points</span></td>
                        <td>
                          <% if (plan.category === 'Video') { %>
                            <span class="text-purple fw-bold"><%= Math.floor(plan.credits / 2) %> Video Mins</span>
                            <small class="text-muted d-block" style="font-size: 0.72rem;">(2 pts/min)</small>
                          <% } else { %>
                            <span class="text-dark fw-semibold"><%= plan.credits %> Voice Mins</span>
                            <small class="text-muted d-block" style="font-size: 0.72rem;">(1 pt/min)</small>
                          <% } %>
                        </td>
                        <td><strong class="fs-6 text-dark">₹<%= plan.price.toLocaleString('en-IN') %></strong></td>
                        <td>
                          <span class="badge <%= plan.isActive ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary' %> rounded-pill px-2.5 py-1.5 btn-admin-toggle-plan" data-id="<%= plan._id %>" style="cursor: pointer;" title="Click to toggle status">
                            <i class="bi <%= plan.isActive ? 'bi-check-circle-fill' : 'bi-dash-circle-fill' %> me-1"></i><%= plan.isActive ? 'Active' : 'Disabled' %>
                          </span>
                        </td>
                        <td>
                          <div class="d-flex gap-1.5">
                            <button class="btn btn-sm btn-light border btn-edit-plan px-3" 
                                    data-id="<%= plan._id %>" 
                                    data-name="<%= plan.name %>" 
                                    data-credits="<%= plan.credits %>" 
                                    data-price="<%= plan.price %>" 
                                    data-desc="<%= plan.description || '' %>" 
                                    data-badge="<%= plan.badge || '' %>" 
                                    data-category="<%= plan.category || 'Voice' %>" 
                                    data-popular="<%= plan.isPopular ? 'true' : 'false' %>">
                              <i class="bi bi-pencil-square me-1"></i> Edit
                            </button>
                            <button class="btn btn-sm btn-outline-danger btn-delete-plan px-2.5" 
                                    data-id="<%= plan._id %>" 
                                    data-name="<%= plan.name %>" 
                                    title="Delete Package">
                              <i class="bi bi-trash"></i>
                            </button>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="7" class="text-center py-5">
                        <div class="py-4">
                          <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center p-3 mb-2 text-muted">
                            <i class="bi bi-box-seam fs-2 text-muted"></i>
                          </div>
                          <h6 class="fw-bold text-dark mb-1">No Pricing Plans Found</h6>
                          <p class="text-muted small mb-3">No plans match your filter criteria.</p>
                          <a href="/admin/pricing" class="btn btn-sm btn-outline-brand rounded-pill px-3">
                            <i class="bi bi-arrow-clockwise me-1"></i> Clear Filters
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>

            <!-- Pagination Partial -->
            <%- include('../partials/pagination', {
              currentPage: typeof currentPage !== 'undefined' ? currentPage : 1,
              totalPages: typeof totalPages !== 'undefined' ? totalPages : 1,
              totalRecords: typeof totalPlans !== 'undefined' ? totalPlans : plans.length,
              baseUrl: '/admin/pricing',
              queryParams: typeof queryParams !== 'undefined' ? queryParams : ''
            }) %>

          </div>

        </div>
      </main>
    </div>
  </div>

  <!-- Add Plan Bootstrap Modal -->
  <div class="modal fade" id="addPlanModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
      <div class="modal-content rounded-4 border-0 shadow-lg">
        <form id="addPlanForm">
          <div class="modal-header border-bottom-0 pb-0">
            <h5 class="fw-bold mb-0">Create New Pricing Plan</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body py-3">
            <div class="mb-3">
              <label class="form-label form-label-custom">Plan Name <span class="text-danger">*</span></label>
              <input type="text" id="add_plan_name" class="form-control form-control-custom" placeholder="e.g. Extended Support" required>
            </div>
            <div class="row g-2 mb-3">
              <div class="col-6">
                <label class="form-label form-label-custom">Category <span class="text-danger">*</span></label>
                <select id="add_plan_category" class="form-select form-control-custom" required>
                  <option value="Voice" selected>Voice Call</option>
                  <option value="Video">Video Call</option>
                  <option value="All">General / All</option>
                </select>
              </div>
              <div class="col-6">
                <label class="form-label form-label-custom">Badge / Tag</label>
                <input type="text" id="add_plan_badge" class="form-control form-control-custom" placeholder="e.g. Starter, Popular">
              </div>
            </div>
            <div class="row g-2 mb-3">
              <div class="col-6">
                <label class="form-label form-label-custom">Points <span class="text-danger">*</span></label>
                <input type="number" id="add_plan_credits" class="form-control form-control-custom" placeholder="e.g. 30" min="1" required>
              </div>
              <div class="col-6">
                <label class="form-label form-label-custom">Price (₹) <span class="text-danger">*</span></label>
                <input type="number" id="add_plan_price" class="form-control form-control-custom" placeholder="e.g. 749" min="1" required>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label form-label-custom">Description</label>
              <textarea id="add_plan_desc" class="form-control form-control-custom" rows="2" placeholder="e.g. Ideal for weekly consultation"></textarea>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="add_plan_popular">
              <label class="form-check-label small text-dark fw-semibold" for="add_plan_popular">
                Mark as "Most Popular" Plan
              </label>
            </div>
          </div>
          <div class="modal-footer border-top-0 pt-0">
            <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-sm btn-brand px-3" id="btnAddPlanSubmit">
              <i class="bi bi-check2-circle me-1"></i> Save Plan
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Edit Plan Bootstrap Modal -->
  <div class="modal fade" id="editPlanModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
      <div class="modal-content rounded-4 border-0 shadow-lg">
        <form id="editPlanForm">
          <input type="hidden" id="edit_plan_id">
          <div class="modal-header border-bottom-0 pb-0">
            <h5 class="fw-bold mb-0">Modify Pricing Plan</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body py-3">
            <div class="mb-3">
              <label class="form-label form-label-custom">Plan Name <span class="text-danger">*</span></label>
              <input type="text" id="edit_plan_name" class="form-control form-control-custom" required>
            </div>
            <div class="row g-2 mb-3">
              <div class="col-6">
                <label class="form-label form-label-custom">Category <span class="text-danger">*</span></label>
                <select id="edit_plan_category" class="form-select form-control-custom" required>
                  <option value="Voice">Voice Call</option>
                  <option value="Video">Video Call</option>
                  <option value="All">General / All</option>
                </select>
              </div>
              <div class="col-6">
                <label class="form-label form-label-custom">Badge / Tag</label>
                <input type="text" id="edit_plan_badge" class="form-control form-control-custom" placeholder="e.g. Starter, Popular">
              </div>
            </div>
            <div class="row g-2 mb-3">
              <div class="col-6">
                <label class="form-label form-label-custom">Points Value <span class="text-danger">*</span></label>
                <input type="number" id="edit_plan_credits" class="form-control form-control-custom" min="1" required>
              </div>
              <div class="col-6">
                <label class="form-label form-label-custom">Price (₹) <span class="text-danger">*</span></label>
                <input type="number" id="edit_plan_price" class="form-control form-control-custom" min="1" required>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label form-label-custom">Description</label>
              <textarea id="edit_plan_desc" class="form-control form-control-custom" rows="2"></textarea>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="edit_plan_popular">
              <label class="form-check-label small text-dark fw-semibold" for="edit_plan_popular">
                Mark as "Most Popular" Plan
              </label>
            </div>
          </div>
          <div class="modal-footer border-top-0 pt-0">
            <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-sm btn-brand px-3" id="btnEditPlanSubmit">
              <i class="bi bi-check2 me-1"></i> Update Plan Charges
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Admin Mobile Bottom Navigation -->
  <%- include('../partials/admin-bottom-nav') %>

  <!-- Admin Incoming Call Notification Modal -->
  <%- include('../partials/admin-incoming-call') %>

  <%- include('../partials/scripts') %>

  <script>
    $(document).ready(function() {
      // 1. Open Edit Modal with populated data
      $(document).on('click', '.btn-edit-plan', function() {
        const $btn = $(this);
        $('#edit_plan_id').val($btn.data('id'));
        $('#edit_plan_name').val($btn.data('name'));
        $('#edit_plan_credits').val($btn.data('credits'));
        $('#edit_plan_price').val($btn.data('price'));
        $('#edit_plan_desc').val($btn.data('desc') || '');
        $('#edit_plan_badge').val($btn.data('badge') || '');
        $('#edit_plan_category').val($btn.data('category') || 'Voice');
        
        const isPop = String($btn.data('popular')) === 'true';
        $('#edit_plan_popular').prop('checked', isPop);

        const modal = new bootstrap.Modal(document.getElementById('editPlanModal'));
        modal.show();
      });

      // 2. Submit Edit Plan Form
      $('#editPlanForm').on('submit', function(e) {
        e.preventDefault();
        const id = $('#edit_plan_id').val();
        if (!id) return;

        const $submitBtn = $('#btnEditPlanSubmit');
        const origText = $submitBtn.html();
        $submitBtn.html('<span class="spinner-border spinner-border-sm me-1"></span>Saving...').prop('disabled', true);

        const payload = {
          name: $('#edit_plan_name').val().trim(),
          category: $('#edit_plan_category').val() || 'Voice',
          credits: parseInt($('#edit_plan_credits').val(), 10),
          price: parseInt($('#edit_plan_price').val(), 10),
          badge: $('#edit_plan_badge').val().trim(),
          description: $('#edit_plan_desc').val().trim(),
          isPopular: $('#edit_plan_popular').is(':checked')
        };

        $.ajax({
          url: '/admin/pricing/update/' + id,
          method: 'POST',
          data: payload,
          success: function(res) {
            $submitBtn.html(origText).prop('disabled', false);
            if (res.success) {
              if (typeof showToast === 'function') {
                showToast(res.message || 'Pricing updated successfully!', 'success');
              } else {
                alert(res.message || 'Pricing updated successfully!');
              }
              setTimeout(function() { location.reload(); }, 600);
            } else {
              alert(res.message || 'Failed to update plan.');
            }
          },
          error: function(xhr) {
            $submitBtn.html(origText).prop('disabled', false);
            const msg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Server error updating plan.';
            alert(msg);
          }
        });
      });

      // 3. Submit Add Plan Form
      $('#addPlanForm').on('submit', function(e) {
        e.preventDefault();
        const $submitBtn = $('#btnAddPlanSubmit');
        const origText = $submitBtn.html();
        $submitBtn.html('<span class="spinner-border spinner-border-sm me-1"></span>Creating...').prop('disabled', true);

        const payload = {
          name: $('#add_plan_name').val().trim(),
          category: $('#add_plan_category').val() || 'Voice',
          credits: parseInt($('#add_plan_credits').val(), 10),
          price: parseInt($('#add_plan_price').val(), 10),
          badge: $('#add_plan_badge').val().trim(),
          description: $('#add_plan_desc').val().trim(),
          isPopular: $('#add_plan_popular').is(':checked')
        };

        $.ajax({
          url: '/admin/pricing/add',
          method: 'POST',
          data: payload,
          success: function(res) {
            $submitBtn.html(origText).prop('disabled', false);
            if (typeof res === 'string' && res.indexOf('<!DOCTYPE') !== -1) {
              window.location.href = '/admin/login';
              return;
            }
            if (res.success) {
              if (typeof showToast === 'function') {
                showToast(res.message || 'Plan created successfully!', 'success');
              } else {
                alert(res.message || 'Plan created successfully!');
              }
              setTimeout(function() { location.reload(); }, 600);
            } else {
              alert(res.message || 'Failed to add plan.');
            }
          },
          error: function(xhr) {
            $submitBtn.html(origText).prop('disabled', false);
            if (xhr.status === 401) {
              alert('Admin session expired. Please log in again.');
              window.location.href = '/admin/login';
              return;
            }
            const msg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Server error adding plan.';
            alert(msg);
          }
        });
      });

      // 4. Toggle Active/Disabled Plan
      $(document).on('click', '.btn-admin-toggle-plan', function() {
        const planId = $(this).data('id');
        if (!planId) return;

        $.ajax({
          url: '/admin/pricing/toggle/' + planId,
          method: 'POST',
          success: function(res) {
            if (res.success) {
              location.reload();
            } else {
              alert(res.message || 'Error toggling plan status');
            }
          },
          error: function() {
            alert('Server error toggling plan status');
          }
        });
      });

      // 5. Delete Recharge Pack
      $(document).on('click', '.btn-delete-plan', function() {
        const planId = $(this).data('id');
        const planName = $(this).data('name') || 'this recharge pack';
        if (!planId) return;

        if (confirm("Are you sure you want to delete '" + planName + "'?\nClients will no longer be able to purchase this pack.")) {
          $.ajax({
            url: '/admin/pricing/delete/' + planId,
            method: 'POST',
            success: function(res) {
              if (res.success) {
                if (typeof showToast === 'function') {
                  showToast(res.message || 'Recharge pack deleted successfully!', 'success');
                } else {
                  alert(res.message || 'Recharge pack deleted successfully!');
                }
                setTimeout(function() { location.reload(); }, 600);
              } else {
                alert(res.message || 'Failed to delete recharge pack.');
              }
            },
            error: function() {
              alert('Server error deleting recharge pack.');
            }
          });
        }
      });
    });
  </script>
</body>
</html>

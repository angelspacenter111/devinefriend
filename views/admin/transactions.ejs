<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body>

  <div class="panel-wrapper">
    <!-- Admin Sidebar Partial -->
    <%- include('../partials/admin-sidebar') %>

    <!-- Main Content Panel -->
    <div class="content-panel">
      <!-- Top Header -->
      <header class="header-panel shadow-sm">
        <div class="d-flex align-items-center gap-3">
          <button class="btn btn-light d-lg-none sidebar-toggle-btn" type="button">
            <i class="bi bi-list fs-4"></i>
          </button>
          <h4 class="mb-0 fw-bold">Transaction Audits</h4>
        </div>
        
        <div class="d-flex align-items-center gap-3">
          <div class="dropdown">
            <button class="btn btn-light d-flex align-items-center gap-2 border rounded-pill py-1 px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <div class="rounded-circle bg-light-lavender d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                <i class="bi bi-shield-lock text-purple"></i>
              </div>
              <span class="fw-semibold text-dark d-none d-md-block small">System Admin</span>
              <i class="bi bi-chevron-down text-muted small ms-1"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 rounded-3">
              <li><h6 class="dropdown-header">Admin Control</h6></li>
              <li><a class="dropdown-item" href="/admin/settings"><i class="bi bi-gear me-2 text-muted"></i>Settings</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item text-danger fw-semibold" href="/admin/logout"><i class="bi bi-box-arrow-right me-2 text-danger"></i>Logout</a></li>
            </ul>
          </div>

          <a href="/admin/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 d-flex align-items-center gap-1.5 fw-semibold" title="Logout from Admin Panel">
            <i class="bi bi-box-arrow-right"></i>
            <span class="d-none d-sm-inline">Logout</span>
          </a>
        </div>
      </header>

      <!-- Main Contents Canvas -->
      <main class="main-content-inner">
        <!-- Transaction Directory Card -->
        <div class="card-premium border-0 bg-white shadow-sm p-4">
          <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
            <h5 class="fw-bold mb-0">Platform Payments Ledger</h5>
            
            <div class="d-flex gap-2">
              <input type="text" class="form-control form-control-custom py-1.5" style="font-size: 0.85rem; width: 200px;" placeholder="Search Transaction ID...">
            </div>
          </div>

          <div class="table-responsive-custom">
            <table class="table table-premium mb-0 align-middle">
              <thead>
                <tr>
                  <th>Transaction ID</th>
                  <th>Date</th>
                  <th>User</th>
                  <th>Description</th>
                  <th>Credits Loaded</th>
                  <th>Amount</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% if (transactions.length === 0) { %>
                  <tr>
                    <td colspan="7" class="text-center text-muted py-4">No transactions found in database.</td>
                  </tr>
                <% } else { %>
                  <% transactions.forEach(txn => { %>
                    <% 
                      const creditFormatted = txn.type === "credit"
                        ? `<span class="text-success fw-bold">+${txn.credits} Credits</span>`
                        : `<span class="text-danger fw-bold">-${txn.credits} Credits</span>`;
                      
                      let badgeClass = "bg-success-subtle text-success";
                      if (txn.status === "Failed") badgeClass = "bg-danger-subtle text-danger";
                    %>
                    <tr>
                      <td><span class="fw-semibold"><%= txn.txnId %></span></td>
                      <td><%= txn.date ? txn.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '' %></td>
                      <td><%= txn.user ? txn.user.name : 'Deleted User' %> (<%= txn.user ? txn.user._id.toString().substring(18) : 'N/A' %>)</td>
                      <td><%= txn.desc %></td>
                      <td><%- creditFormatted %></td>
                      <td><span class="fw-bold"><%= txn.amount %></span></td>
                      <td><span class="badge <%= badgeClass %> rounded-pill px-2.5 py-1"><%= txn.status %></span></td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>

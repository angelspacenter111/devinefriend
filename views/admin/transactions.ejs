<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="app-mode">

  <!-- Admin Mobile Top App Bar -->
  <%- include('../partials/admin-header') %>

  <div class="panel-wrapper">
    <!-- Admin Sidebar Partial -->
    <%- include('../partials/admin-sidebar') %>

    <!-- Main Content Panel -->
    <div class="content-panel">
      <!-- Top Header (Desktop) -->
      <header class="header-panel shadow-sm d-none d-lg-flex">
        <div class="d-flex align-items-center gap-3">
          <h4 class="mb-0 fw-bold">Platform Recharges & Ledger</h4>
        </div>
        
        <div class="d-flex align-items-center gap-3">
          <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill fw-semibold">
            <span class="status-indicator-dot online me-1"></span> Live Ledger Active
          </span>
          <a href="/admin/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 d-flex align-items-center gap-1.5 fw-semibold" title="Logout from Admin Panel">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
          </a>
        </div>
      </header>

      <!-- Main Contents Canvas -->
      <main class="main-content-inner">
        <div class="app-container">
          <!-- Transaction Directory Card -->
          <div class="card-premium border-0 bg-white shadow-sm p-4">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3 mb-4">
              <div>
                <h5 class="fw-bold mb-1">Platform Payments & Recharges</h5>
                <small class="text-muted">Total records: <span class="fw-semibold"><%= typeof totalTransactions !== 'undefined' ? totalTransactions : transactions.length %></span></small>
              </div>

              <!-- Filter Form: Search, Type, Status, Date -->
              <form method="GET" action="/admin/transactions" class="row g-2 align-items-center w-100 mt-2 mt-lg-0" style="max-width: 780px;">
                <div class="col-12 col-sm-4">
                  <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="q" class="form-control form-control-custom border-start-0" placeholder="Txn ID, User, Phone..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
                  </div>
                </div>

                <div class="col-6 col-sm-2">
                  <select name="type" class="form-select form-control-custom form-select-sm" onchange="this.form.submit()">
                    <option value="all" <%= (typeof selectedType !== 'undefined' && selectedType === 'all') ? 'selected' : '' %>>All Types</option>
                    <option value="credit" <%= (typeof selectedType !== 'undefined' && selectedType === 'credit') ? 'selected' : '' %>>Recharge (+)</option>
                    <option value="debit" <%= (typeof selectedType !== 'undefined' && selectedType === 'debit') ? 'selected' : '' %>>Spend (-)</option>
                  </select>
                </div>

                <div class="col-6 col-sm-2">
                  <select name="status" class="form-select form-control-custom form-select-sm" onchange="this.form.submit()">
                    <option value="all" <%= (typeof selectedStatus !== 'undefined' && selectedStatus === 'all') ? 'selected' : '' %>>All Status</option>
                    <option value="Successful" <%= (typeof selectedStatus !== 'undefined' && selectedStatus === 'Successful') ? 'selected' : '' %>>Successful</option>
                    <option value="Completed" <%= (typeof selectedStatus !== 'undefined' && selectedStatus === 'Completed') ? 'selected' : '' %>>Completed</option>
                    <option value="Failed" <%= (typeof selectedStatus !== 'undefined' && selectedStatus === 'Failed') ? 'selected' : '' %>>Failed</option>
                  </select>
                </div>

                <div class="col-6 col-sm-2">
                  <input type="date" name="date" class="form-control form-control-custom form-control-sm" value="<%= typeof selectedDate !== 'undefined' ? selectedDate : '' %>" title="Filter by date">
                </div>

                <div class="col-6 col-sm-2 d-flex gap-1.5">
                  <button type="submit" class="btn btn-sm btn-brand px-2 flex-grow-1"><i class="bi bi-funnel-fill me-1"></i> Filter</button>
                  <% if ((typeof searchQuery !== 'undefined' && searchQuery) || (typeof selectedType !== 'undefined' && selectedType !== 'all') || (typeof selectedStatus !== 'undefined' && selectedStatus !== 'all') || (typeof selectedDate !== 'undefined' && selectedDate)) { %>
                    <a href="/admin/transactions" class="btn btn-sm btn-outline-secondary px-2" title="Reset Filters"><i class="bi bi-arrow-clockwise"></i></a>
                  <% } %>
                </div>
              </form>
            </div>

            <!-- Mobile Feed View (Native App Style for Phones) -->
            <div class="mobile-card-feed d-md-none mb-3">
              <% if (transactions.length === 0) { %>
                <div class="text-center py-5 px-3 bg-light rounded-4 border border-dashed my-3">
                  <div class="rounded-circle bg-white shadow-xs d-inline-flex align-items-center justify-content-center p-3 mb-2 text-muted">
                    <i class="bi bi-receipt-cutoff fs-2 text-muted"></i>
                  </div>
                  <h6 class="fw-bold text-dark mb-1">No Transactions Found</h6>
                  <p class="text-muted small mb-3">No financial ledger entries match your filter criteria.</p>
                  <a href="/admin/transactions" class="btn btn-sm btn-outline-brand rounded-pill px-3">
                    <i class="bi bi-arrow-clockwise me-1"></i> Clear Filters
                  </a>
                </div>
              <% } else { %>
                <% transactions.forEach(txn => { %>
                  <% 
                    const isCredit = txn.type === "credit";
                    let badgeClass = "bg-success-subtle text-success";
                    if (txn.status === "Failed") badgeClass = "bg-danger-subtle text-danger";
                  %>
                  <div class="mobile-data-card">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <span class="badge <%= badgeClass %> rounded-pill px-2.5 py-1"><%= txn.status %></span>
                      <strong class="text-dark fs-6"><%= txn.amount %></strong>
                    </div>
                    
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <div>
                        <strong class="d-block text-dark small"><%= txn.user ? txn.user.name : 'Deleted User' %></strong>
                        <small class="text-muted"><%= txn.desc %></small>
                      </div>
                      <div class="text-end">
                        <span class="fw-bold <%= isCredit ? 'text-success' : 'text-danger' %> small d-block">
                          <%= isCredit ? '+' : '-' %><%= txn.credits %> Pts
                        </span>
                        <small class="text-muted font-monospace"><%= txn.date ? txn.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }) : '' %></small>
                      </div>
                    </div>

                    <div class="pt-2 border-top d-flex align-items-center justify-content-between">
                      <small class="text-muted font-monospace" style="font-size: 0.72rem;"><%= txn.txnId %></small>
                      <span class="badge bg-light text-secondary border rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">Inflow</span>
                    </div>
                  </div>
                <% }) %>
              <% } %>
            </div>

            <!-- Desktop Table View -->
            <div class="table-responsive-custom d-none d-md-block">
              <table class="table table-premium mb-0 align-middle">
                <thead>
                  <tr>
                    <th>Transaction ID</th>
                    <th>Date</th>
                    <th>User</th>
                    <th>Description</th>
                    <th>Points Loaded</th>
                    <th>Amount Received</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (transactions.length === 0) { %>
                    <tr>
                      <td colspan="7" class="text-center py-5">
                        <div class="py-4">
                          <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center p-3 mb-2 text-muted">
                            <i class="bi bi-receipt-cutoff fs-2 text-muted"></i>
                          </div>
                          <h6 class="fw-bold text-dark mb-1">No Transactions Found</h6>
                          <p class="text-muted small mb-3">No financial ledger entries match your filter criteria.</p>
                          <a href="/admin/transactions" class="btn btn-sm btn-outline-brand rounded-pill px-3">
                            <i class="bi bi-arrow-clockwise me-1"></i> Clear Filters
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% } else { %>
                    <% transactions.forEach(txn => { %>
                      <% 
                        const creditFormatted = txn.type === "credit"
                          ? `<span class="text-success fw-bold">+${txn.credits} Points</span>`
                          : `<span class="text-danger fw-bold">-${txn.credits} Points</span>`;
                        
                        let badgeClass = "bg-success-subtle text-success";
                        if (txn.status === "Failed") badgeClass = "bg-danger-subtle text-danger";
                      %>
                      <tr>
                        <td><span class="fw-semibold"><%= txn.txnId %></span></td>
                        <td><%= txn.date ? txn.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '' %></td>
                        <td><%= txn.user ? txn.user.name : 'Deleted User' %> (<%= txn.user ? txn.user._id.toString().substring(18) : 'N/A' %>)</td>
                        <td><%= txn.desc %></td>
                        <td><%- creditFormatted %></td>
                        <td><strong class="text-dark"><%= txn.amount %></strong></td>
                        <td><span class="badge <%= badgeClass %> rounded-pill px-2.5 py-1"><%= txn.status %></span></td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>

            <!-- Pagination Partial -->
            <%- include('../partials/pagination', {
              currentPage: typeof currentPage !== 'undefined' ? currentPage : 1,
              totalPages: typeof totalPages !== 'undefined' ? totalPages : 1,
              totalRecords: typeof totalTransactions !== 'undefined' ? totalTransactions : transactions.length,
              baseUrl: '/admin/transactions',
              queryParams: typeof queryParams !== 'undefined' ? queryParams : ''
            }) %>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- Admin Mobile Bottom Navigation -->
  <%- include('../partials/admin-bottom-nav') %>

  <!-- Admin Incoming Call Notification Modal -->
  <%- include('../partials/admin-incoming-call') %>

  <%- include('../partials/scripts') %>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="app-mode">

  <!-- Admin Mobile Top App Bar -->
  <%- include('../partials/admin-header') %>

  <div class="panel-wrapper">
    <!-- Admin Sidebar Partial -->
    <%- include('../partials/admin-sidebar') %>

    <!-- Main Content Panel -->
    <div class="content-panel">
      <!-- Top Header (Desktop) -->
      <header class="header-panel shadow-sm d-none d-lg-flex">
        <div class="d-flex align-items-center gap-3">
          <h4 class="mb-0 fw-bold">Platform Reports & Analytics</h4>
        </div>
        
        <div class="d-flex align-items-center gap-3">
          <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill fw-semibold">
            <span class="status-indicator-dot online me-1"></span> Live Console Active
          </span>
          <a href="/admin/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 d-flex align-items-center gap-1.5 fw-semibold" title="Logout from Admin Panel">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
          </a>
        </div>
      </header>

      <!-- Main Contents Canvas -->
      <main class="main-content-inner">
        <div class="app-container">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4 p-3 bg-white rounded-3 shadow-sm border">
          <div>
            <span class="text-muted small">Select Report Timeline</span>
          </div>
          <div class="d-flex gap-2">
            <button class="btn btn-sm btn-secondary-light">This Week</button>
            <button class="btn btn-sm btn-light border">This Month</button>
            <button class="btn btn-sm btn-light border">All Time</button>
          </div>
        </div>

        <div class="row g-4 mb-4">
          <div class="col-lg-8">
            <div class="card-premium border-0 bg-white shadow-sm p-4 h-100">
              <h5 class="fw-bold mb-2">Overall Call Volume</h5>
              <p class="text-muted small">Daily call connection load count</p>
              
              <div class="chart-container-css">
                <div class="chart-bar-css-wrapper">
                  <div class="chart-bar-css" data-val="12 Calls" style="height: 30%;"></div>
                  <span class="chart-bar-label">Mon</span>
                </div>
                <div class="chart-bar-css-wrapper">
                  <div class="chart-bar-css" data-val="25 Calls" style="height: 55%;"></div>
                  <span class="chart-bar-label">Tue</span>
                </div>
                <div class="chart-bar-css-wrapper">
                  <div class="chart-bar-css" data-val="45 Calls" style="height: 85%;"></div>
                  <span class="chart-bar-label">Wed</span>
                </div>
                <div class="chart-bar-css-wrapper">
                  <div class="chart-bar-css" data-val="18 Calls" style="height: 40%;"></div>
                  <span class="chart-bar-label">Thu</span>
                </div>
                <div class="chart-bar-css-wrapper">
                  <div class="chart-bar-css" data-val="55 Calls" style="height: 100%;"></div>
                  <span class="chart-bar-label">Fri</span>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-4">
            <div class="card-premium border-0 bg-white shadow-sm p-4 h-100">
              <h5 class="fw-bold mb-4">Metric Breakdowns</h5>
              <div class="d-grid gap-3.5 small">
                <div class="p-3 bg-light rounded-3">
                  <span class="text-muted d-block mb-1">Average Daily Revenue</span>
                  <h4 class="fw-bold text-dark mb-0">₹<%= ((typeof metrics !== 'undefined' && metrics && metrics.avgDailyRevenue) || 0).toLocaleString('en-IN') %></h4>
                </div>
                <div class="p-3 bg-light rounded-3">
                  <span class="text-muted d-block mb-1">Active Callers Ratio</span>
                  <h4 class="fw-bold text-dark mb-0"><%= metrics.activeCallersRatio %>%</h4>
                </div>
                <div class="p-3 bg-light rounded-3">
                  <span class="text-muted d-block mb-1">Avg Rating</span>
                  <h4 class="fw-bold text-success mb-0">4.9 / 5.0</h4>
                </div>
              </div>
            </div>
          </div>
        </div>
        </div>
      </main>
    </div>
  </div>

  <!-- Admin Mobile Bottom Navigation -->
  <%- include('../partials/admin-bottom-nav') %>

  <!-- Admin Incoming Call Notification Modal -->
  <%- include('../partials/admin-incoming-call') %>

  <%- include('../partials/scripts') %>
</body>
</html>

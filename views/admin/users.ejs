<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="app-mode">

  <!-- Admin Mobile Top App Bar -->
  <%- include('../partials/admin-header') %>

  <div class="panel-wrapper">
    <!-- Admin Sidebar Partial -->
    <%- include('../partials/admin-sidebar') %>

    <!-- Main Content Panel -->
    <div class="content-panel">
      <!-- Top Header (Desktop) -->
      <header class="header-panel shadow-sm d-none d-lg-flex">
        <div class="d-flex align-items-center gap-3">
          <h4 class="mb-0 fw-bold">User Directory</h4>
        </div>
        
        <div class="d-flex align-items-center gap-3">
          <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill fw-semibold">
            <span class="status-indicator-dot online me-1"></span> Live Console Active
          </span>
          <a href="/admin/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 d-flex align-items-center gap-1.5 fw-semibold" title="Logout from Admin Panel">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
          </a>
        </div>
      </header>

      <!-- Main Contents Canvas -->
      <main class="main-content-inner">
        <div class="app-container">
          <!-- User Directory Card -->
        <div class="card-premium border-0 bg-white shadow-sm p-4">
          <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3 mb-4">
            <div>
              <h5 class="fw-bold mb-1">Platform Accounts</h5>
              <small class="text-muted">Total users: <span class="fw-semibold"><%= typeof totalUsers !== 'undefined' ? totalUsers : users.length %></span></small>
            </div>
            
            <!-- Filters Form: Search, Status, Sort -->
            <form method="GET" action="/admin/users" class="row g-2 align-items-center w-100 mt-2 mt-lg-0" style="max-width: 720px;">
              <div class="col-12 col-sm-4">
                <div class="input-group input-group-sm">
                  <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                  <input type="text" name="q" class="form-control form-control-custom border-start-0" placeholder="Search name, phone, ID..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
                </div>
              </div>

              <div class="col-6 col-sm-3">
                <select name="status" class="form-select form-control-custom form-select-sm" onchange="this.form.submit()">
                  <option value="all" <%= (typeof selectedStatus !== 'undefined' && selectedStatus === 'all') ? 'selected' : '' %>>All Statuses</option>
                  <option value="active" <%= (typeof selectedStatus !== 'undefined' && selectedStatus === 'active') ? 'selected' : '' %>>Active</option>
                  <option value="suspended" <%= (typeof selectedStatus !== 'undefined' && selectedStatus === 'suspended') ? 'selected' : '' %>>Suspended</option>
                </select>
              </div>

              <div class="col-6 col-sm-3">
                <select name="sortBy" class="form-select form-control-custom form-select-sm" onchange="this.form.submit()">
                  <option value="newest" <%= (typeof selectedSort !== 'undefined' && selectedSort === 'newest') ? 'selected' : '' %>>Newest Joined</option>
                  <option value="oldest" <%= (typeof selectedSort !== 'undefined' && selectedSort === 'oldest') ? 'selected' : '' %>>Oldest</option>
                  <option value="credits_high" <%= (typeof selectedSort !== 'undefined' && selectedSort === 'credits_high') ? 'selected' : '' %>>Highest Coins</option>
                  <option value="credits_low" <%= (typeof selectedSort !== 'undefined' && selectedSort === 'credits_low') ? 'selected' : '' %>>Lowest Coins</option>
                </select>
              </div>

              <div class="col-12 col-sm-2 d-flex gap-1.5">
                <button type="submit" class="btn btn-sm btn-brand px-3 flex-grow-1"><i class="bi bi-funnel-fill me-1"></i> Filter</button>
                <% if ((typeof searchQuery !== 'undefined' && searchQuery) || (typeof selectedStatus !== 'undefined' && selectedStatus !== 'all') || (typeof selectedSort !== 'undefined' && selectedSort !== 'newest')) { %>
                  <a href="/admin/users" class="btn btn-sm btn-outline-secondary px-2" title="Reset Filters"><i class="bi bi-arrow-clockwise"></i></a>
                <% } %>
              </div>
            </form>
          </div>

          <!-- Mobile Feed View (Native App Style for Phones) -->
          <div class="mobile-card-feed d-md-none mb-3">
            <% if (users.length === 0) { %>
              <div class="text-center py-5 px-3 bg-light rounded-4 border border-dashed my-3">
                <div class="rounded-circle bg-white shadow-xs d-inline-flex align-items-center justify-content-center p-3 mb-2 text-muted">
                  <i class="bi bi-person-x fs-2 text-muted"></i>
                </div>
                <h6 class="fw-bold text-dark mb-1">No Users Found</h6>
                <p class="text-muted small mb-3">No registered users match your search or filter criteria.</p>
                <a href="/admin/users" class="btn btn-sm btn-outline-brand rounded-pill px-3">
                  <i class="bi bi-arrow-clockwise me-1"></i> Clear Filters
                </a>
              </div>
            <% } else { %>
              <% users.forEach(usr => { %>
                <% 
                  let badgeClass = "bg-success-subtle text-success";
                  let statusText = "Active";
                  if (usr.isBlocked) {
                    badgeClass = "bg-danger-subtle text-danger";
                    statusText = "Suspended";
                  }
                %>
                <div class="mobile-data-card">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="d-flex align-items-center gap-2">
                      <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold small" style="width: 34px; height: 34px;">
                        <%= usr.name ? usr.name.charAt(0).toUpperCase() : 'U' %>
                      </div>
                      <div>
                        <strong class="text-dark d-block small"><%= usr.name %></strong>
                        <small class="text-muted"><%= usr.mobile %><% if (usr.email) { %> • <%= usr.email %><% } %></small>
                      </div>
                    </div>
                    <span class="badge <%= badgeClass %> status-badge rounded-pill px-2.5 py-1"><%= statusText %></span>
                  </div>
                  
                  <div class="d-flex align-items-center justify-content-between py-2 border-top border-bottom my-2">
                    <span class="small text-muted"><i class="bi bi-telephone me-1"></i><%= usr.callCount %> calls</span>
                    <span class="fw-bold text-purple small" title="Current Wallet Balance"><span class="user-credits-val"><%= usr.credits %></span> Avail</span>
                    <span class="badge bg-warning-subtle text-dark border rounded-pill px-2 py-0.5 small" title="Coins consumed in consultations"><i class="bi bi-coin text-warning me-1"></i><%= usr.creditsUsed || 0 %> coins used</span>
                    <span class="small text-muted"><%= usr.joined ? usr.joined.toLocaleDateString('en-GB', { timeZone: 'Asia/Dubai', day: '2-digit', month: 'short' }) : '' %></span>
                  </div>

                  <div class="d-flex gap-1.5 justify-content-end flex-wrap">
                    <button class="btn btn-sm btn-light border px-2.5 btn-wallet-edit" title="Edit Wallet Coins" data-bs-toggle="modal" data-bs-target="#editWalletModal" data-id="<%= usr._id %>" data-name="<%= usr.name %>" data-credits="<%= usr.credits %>" <%= usr.isBlocked ? 'disabled' : '' %>>
                      <i class="bi bi-wallet2 text-primary me-1"></i> Wallet
                    </button>
                    
                    <button class="btn btn-sm btn-light border px-2.5 btn-password-edit" title="Reset Password" data-bs-toggle="modal" data-bs-target="#editPasswordModal" data-id="<%= usr._id %>" data-name="<%= usr.name %>" data-mobile="<%= usr.mobile %>" data-email="<%= usr.email || '' %>">
                      <i class="bi bi-key text-warning me-1"></i> Password
                    </button>

                    <% if (usr.isBlocked) { %>
                      <button class="btn btn-sm btn-danger btn-admin-block px-2.5" data-id="<%= usr._id %>"><i class="bi bi-x-circle me-1"></i> Unblock</button>
                    <% } else { %>
                      <button class="btn btn-sm btn-outline-danger btn-admin-block px-2.5" data-id="<%= usr._id %>"><i class="bi bi-x-circle me-1"></i> Block</button>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>

          <!-- Desktop Table View -->
          <div class="table-responsive-custom d-none d-md-block">
            <table class="table table-premium mb-0 align-middle">
              <thead>
                <tr>
                  <th>User ID</th>
                  <th>Name</th>
                  <th>Mobile</th>
                  <th>Available Balance</th>
                  <th>Coins Consumed</th>
                  <th>Total Calls</th>
                  <th>Joined Date</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (users.length === 0) { %>
                  <tr>
                    <td colspan="9" class="text-center py-5">
                      <div class="py-4">
                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center p-3 mb-2 text-muted">
                          <i class="bi bi-person-x fs-2 text-muted"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">No Users Found</h6>
                        <p class="text-muted small mb-3">No registered users match your search or filter criteria.</p>
                        <a href="/admin/users" class="btn btn-sm btn-outline-brand rounded-pill px-3">
                          <i class="bi bi-arrow-clockwise me-1"></i> Clear Filters
                        </a>
                      </div>
                    </td>
                  </tr>
                <% } else { %>
                  <% users.forEach(usr => { %>
                    <% 
                      let badgeClass = "bg-success-subtle text-success";
                      let statusText = "Active";
                      if (usr.isBlocked) {
                        badgeClass = "bg-danger-subtle text-danger";
                        statusText = "Suspended";
                      }
                    %>
                    <tr>
                      <td><span class="fw-semibold font-monospace"><%= usr._id.toString().substring(18) %></span></td>
                      <td>
                        <strong><%= usr.name %></strong>
                        <% if (usr.email) { %>
                          <small class="text-muted d-block font-monospace" style="font-size: 0.78rem;"><%= usr.email %></small>
                        <% } %>
                      </td>
                      <td><%= usr.mobile %></td>
                      <td><span class="fw-bold text-purple"><span class="user-credits-val"><%= usr.credits %></span> Coins</span></td>
                      <td>
                        <span class="badge bg-warning-subtle text-warning-emphasis border rounded-pill px-2.5 py-1 fw-bold">
                          <i class="bi bi-coin me-1"></i><%= usr.creditsUsed || 0 %> Coins Used
                        </span>
                      </td>
                      <td><%= usr.callCount %> calls</td>
                      <td><%= usr.joined ? usr.joined.toLocaleDateString('en-GB', { timeZone: 'Asia/Dubai', day: '2-digit', month: 'short', year: 'numeric' }) : '' %></td>
                      <td><span class="badge <%= badgeClass %> status-badge rounded-pill px-2.5 py-1.5"><%= statusText %></span></td>
                      <td>
                        <div class="d-flex gap-1.5">
                          <button class="btn btn-sm btn-light border px-2 btn-wallet-edit" title="Edit Wallet Coins" data-bs-toggle="modal" data-bs-target="#editWalletModal" data-id="<%= usr._id %>" data-name="<%= usr.name %>" data-credits="<%= usr.credits %>" <%= usr.isBlocked ? 'disabled' : '' %>><i class="bi bi-wallet2 text-primary-blue"></i> Wallet</button>
                          
                          <button class="btn btn-sm btn-light border px-2 btn-password-edit" title="Update User Password" data-bs-toggle="modal" data-bs-target="#editPasswordModal" data-id="<%= usr._id %>" data-name="<%= usr.name %>" data-mobile="<%= usr.mobile %>" data-email="<%= usr.email || '' %>"><i class="bi bi-key text-warning"></i> Password</button>

                          <% if (usr.isBlocked) { %>
                            <button class="btn btn-sm btn-danger btn-admin-block px-2" data-id="<%= usr._id %>"><i class="bi bi-x-circle me-1"></i> Blocked</button>
                          <% } else { %>
                            <button class="btn btn-sm btn-outline-danger btn-admin-block px-2" data-id="<%= usr._id %>"><i class="bi bi-x-circle me-1"></i> Block</button>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Pagination Partial -->
          <%- include('../partials/pagination', {
            currentPage: typeof currentPage !== 'undefined' ? currentPage : 1,
            totalPages: typeof totalPages !== 'undefined' ? totalPages : 1,
            totalRecords: typeof totalUsers !== 'undefined' ? totalUsers : users.length,
            baseUrl: '/admin/users',
            queryParams: typeof queryParams !== 'undefined' ? queryParams : ''
          }) %>
        </div>
        </div>
      </main>
    </div>
  </div>

  <!-- Admin Mobile Bottom Navigation -->
  <%- include('../partials/admin-bottom-nav') %>

  <!-- Admin Incoming Call Notification Modal -->
  <%- include('../partials/admin-incoming-call') %>

  <!-- Wallet Modification Bootstrap Modal -->
  <div class="modal fade" id="editWalletModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
      <div class="modal-content rounded-4 border-0 shadow-lg">
        <div class="modal-header border-bottom-0 pb-0">
          <h5 class="fw-bold mb-0">Modify Coins: <span id="modal-user-name" class="text-primary-pink">User</span></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body py-4">
          <p class="text-muted small">Update the wallet balance directly. Add coins for loyalty, or adjust after technical issue refunds.</p>
          <div class="mb-3">
            <label class="form-label form-label-custom">Direct Coins Adjustment</label>
            <input type="number" class="form-control form-control-custom" id="wallet-credits-input" value="25" min="0">
          </div>
          <div class="mb-3">
            <label class="form-label form-label-custom">Reason for Change</label>
            <select class="form-select form-control-custom">
              <option>Technical issue coin restore</option>
              <option>Loyalty promotion reward</option>
              <option>Manual billing coin load</option>
              <option>Administrative adjustment</option>
            </select>
          </div>
        </div>
        <div class="modal-footer border-top-0 pt-0">
          <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-sm btn-brand px-3" id="btn-save-wallet">Save Changes</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Password Modification Bootstrap Modal for Admin -->
  <div class="modal fade" id="editPasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 430px;">
      <div class="modal-content rounded-4 border-0 shadow-lg">
        <div class="modal-header border-bottom-0 pb-0">
          <div>
            <h5 class="fw-bold mb-1"><i class="bi bi-shield-lock text-primary-pink me-1"></i> Update User Password</h5>
            <small class="text-muted">User: <strong id="modal-pwd-user-name" class="text-dark">User</strong> (<span id="modal-pwd-user-info" class="font-monospace"></span>)</small>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body py-3">
          <div id="modal-pwd-alert" class="alert alert-danger py-2 small mb-3" style="display: none;"></div>
          <div id="modal-pwd-success" class="alert alert-success py-2 small mb-3" style="display: none;"></div>

          <div class="mb-3">
            <label class="form-label form-label-custom">New Password</label>
            <div class="input-group">
              <span class="input-group-text bg-white border-end-0 border-1"><i class="bi bi-lock text-muted"></i></span>
              <input type="password" class="form-control form-control-custom border-start-0 border-end-0 ps-2" id="admin-user-new-password" placeholder="Minimum 6 characters" autocomplete="new-password">
              <button type="button" class="input-group-text bg-white border-start-0 border-1 toggle-modal-pwd-btn" data-target="admin-user-new-password" style="cursor: pointer;">
                <i class="bi bi-eye text-muted"></i>
              </button>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label form-label-custom">Confirm New Password</label>
            <div class="input-group">
              <span class="input-group-text bg-white border-end-0 border-1"><i class="bi bi-shield-check text-muted"></i></span>
              <input type="password" class="form-control form-control-custom border-start-0 border-end-0 ps-2" id="admin-user-confirm-password" placeholder="Re-enter new password" autocomplete="new-password">
              <button type="button" class="input-group-text bg-white border-start-0 border-1 toggle-modal-pwd-btn" data-target="admin-user-confirm-password" style="cursor: pointer;">
                <i class="bi bi-eye text-muted"></i>
              </button>
            </div>
          </div>

          <div class="d-flex justify-content-between align-items-center pt-1">
            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none small text-primary-pink fw-semibold" id="btn-admin-generate-pwd">
              <i class="bi bi-magic me-1"></i> Auto-Generate Password
            </button>
            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none small text-muted" id="btn-admin-copy-pwd" style="display: none;">
              <i class="bi bi-clipboard me-1"></i> Copy to Clipboard
            </button>
          </div>
        </div>
        <div class="modal-footer border-top-0 pt-0">
          <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-sm btn-brand px-3" id="btn-save-user-password">
            <span class="spinner-border spinner-border-sm me-1 d-none" id="spinner-save-pwd"></span>
            Update Password
          </button>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
  
  <script>
    let currentUserIdForWallet = null;
    let currentUserIdForPassword = null;

    $(document).ready(function() {
      // 1. Handle Wallet Modal Open & Load Values
      $('.btn-wallet-edit').on('click', function() {
        currentUserIdForWallet = $(this).data('id');
        $('#modal-user-name').text($(this).data('name'));
        $('#wallet-credits-input').val($(this).data('credits'));
      });

      // 2. Submit Wallet Coin adjustments
      $('#btn-save-wallet').on('click', function() {
        const newCredits = $('#wallet-credits-input').val();
        if (!currentUserIdForWallet) return;
        
        $.ajax({
          url: '/admin/users/update-wallet/' + currentUserIdForWallet,
          method: 'POST',
          data: { credits: newCredits },
          success: function(res) {
            if (res.success) {
              $('#editWalletModal').modal('hide');
              location.reload();
            } else {
              alert(res.message || 'Failed to update coins.');
            }
          },
          error: function(err) {
            alert('Server error updating coins.');
          }
        });
      });

      // 3. Handle Admin Password Modal Open & Initialization
      $(document).on('click', '.btn-password-edit', function() {
        const $el = $(this);
        currentUserIdForPassword = $el.attr('data-id') || $el.data('id');
        const userName = $el.attr('data-name') || $el.data('name') || 'User';
        const userMobile = $el.attr('data-mobile') || $el.data('mobile') || '';
        const userEmail = $el.attr('data-email') || $el.data('email') || '';
        
        $('#modal-pwd-user-name').text(userName);
        $('#modal-pwd-user-info').text(userEmail ? (userMobile + ' • ' + userEmail) : userMobile);
        
        // Reset inputs and messages
        $('#admin-user-new-password').val('').attr('type', 'password');
        $('#admin-user-confirm-password').val('').attr('type', 'password');
        $('.toggle-modal-pwd-btn i').removeClass('bi-eye-slash').addClass('bi-eye');
        $('#modal-pwd-alert').hide().text('');
        $('#modal-pwd-success').hide().text('');
        $('#btn-admin-copy-pwd').hide();
      });

      // 4. Modal Password Visibility Toggle
      $('.toggle-modal-pwd-btn').on('click', function() {
        const targetId = $(this).data('target');
        const $input = $('#' + targetId);
        const $icon = $(this).find('i');
        
        if ($input.attr('type') === 'password') {
          $input.attr('type', 'text');
          $icon.removeClass('bi-eye').addClass('bi-eye-slash');
        } else {
          $input.attr('type', 'password');
          $icon.removeClass('bi-eye-slash').addClass('bi-eye');
        }
      });

      // 5. Auto-Generate Secure Random Password
      $('#btn-admin-generate-pwd').on('click', function() {
        const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789!@#$%&*';
        let generated = 'Talk@';
        for (let i = 0; i < 4; i++) {
          generated += chars.charAt(Math.floor(Math.random() * chars.length));
        }
        generated += Math.floor(10 + Math.random() * 90);

        $('#admin-user-new-password').val(generated).attr('type', 'text');
        $('#admin-user-confirm-password').val(generated).attr('type', 'text');
        $('.toggle-modal-pwd-btn i').removeClass('bi-eye').addClass('bi-eye-slash');
        $('#btn-admin-copy-pwd').show();
        $('#modal-pwd-alert').hide();
      });

      // 6. Copy Generated Password to Clipboard
      $('#btn-admin-copy-pwd').on('click', function() {
        const pwd = $('#admin-user-new-password').val();
        if (pwd && navigator.clipboard) {
          navigator.clipboard.writeText(pwd).then(() => {
            $(this).html('<i class="bi bi-check-lg me-1 text-success"></i> Copied!');
            setTimeout(() => {
              $('#btn-admin-copy-pwd').html('<i class="bi bi-clipboard me-1"></i> Copy to Clipboard');
            }, 2500);
          });
        }
      });

      // 7. Submit Password Update via AJAX
      $('#btn-save-user-password').on('click', function() {
        const pwd = $('#admin-user-new-password').val().trim();
        const confirm = $('#admin-user-confirm-password').val().trim();
        const $alert = $('#modal-pwd-alert');
        const $success = $('#modal-pwd-success');
        const $btn = $(this);
        const $spinner = $('#spinner-save-pwd');

        $alert.hide().text('');
        $success.hide().text('');

        if (!currentUserIdForPassword) {
          $alert.text('User identification missing. Please close and re-open modal.').show();
          return;
        }

        if (!pwd || pwd.length < 6) {
          $alert.text('Password must be at least 6 characters long.').show();
          $('#admin-user-new-password').focus();
          return;
        }

        if (pwd !== confirm) {
          $alert.text('Passwords do not match. Please verify both fields.').show();
          $('#admin-user-confirm-password').focus();
          return;
        }

        $btn.prop('disabled', true);
        $spinner.removeClass('d-none');

        $.ajax({
          url: '/admin/users/update-password/' + currentUserIdForPassword,
          method: 'POST',
          data: {
            password: pwd,
            confirmPassword: confirm
          },
          dataType: 'json',
          headers: {
            'Accept': 'application/json'
          },
          success: function(res) {
            $btn.prop('disabled', false);
            $spinner.addClass('d-none');

            if (res && res.success) {
              $success.html('<i class="bi bi-check-circle-fill me-1"></i> ' + (res.message || 'Password updated successfully!')).show();
              setTimeout(() => {
                $('#editPasswordModal').modal('hide');
              }, 1500);
            } else {
              $alert.text((res && res.message) ? res.message : 'Failed to update password.').show();
            }
          },
          error: function(xhr) {
            $btn.prop('disabled', false);
            $spinner.addClass('d-none');
            let errText = 'Server error updating password. Please try again.';
            if (xhr.responseJSON && xhr.responseJSON.message) {
              errText = xhr.responseJSON.message;
            } else if (xhr.responseText) {
              try {
                const parsed = JSON.parse(xhr.responseText);
                if (parsed.message) errText = parsed.message;
              } catch (e) {}
            }
            $alert.text(errText).show();
          }
        });
      });

      // 8. Block/Unblock users toggle
      $('.btn-admin-block').on('click', function() {
        const $btn = $(this);
        const userId = $btn.data('id');
        
        $.ajax({
          url: '/admin/users/block/' + userId,
          method: 'POST',
          success: function(res) {
            if (res.success) {
              if (res.isBlocked) {
                $btn.removeClass('btn-outline-danger').addClass('btn-danger').html('<i class="bi bi-x-circle me-1"></i> Blocked');
                $btn.closest('tr').find('.status-badge').removeClass('bg-success-subtle text-success').addClass('bg-danger-subtle text-danger').text('Suspended');
                $btn.closest('tr').find('.btn-wallet-edit').prop('disabled', true);
              } else {
                $btn.removeClass('btn-danger').addClass('btn-outline-danger').html('<i class="bi bi-x-circle me-1"></i> Block');
                $btn.closest('tr').find('.status-badge').removeClass('bg-danger-subtle text-danger').addClass('bg-success-subtle text-success').text('Active');
                $btn.closest('tr').find('.btn-wallet-edit').prop('disabled', false);
              }
            } else {
              alert(res.message || 'Failed to update block status.');
            }
          },
          error: function(err) {
            alert('Server error toggling block status.');
          }
        });
      });
    });
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="bg-soft-gradient min-vh-100 d-flex align-items-center py-5 position-relative">
  <div class="backdrop-glow"></div>

  <div class="container position-relative z-3">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        
        <div class="text-center mb-4">
          <a class="navbar-brand d-inline-flex align-items-center mb-2" href="/">
            <i class="bi bi-heart-pulse-fill text-primary-pink me-2" style="font-size: 1.8rem; color: #E91E8F;"></i>
            <span class="brand-text text-uppercase fw-extrabold fs-3">Friend</span>
          </a>
          <p class="text-muted small">Platform Control Center</p>
        </div>

        <div class="card-premium border-0 bg-white shadow-lg p-4 p-md-5">
          <div class="text-center mb-4">
            <h3 class="fw-bold text-dark"><i class="bi bi-shield-lock text-purple me-2"></i>Admin Access</h3>
            <p class="text-muted small">Provide authorized credentials to access platform statistics, user databases, and system pricing.</p>
          </div>

          <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div class="alert alert-danger mb-3 py-2.5 rounded-3 text-center small" role="alert">
              <i class="bi bi-exclamation-triangle-fill me-2"></i><%= errorMessage %>
            </div>
          <% } %>

          <form action="/admin/login" method="POST" class="auth-form-validate">
            <div class="mb-3">
              <label for="admin-username" class="form-label form-label-custom">Admin ID / Email</label>
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0 border-1" style="border-radius: 10px 0 0 10px; border-color: rgba(24,32,51,0.1);"><i class="bi bi-shield-shaded text-muted"></i></span>
                <input type="email" class="form-control form-control-custom border-start-0 ps-2" id="admin-username" name="email" placeholder="admin@friend.com" required style="border-radius: 0 10px 10px 0;">
              </div>
            </div>

            <div class="mb-4">
              <label for="admin-password" class="form-label form-label-custom">Security Password</label>
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0 border-1" style="border-radius: 10px 0 0 10px; border-color: rgba(24,32,51,0.1);"><i class="bi bi-key text-muted"></i></span>
                <input type="password" class="form-control form-control-custom border-start-0 ps-2" id="admin-password" name="password" placeholder="••••••••" required style="border-radius: 0 10px 10px 0;">
              </div>
            </div>

            <button type="submit" class="btn btn-brand w-100 py-3">Enter Control Room</button>
          </form>
        </div>

        <div class="text-center mt-4">
          <a href="/" class="text-muted small"><i class="bi bi-arrow-left me-1"></i> Back to public home</a>
        </div>

      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>

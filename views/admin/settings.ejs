<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="app-mode">

  <!-- Admin Mobile Top App Bar -->
  <%- include('../partials/admin-header') %>

  <div class="panel-wrapper">
    <!-- Admin Sidebar Partial -->
    <%- include('../partials/admin-sidebar') %>

    <!-- Main Content Panel -->
    <div class="content-panel">
      <!-- Top Header (Desktop) -->
      <header class="header-panel shadow-sm d-none d-lg-flex">
        <div class="d-flex align-items-center gap-3">
          <h4 class="mb-0 fw-bold">Platform Settings</h4>
        </div>
        
        <div class="d-flex align-items-center gap-3">
          <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill fw-semibold">
            <span class="status-indicator-dot online me-1"></span> Live Console Active
          </span>
          <a href="/admin/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 d-flex align-items-center gap-1.5 fw-semibold" title="Logout from Admin Panel">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
          </a>
        </div>
      </header>

      <!-- Main Contents Canvas -->
      <main class="main-content-inner">
        <div class="app-container">
        <div class="row g-4">
          <!-- Left side: General profile & Password -->
          <div class="col-lg-6">
            <div class="card-premium border-0 bg-white shadow-sm p-4 mb-4">
              <h5 class="fw-bold mb-4">Admin Profile Settings</h5>
              <form onsubmit="event.preventDefault(); alert('Settings saved successfully in simulation mode!')">
                <div class="mb-3">
                  <label class="form-label form-label-custom">Admin Full Name</label>
                  <input type="text" class="form-control form-control-custom" value="Ashu">
                </div>
                <div class="mb-3">
                  <label class="form-label form-label-custom">Contact Email</label>
                  <input type="email" class="form-control form-control-custom" value="admin@talkwithashu.com">
                </div>
                <button type="submit" class="btn btn-brand px-4 py-2.5">Save Admin Info</button>
              </form>
            </div>

            <div class="card-premium border-0 bg-white shadow-sm p-4">
              <h5 class="fw-bold mb-4">Update Security Password</h5>
              <form onsubmit="event.preventDefault(); alert('Password updated successfully!')">
                <div class="mb-3">
                  <label class="form-label form-label-custom">Current Password</label>
                  <input type="password" class="form-control form-control-custom" placeholder="••••••••">
                </div>
                <div class="mb-3">
                  <label class="form-label form-label-custom">New Password</label>
                  <input type="password" class="form-control form-control-custom" placeholder="••••••••">
                </div>
                <button type="submit" class="btn btn-brand w-100 py-2.5">Update Password</button>
              </form>
            </div>
          </div>

          <!-- Right side: Platform config toggles -->
          <div class="col-lg-6">
            <div class="card-premium border-0 bg-white shadow-sm p-4 h-100">
              <h5 class="fw-bold mb-4">Voice Line configurations</h5>
              
              <form onsubmit="event.preventDefault(); alert('Line configurations updated successfully!')">
                <div class="mb-4">
                  <label class="form-label form-label-custom">Call Consumption Rates</label>
                  <div class="input-group">
                    <input type="number" class="form-control form-control-custom" value="1" style="max-width: 100px;">
                    <span class="input-group-text bg-white" style="border-radius: 0 10px 10px 0; border-color: rgba(24,32,51,0.1);">Coins per Minute</span>
                  </div>
                  <small class="text-muted">Calculates billing deductions dynamically.</small>
                </div>

                <div class="mb-4">
                  <label class="form-label form-label-custom">Payment Gateway Currency</label>
                  <select class="form-select form-control-custom" disabled>
                    <option selected>AED (د.إ) - UAE Dirham</option>
                  </select>
                  <small class="text-muted">Payment transactions are processed strictly in UAE Dirham (AED).</small>
                </div>

                <h6 class="fw-bold mb-3">System Features Toggles</h6>
                
                <!-- Video Calling Master Toggle (Ashu Control) -->
                <div class="card p-3 mb-3 border rounded-3 <%= typeof isVideoCallEnabled !== 'undefined' && isVideoCallEnabled ? 'border-success-subtle bg-success-subtle' : 'border-danger-subtle bg-danger-subtle' %> bg-opacity-25" id="videoToggleContainer">
                  <div class="d-flex align-items-center justify-content-between">
                    <div>
                      <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi <%= typeof isVideoCallEnabled !== 'undefined' && isVideoCallEnabled ? 'bi-camera-video-fill text-success' : 'bi-camera-video-off-fill text-danger' %> fs-5" id="videoToggleIcon"></i>
                        <strong class="text-dark">Video Calling Feature</strong>
                        <span class="badge <%= typeof isVideoCallEnabled !== 'undefined' && isVideoCallEnabled ? 'bg-success text-white' : 'bg-danger text-white' %> rounded-pill px-2.5 py-1" id="videoToggleBadge">
                          <%= typeof isVideoCallEnabled !== 'undefined' && isVideoCallEnabled ? 'Enabled (Active)' : 'Disabled (Voice Only)' %>
                        </span>
                      </div>
                      <small class="text-muted d-block" style="font-size: 0.82rem; line-height: 1.4;">
                        Allow users to start Video Calls. When disabled, video calling is blocked and hidden, while <strong>Audio Calling continues 100% smoothly and uninterrupted</strong>.
                      </small>
                    </div>
                    <div class="form-check form-switch ms-3 mb-0">
                      <input class="form-check-input" type="checkbox" id="videoCallToggle" style="width: 3rem; height: 1.6rem; cursor: pointer;" <%= (typeof isVideoCallEnabled === 'undefined' || isVideoCallEnabled) ? 'checked' : '' %>>
                    </div>
                  </div>
                  <div id="videoToggleFeedback" class="small mt-2 fw-semibold" style="display: none;"></div>
                </div>
                
                <div class="form-check form-switch mb-3">
                  <input class="form-check-input" type="checkbox" id="regToggle" checked>
                  <label class="form-check-label text-muted small" for="regToggle">Enable public registrations</label>
                </div>

                <div class="form-check form-switch mb-3">
                  <input class="form-check-input" type="checkbox" id="warningToggle" checked>
                  <label class="form-check-label text-muted small" for="warningToggle">Trigger automatic low coins notification banner</label>
                </div>

                <div class="form-check form-switch mb-4">
                  <input class="form-check-input" type="checkbox" id="lineToggle" checked>
                  <label class="form-check-label text-muted small" for="lineToggle">Mark voice companion lines as online/ready</label>
                </div>

                <button type="submit" class="btn btn-brand px-4 py-2.5 mt-3">Save Platform Config</button>
              </form>
            </div>
          </div>
        </div>
        </div>
      </main>
    </div>
  </div>

  <!-- Admin Mobile Bottom Navigation -->
  <%- include('../partials/admin-bottom-nav') %>

  <!-- Admin Incoming Call Notification Modal -->
  <%- include('../partials/admin-incoming-call') %>

  <%- include('../partials/scripts') %>

  <!-- Video Calling Feature Toggle Script for Admin Ashu -->
  <script>
    (function () {
      const toggle = document.getElementById('videoCallToggle');
      const badge = document.getElementById('videoToggleBadge');
      const icon = document.getElementById('videoToggleIcon');
      const container = document.getElementById('videoToggleContainer');
      const feedback = document.getElementById('videoToggleFeedback');

      if (!toggle) return;

      toggle.addEventListener('change', async function () {
        const isEnabled = this.checked;
        toggle.disabled = true;

        if (feedback) {
          feedback.style.display = 'block';
          feedback.className = 'small mt-2 text-muted';
          feedback.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Updating video calling setting...';
        }

        try {
          const response = await fetch('/admin/settings/toggle-video-call', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ enabled: isEnabled })
          });

          const data = await response.json();

          if (data && data.success) {
            const newState = data.isVideoCallEnabled;
            toggle.checked = newState;

            if (newState) {
              container.className = 'card p-3 mb-3 border rounded-3 border-success-subtle bg-success-subtle bg-opacity-25';
              badge.className = 'badge bg-success text-white rounded-pill px-2.5 py-1';
              badge.textContent = 'Enabled (Active)';
              icon.className = 'bi bi-camera-video-fill text-success fs-5';
              if (feedback) {
                feedback.className = 'small mt-2 text-success fw-semibold';
                feedback.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Video Calling ENABLED. Users can now make video calls.';
              }
            } else {
              container.className = 'card p-3 mb-3 border rounded-3 border-danger-subtle bg-danger-subtle bg-opacity-25';
              badge.className = 'badge bg-danger text-white rounded-pill px-2.5 py-1';
              badge.textContent = 'Disabled (Voice Only)';
              icon.className = 'bi bi-camera-video-off-fill text-danger fs-5';
              if (feedback) {
                feedback.className = 'small mt-2 text-danger fw-semibold';
                feedback.innerHTML = '<i class="bi bi-shield-check me-1"></i> Video Calling DISABLED. Audio calling is 100% active and smooth.';
              }
            }

            setTimeout(() => {
              if (feedback) feedback.style.display = 'none';
            }, 5000);
          } else {
            alert(data.message || 'Failed to update video calling setting.');
            toggle.checked = !isEnabled;
            if (feedback) feedback.style.display = 'none';
          }
        } catch (err) {
          console.error('[Video Toggle Error]', err);
          alert('Network error while toggling video calling feature.');
          toggle.checked = !isEnabled;
          if (feedback) feedback.style.display = 'none';
        } finally {
          toggle.disabled = false;
        }
      });
    })();
  </script>
</body>
</html>

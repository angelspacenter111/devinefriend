<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body class="bg-soft-gradient min-vh-100 d-flex align-items-center py-5 position-relative">
  <div class="backdrop-glow"></div>

  <div class="container position-relative z-3">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        
        <div class="text-center mb-4">
          <a class="navbar-brand d-inline-flex flex-column align-items-center mb-2" href="/">
            <img src="/images/logo.png" alt="Talk With Ashu Logo" class="brand-logo-img brand-logo-lg mb-2">
            <span class="brand-text text-uppercase fw-extrabold fs-3">Talk With Ashu</span>
          </a>
          <p class="text-muted small">Talk. Be Heard. Feel Lighter.</p>
        </div>

        <div class="card-premium border-0 bg-white shadow-lg p-4 p-md-5">
          <div class="text-center mb-4">
            <h3 class="fw-bold text-dark">Create New Password</h3>
            <p class="text-muted small">Enter and confirm a strong new password for your account.</p>
            <% if (typeof userEmail !== 'undefined' && userEmail) { %>
              <div class="mt-1">
                <span class="badge bg-light text-secondary border px-2.5 py-1.5 rounded-pill small">
                  <i class="bi bi-envelope-check me-1 text-primary-pink"></i> <%= userEmail %>
                </span>
              </div>
            <% } %>
          </div>

          <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div class="alert alert-danger mb-3 py-2.5 rounded-3 text-center small" role="alert">
              <i class="bi bi-exclamation-triangle-fill me-2"></i>
              <%= errorMessage %>
            </div>
          <% } %>

          <div id="client-error-alert" class="alert alert-danger mb-3 py-2.5 rounded-3 text-center small d-none" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <span id="client-error-text"></span>
          </div>

          <form action="/reset-password/<%= token %>" method="POST" class="auth-form-validate" id="reset-form">
            <!-- New Password -->
            <div class="mb-3">
              <label for="new-password" class="form-label form-label-custom">New Password</label>
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0 border-1" style="border-radius: 10px 0 0 10px; border-color: rgba(24,32,51,0.1);">
                  <i class="bi bi-lock text-muted"></i>
                </span>
                <input 
                  type="password" 
                  class="form-control form-control-custom border-start-0 border-end-0 ps-2" 
                  id="new-password" 
                  name="password" 
                  placeholder="At least 6 characters" 
                  minlength="6"
                  autocomplete="new-password"
                  autocapitalize="none"
                  autocorrect="off"
                  spellcheck="false"
                  required>
                <button type="button" class="input-group-text bg-white border-start-0 border-1 toggle-password-btn" data-target="new-password" style="border-radius: 0 10px 10px 0; border-color: rgba(24,32,51,0.1); cursor: pointer;">
                  <i class="bi bi-eye text-muted"></i>
                </button>
              </div>
            </div>

            <!-- Confirm Password -->
            <div class="mb-4">
              <label for="confirm-password" class="form-label form-label-custom">Confirm New Password</label>
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0 border-1" style="border-radius: 10px 0 0 10px; border-color: rgba(24,32,51,0.1);">
                  <i class="bi bi-shield-lock text-muted"></i>
                </span>
                <input 
                  type="password" 
                  class="form-control form-control-custom border-start-0 border-end-0 ps-2" 
                  id="confirm-password" 
                  name="confirmPassword" 
                  placeholder="Re-enter new password" 
                  minlength="6"
                  autocomplete="new-password"
                  autocapitalize="none"
                  autocorrect="off"
                  spellcheck="false"
                  required>
                <button type="button" class="input-group-text bg-white border-start-0 border-1 toggle-password-btn" data-target="confirm-password" style="border-radius: 0 10px 10px 0; border-color: rgba(24,32,51,0.1); cursor: pointer;">
                  <i class="bi bi-eye text-muted"></i>
                </button>
              </div>
            </div>

            <button type="submit" class="btn btn-brand w-100 py-3 mb-3" id="reset-submit-btn">
              <span class="spinner-border spinner-border-sm me-2 d-none" id="reset-spinner" role="status" aria-hidden="true"></span>
              <span id="reset-btn-text">Reset Password</span>
            </button>
          </form>

          <div class="text-center mt-3 small">
            <span class="text-muted">Remembered your password?</span>
            <a href="/login" class="text-primary-pink fw-semibold ms-1">Login</a>
          </div>
        </div>

        <div class="text-center mt-4">
          <a href="/" class="text-muted small"><i class="bi bi-arrow-left me-1"></i> Back to public home</a>
        </div>

      </div>
    </div>
  </div>

  <%- include('partials/scripts') %>

  <script>
    (function () {
      // Toggle password visibility
      document.querySelectorAll('.toggle-password-btn').forEach(btn => {
        btn.addEventListener('click', function () {
          const targetId = this.getAttribute('data-target');
          const targetInput = document.getElementById(targetId);
          const icon = this.querySelector('i');
          if (targetInput) {
            if (targetInput.type === 'password') {
              targetInput.type = 'text';
              icon.classList.remove('bi-eye');
              icon.classList.add('bi-eye-slash');
            } else {
              targetInput.type = 'password';
              icon.classList.remove('bi-eye-slash');
              icon.classList.add('bi-eye');
            }
          }
        });
      });

      const form = document.getElementById('reset-form');
      const pwd = document.getElementById('new-password');
      const confirmPwd = document.getElementById('confirm-password');
      const errorAlert = document.getElementById('client-error-alert');
      const errorText = document.getElementById('client-error-text');
      const submitBtn = document.getElementById('reset-submit-btn');
      const spinner = document.getElementById('reset-spinner');
      const btnText = document.getElementById('reset-btn-text');

      if (form) {
        form.addEventListener('submit', function (e) {
          const val1 = pwd.value.trim();
          const val2 = confirmPwd.value.trim();

          if (val1.length < 6) {
            e.preventDefault();
            errorText.textContent = 'Password must be at least 6 characters long.';
            errorAlert.classList.remove('d-none');
            pwd.focus();
            return;
          }

          if (val1 !== val2) {
            e.preventDefault();
            errorText.textContent = 'Passwords do not match. Please verify both fields.';
            errorAlert.classList.remove('d-none');
            confirmPwd.focus();
            return;
          }

          errorAlert.classList.add('d-none');
          submitBtn.disabled = true;
          if (spinner) spinner.classList.remove('d-none');
          if (btnText) btnText.textContent = 'Updating Password...';
        });
      }
    })();
  </script>
</body>
</html>

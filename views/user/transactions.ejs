<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body>

  <div class="panel-wrapper">
    <!-- User Sidebar Partial -->
    <%- include('../partials/user-sidebar') %>

    <!-- Main Content Panel -->
    <div class="content-panel">
      <!-- Top Header -->
      <header class="header-panel shadow-sm">
        <div class="d-flex align-items-center gap-3">
          <button class="btn btn-light d-lg-none sidebar-toggle-btn" type="button">
            <i class="bi bi-list fs-4"></i>
          </button>
          <h4 class="mb-0 fw-bold">Transactions</h4>
        </div>
        
        <div class="d-flex align-items-center gap-3">
          <div class="header-wallet-badge">
            <i class="bi bi-coin me-1"></i>
            <span class="fw-bold"><span class="simulated-balance"><%= user.credits %></span> Credits</span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <div class="rounded-circle bg-light-lavender d-flex align-items-center justify-content-center border" style="width: 38px; height: 38px;">
              <i class="bi bi-person text-purple"></i>
            </div>
            <span class="simulated-name fw-semibold text-dark d-none d-md-block"><%= user.name %></span>
          </div>
        </div>
      </header>

      <!-- Main Contents Canvas -->
      <main class="main-content-inner">
        <!-- Transaction Table Section -->
        <div class="card-premium border-0 bg-white shadow-sm p-4">
          <div class="d-flex align-items-center justify-content-between mb-4">
            <h5 class="fw-bold mb-0">Financial & Spend Ledger</h5>
            <span class="text-muted small">Updated in real-time</span>
          </div>

          <div class="table-responsive-custom">
            <table class="table table-premium mb-0 align-middle">
              <thead>
                <tr>
                  <th>Transaction ID</th>
                  <th>Date</th>
                  <th>Description</th>
                  <th>Type</th>
                  <th>Credits</th>
                  <th>Amount</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody id="transaction-history-table-body">
                <% if (transactions.length === 0) { %>
                  <tr>
                    <td colspan="7" class="text-center text-muted py-4">No transactions found.</td>
                  </tr>
                <% } else { %>
                  <% transactions.forEach(txn => { %>
                    <%
                      const typeBadge = txn.type === "credit" 
                        ? `<span class="badge bg-success-subtle text-success"><i class="bi bi-arrow-down-left me-1"></i> Recharge</span>`
                        : `<span class="badge bg-danger-subtle text-danger"><i class="bi bi-arrow-up-right me-1"></i> Call Spend</span>`;
                      
                      const creditFormatted = txn.type === "credit"
                        ? `<span class="text-success fw-bold">+${txn.credits} Credits</span>`
                        : `<span class="text-danger fw-bold">-${txn.credits} Credits</span>`;
                    %>
                    <tr>
                      <td><span class="fw-semibold"><%= txn.txnId %></span></td>
                      <td><%= txn.date ? txn.date.toISOString().split('T')[0] : '' %></td>
                      <td><%= txn.desc %></td>
                      <td><%- typeBadge %></td>
                      <td><%- creditFormatted %></td>
                      <td><span class="fw-bold"><%= txn.amount %></span></td>
                      <td><span class="badge bg-success-subtle text-success rounded-pill px-2 py-1"><%= txn.status %></span></td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="app-mode">

  <!-- Mobile-First App Top Bar -->
  <%- include('../partials/app-header', { pageTitle: 'Transactions', showBack: true, backUrl: '/user/wallet' }) %>

  <div class="panel-wrapper">
    <!-- Desktop Left Sidebar -->
    <%- include('../partials/user-sidebar') %>

    <!-- Main Content Panel -->
    <div class="content-panel">
      <!-- Desktop Header Panel -->
      <header class="header-panel shadow-sm d-none d-lg-flex">
        <div class="d-flex align-items-center gap-3">
          <h4 class="mb-0 fw-bold">Transactions</h4>
        </div>
        
        <div class="d-flex align-items-center gap-3">
          <div class="header-wallet-badge">
            <i class="bi bi-coin me-1"></i>
            <span class="fw-bold"><span class="simulated-balance"><%= user.credits %></span> Credits</span>
          </div>
          <a href="/user/profile" class="btn btn-light d-flex align-items-center gap-2 border rounded-pill py-1 px-3">
            <div class="rounded-circle bg-light-lavender d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
              <i class="bi bi-person text-purple"></i>
            </div>
            <span class="simulated-name fw-semibold text-dark small"><%= user.name %></span>
          </a>
          <a href="/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 d-flex align-items-center gap-1.5 fw-semibold" title="Logout">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
          </a>
        </div>
      </header>

      <!-- Main Contents Canvas -->
      <main class="main-content-inner">
        <div class="app-container">

          <!-- Balance Overview Summary -->
          <div class="app-card bg-light border-0 p-3.5 mb-4 d-flex align-items-center justify-content-between">
            <div>
              <span class="text-muted small d-block">Available Account Balance</span>
              <h3 class="fw-extrabold text-primary mb-0"><span class="simulated-balance"><%= user.credits %></span> Credits</h3>
            </div>
            <a href="/user/buy-credits" class="btn btn-brand rounded-pill px-3.5 py-2 small fw-semibold app-tap-active">
              <i class="bi bi-plus-circle me-1"></i> Top Up
            </a>
          </div>

          <!-- Transaction List / Feed -->
          <div class="app-card p-0 overflow-hidden mb-4">
            <div class="p-3.5 px-4 d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3 border-bottom bg-white">
              <div>
                <h5 class="fw-bold mb-0 text-dark">Financial Ledger</h5>
                <small class="text-muted">Total <%= typeof totalTransactions !== 'undefined' ? totalTransactions : transactions.length %> entries</small>
              </div>

              <!-- Filter Form: Search, Type, Date -->
              <form method="GET" action="/user/transactions" class="row g-2 align-items-center w-100 mt-1 mt-lg-0" style="max-width: 650px;">
                <div class="col-12 col-sm-4">
                  <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="q" class="form-control form-control-custom border-start-0" placeholder="Txn ID or note..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
                  </div>
                </div>

                <div class="col-6 col-sm-3">
                  <select name="type" class="form-select form-control-custom form-select-sm" onchange="this.form.submit()">
                    <option value="all" <%= (typeof selectedType !== 'undefined' && selectedType === 'all') ? 'selected' : '' %>>All Types</option>
                    <option value="credit" <%= (typeof selectedType !== 'undefined' && selectedType === 'credit') ? 'selected' : '' %>>Recharges (+)</option>
                    <option value="debit" <%= (typeof selectedType !== 'undefined' && selectedType === 'debit') ? 'selected' : '' %>>Call Spend (-)</option>
                  </select>
                </div>

                <div class="col-6 col-sm-3">
                  <input type="date" name="date" class="form-control form-control-custom form-control-sm" title="Filter by date" value="<%= typeof selectedDate !== 'undefined' ? selectedDate : '' %>">
                </div>

                <div class="col-12 col-sm-2 d-flex gap-1.5">
                  <button type="submit" class="btn btn-sm btn-brand px-2 flex-grow-1"><i class="bi bi-funnel-fill me-1"></i> Filter</button>
                  <% if ((typeof searchQuery !== 'undefined' && searchQuery) || (typeof selectedType !== 'undefined' && selectedType !== 'all') || (typeof selectedDate !== 'undefined' && selectedDate)) { %>
                    <a href="/user/transactions" class="btn btn-sm btn-outline-secondary px-2" title="Reset Filters"><i class="bi bi-arrow-clockwise"></i></a>
                  <% } %>
                </div>
              </form>
            </div>

            <% if (transactions.length === 0) { %>
              <div class="text-center py-5 px-3 bg-light rounded-4 border border-dashed m-3">
                <div class="rounded-circle bg-white shadow-xs d-inline-flex align-items-center justify-content-center p-3 mb-2 text-muted">
                  <i class="bi bi-receipt fs-2 text-muted"></i>
                </div>
                <h6 class="fw-bold text-dark mb-1">No Transactions Found</h6>
                <p class="text-muted small mb-3">No financial records match your filter criteria.</p>
                <a href="/user/transactions" class="btn btn-sm btn-outline-brand rounded-pill px-3">
                  <i class="bi bi-arrow-clockwise me-1"></i> Clear Filters
                </a>
              </div>
            <% } else { %>
              
              <!-- Mobile Feed List View -->
              <div class="app-list-group border-0 rounded-0 d-md-none">
                <% transactions.forEach(txn => { %>
                  <%
                    const isCredit = txn.type === "credit";
                    const iconBg = isCredit ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger";
                    const iconName = isCredit ? "bi-arrow-down-left" : "bi-arrow-up-right";
                  %>
                  <div class="app-list-item">
                    <div class="d-flex align-items-center">
                      <div class="app-list-icon <%= iconBg %>">
                        <i class="bi <%= iconName %>"></i>
                      </div>
                      <div>
                        <strong class="d-block text-dark small"><%= txn.desc %></strong>
                        <small class="text-muted">
                          <%= txn.date ? txn.date.toISOString().split('T')[0] : '' %> • Ref: <%= txn.txnId %>
                        </small>
                      </div>
                    </div>
                    <div class="text-end">
                      <span class="d-block fw-bold <%= isCredit ? 'text-success' : 'text-danger' %>">
                        <%= isCredit ? '+' : '-' %><%= txn.credits %> cr
                      </span>
                      <small class="text-muted"><%= txn.amount %></small>
                    </div>
                  </div>
                <% }) %>
              </div>

              <!-- Desktop Table View -->
              <div class="table-responsive-custom d-none d-md-block">
                <table class="table table-premium mb-0 align-middle">
                  <thead>
                    <tr>
                      <th>Transaction ID</th>
                      <th>Date</th>
                      <th>Description</th>
                      <th>Type</th>
                      <th>Credits</th>
                      <th>Balance</th>
                      <th>Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% transactions.forEach(txn => { %>
                      <%
                        const isCredit = txn.type === "credit" || txn.type === "CREDIT";
                        const typeBadge = isCredit 
                          ? `<span class="badge bg-success-subtle text-success"><i class="bi bi-arrow-down-left me-1"></i> Recharge</span>`
                          : `<span class="badge bg-danger-subtle text-danger"><i class="bi bi-arrow-up-right me-1"></i> Call Spend</span>`;
                        
                        const creditFormatted = isCredit
                          ? `<span class="text-success fw-bold">+${txn.credits} Credits</span>`
                          : `<span class="text-danger fw-bold">-${txn.credits} Credits</span>`;
                      %>
                      <tr>
                        <td><span class="fw-semibold text-dark font-monospace small"><%= txn.txnId %></span></td>
                        <td><%= txn.date ? txn.date.toISOString().split('T')[0] : '' %></td>
                        <td>
                          <%= txn.desc %>
                          <% if (txn.referenceId) { %>
                            <small class="text-muted d-block font-monospace">Ref: <%= txn.referenceId %></small>
                          <% } %>
                        </td>
                        <td><%- typeBadge %></td>
                        <td><%- creditFormatted %></td>
                        <td>
                          <% if (txn.balanceAfter != null) { %>
                            <span class="fw-bold text-dark"><%= txn.balanceAfter %> cr</span>
                          <% } else { %>
                            <span class="text-muted small">—</span>
                          <% } %>
                        </td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1"><%= txn.status %></span></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>

            <!-- Pagination Partial -->
            <div class="px-3 pb-3">
              <%- include('../partials/pagination', {
                currentPage: typeof currentPage !== 'undefined' ? currentPage : 1,
                totalPages: typeof totalPages !== 'undefined' ? totalPages : 1,
                totalRecords: typeof totalTransactions !== 'undefined' ? totalTransactions : transactions.length,
                baseUrl: '/user/transactions',
                queryParams: typeof queryParams !== 'undefined' ? queryParams : ''
              }) %>
            </div>
          </div>

          <!-- Razorpay Payment History Card -->
          <div class="app-card p-0 overflow-hidden mb-4">
            <div class="p-3.5 px-4 d-flex align-items-center justify-content-between border-bottom bg-white">
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-credit-card text-primary fs-5"></i>
                <h5 class="fw-bold mb-0 text-dark">Razorpay Payment History</h5>
              </div>
              <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 small">Test / Live Orders</span>
            </div>

            <% if (!payments || payments.length === 0) { %>
              <div class="text-center py-5 px-3">
                <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                  <i class="bi bi-wallet-fill text-muted fs-4"></i>
                </div>
                <h6 class="fw-bold text-dark mb-1">No Razorpay Payments Yet</h6>
                <p class="text-muted small mb-0">Completed online payment records will be logged here.</p>
              </div>
            <% } else { %>
              
              <!-- Mobile Feed List View -->
              <div class="app-list-group border-0 rounded-0 d-md-none">
                <% payments.forEach(p => { %>
                  <%
                    const isSuccess = p.status === 'CAPTURED';
                    const statusBadgeClass = isSuccess ? 'bg-success-subtle text-success' : (p.status === 'FAILED' ? 'bg-danger-subtle text-danger' : 'bg-warning-subtle text-warning');
                  %>
                  <div class="app-list-item">
                    <div class="d-flex align-items-center">
                      <div class="app-list-icon <%= isSuccess ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning' %>">
                        <i class="bi bi-credit-card-2-front"></i>
                      </div>
                      <div>
                        <strong class="d-block text-dark small"><%= p.packageName %> (<%= p.credits %> Credits)</strong>
                        <small class="text-muted font-monospace d-block" style="font-size: 0.72rem;">
                          Order: <%= p.razorpayOrderId %>
                        </small>
                        <% if (p.razorpayPaymentId) { %>
                          <small class="text-muted font-monospace d-block" style="font-size: 0.72rem;">
                            Pay ID: <%= p.razorpayPaymentId %>
                          </small>
                        <% } %>
                        <small class="text-muted" style="font-size: 0.72rem;">
                          <%= p.createdAt ? p.createdAt.toISOString().split('T')[0] : '' %>
                        </small>
                      </div>
                    </div>
                    <div class="text-end">
                      <span class="d-block fw-bold text-dark">₹<%= p.amount.toLocaleString('en-IN') %></span>
                      <span class="badge <%= statusBadgeClass %> rounded-pill px-2 py-0.5 small" style="font-size: 0.68rem;">
                        <%= p.status %>
                      </span>
                    </div>
                  </div>
                <% }) %>
              </div>

              <!-- Desktop Table View -->
              <div class="table-responsive-custom d-none d-md-block">
                <table class="table table-premium mb-0 align-middle">
                  <thead>
                    <tr>
                      <th>Date</th>
                      <th>Package</th>
                      <th>Credits</th>
                      <th>Amount</th>
                      <th>Razorpay Order ID</th>
                      <th>Razorpay Payment ID</th>
                      <th>Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% payments.forEach(p => { %>
                      <%
                        const isSuccess = p.status === 'CAPTURED';
                        const statusBadgeClass = isSuccess ? 'bg-success-subtle text-success' : (p.status === 'FAILED' ? 'bg-danger-subtle text-danger' : 'bg-warning-subtle text-warning');
                      %>
                      <tr>
                        <td><%= p.createdAt ? p.createdAt.toISOString().split('T')[0] : '' %></td>
                        <td><span class="fw-bold text-dark"><%= p.packageName %></span></td>
                        <td><span class="text-purple fw-bold">+<%= p.credits %> cr</span></td>
                        <td><span class="fw-bold text-dark">₹<%= p.amount.toLocaleString('en-IN') %></span></td>
                        <td><span class="font-monospace small text-muted"><%= p.razorpayOrderId %></span></td>
                        <td>
                          <% if (p.razorpayPaymentId) { %>
                            <span class="font-monospace small text-dark"><%= p.razorpayPaymentId %></span>
                          <% } else { %>
                            <span class="text-muted small">—</span>
                          <% } %>
                        </td>
                        <td>
                          <span class="badge <%= statusBadgeClass %> rounded-pill px-2.5 py-1">
                            <%= p.status %>
                          </span>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>

        </div>
      </main>
    </div>
  </div>

  <!-- Mobile Bottom Navigation Bar -->
  <%- include('../partials/app-bottom-nav') %>

  <!-- Shared JavaScript Scripts -->
  <%- include('../partials/scripts') %>
</body>
</html>

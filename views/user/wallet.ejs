<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="app-mode">

  <!-- Mobile-First App Top Bar -->
  <%- include('../partials/app-header', { pageTitle: 'My Wallet', showBack: true, backUrl: '/user/dashboard' }) %>

  <div class="panel-wrapper">
    <!-- Desktop Left Sidebar -->
    <%- include('../partials/user-sidebar') %>

    <!-- Main Content Panel -->
    <div class="content-panel">
      <!-- Desktop Header Panel -->
      <header class="header-panel shadow-sm d-none d-lg-flex">
        <div class="d-flex align-items-center gap-3">
          <h4 class="mb-0 fw-bold">My Wallet</h4>
        </div>
        
        <div class="d-flex align-items-center gap-3">
          <div class="header-wallet-badge">
            <i class="bi bi-coin me-1"></i>
            <span class="fw-bold"><span class="simulated-balance"><%= user.credits %></span> Points</span>
          </div>
          <a href="/user/profile" class="btn btn-light d-flex align-items-center gap-2 border rounded-pill py-1 px-3">
            <div class="rounded-circle bg-light-lavender d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
              <i class="bi bi-person text-purple"></i>
            </div>
            <span class="simulated-name fw-semibold text-dark small"><%= user.name %></span>
          </a>
          <a href="/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 d-flex align-items-center gap-1.5 fw-semibold" title="Logout">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
          </a>
        </div>
      </header>

      <!-- Main Contents Canvas -->
      <main class="main-content-inner">
        <div class="app-container">

          <!-- 1. Apple Wallet Style Balance Card -->
          <div class="apple-wallet-card shadow-lg mb-4">
            <div class="d-flex align-items-center justify-content-between mb-4">
              <div>
                <span class="badge rounded-pill px-3 py-1.5 small text-white" style="background: rgba(255, 255, 255, 0.22); backdrop-filter: blur(10px);">
                  <i class="bi bi-shield-check me-1"></i> Available Balance
                </span>
              </div>
              <i class="bi bi-wallet2 fs-2 text-white-50"></i>
            </div>

            <div class="mb-4">
              <span class="text-white-50 small d-block mb-1">Total Talk Time Available</span>
              <div class="d-flex align-items-baseline gap-2">
                <h1 class="display-4 fw-extrabold text-white mb-0"><span class="simulated-balance"><%= user.credits %></span></h1>
                <span class="fs-4 text-white-50 fw-semibold">Points</span>
              </div>
              <small class="text-white-50 mt-1 d-block">
                Corresponds to <span class="simulated-balance fw-bold text-white"><%= user.credits %></span> minutes of private voice consultation to Talk With Ashu.
              </small>
            </div>

            <div class="d-flex flex-wrap gap-2 pt-3 border-top border-white-10">
              <a href="/user/buy-credits" class="btn btn-light rounded-pill px-4 py-2.5 fw-bold text-primary app-tap-active shadow-sm">
                <i class="bi bi-plus-circle-fill me-1.5"></i> Add Points Now
              </a>
              <a href="/user/call" class="btn btn-outline-light rounded-pill px-4 py-2.5 fw-semibold app-tap-active">
                <i class="bi bi-telephone-fill me-1.5"></i> Talk With Ashu
              </a>
            </div>
          </div>

          <!-- 2. Usage Statistics Grid -->
          <div class="row g-3 mb-4">
            <div class="col-sm-6">
              <div class="app-card mb-0 h-100">
                <div class="d-flex align-items-center gap-3">
                  <div class="rounded-3 bg-success-subtle text-success p-3 fs-4">
                    <i class="bi bi-arrow-down-left-circle-fill"></i>
                  </div>
                  <div>
                    <span class="text-muted small d-block">Total Points Loaded</span>
                    <h4 class="fw-bold text-dark mb-0"><%= totalPurchased %> pts</h4>
                    <small class="text-muted"><%= totalPurchased %> Total Minutes</small>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-sm-6">
              <div class="app-card mb-0 h-100">
                <div class="d-flex align-items-center gap-3">
                  <div class="rounded-3 bg-danger-subtle text-danger p-3 fs-4">
                    <i class="bi bi-arrow-up-right-circle-fill"></i>
                  </div>
                  <div>
                    <span class="text-muted small d-block">Total Points Used</span>
                    <h4 class="fw-bold text-dark mb-0"><%= totalUsed %> pts</h4>
                    <small class="text-muted"><%= totalUsed %> Minutes Talked</small>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- 3. How Points Work (Replaces transactions table for privacy & simplicity) -->
          <div class="app-card p-4 mb-4">
            <h5 class="fw-bold text-dark mb-3">
              <i class="bi bi-info-circle-fill text-primary me-2"></i> How Your Points Work
            </h5>
            <div class="row g-3">
              <div class="col-md-4">
                <div class="p-3 bg-light rounded-4 h-100">
                  <div class="text-primary fs-3 mb-2"><i class="bi bi-clock-history"></i></div>
                  <h6 class="fw-bold text-dark mb-1">1 Point = 1 Minute</h6>
                  <p class="text-muted small mb-0">Every 1 point provides 1 full minute of high-definition private audio time to Talk With Ashu.</p>
                </div>
              </div>
              <div class="col-md-4">
                <div class="p-3 bg-light rounded-4 h-100">
                  <div class="text-success fs-3 mb-2"><i class="bi bi-shield-lock-fill"></i></div>
                  <h6 class="fw-bold text-dark mb-1">Zero Hidden Deductions</h6>
                  <p class="text-muted small mb-0">Points are only deducted during an active, connected conversation. Unanswered or cancelled calls cost 0 points.</p>
                </div>
              </div>
              <div class="col-md-4">
                <div class="p-3 bg-light rounded-4 h-100">
                  <div class="text-purple fs-3 mb-2"><i class="bi bi-infinity"></i></div>
                  <h6 class="fw-bold text-dark mb-1">Points Never Expire</h6>
                  <p class="text-muted small mb-0">Your pre-loaded points remain securely stored in your wallet and can be used whenever you need guidance.</p>
                </div>
              </div>
            </div>

            <div class="mt-4 pt-3 border-top text-center text-sm-start d-sm-flex align-items-center justify-content-between">
              <span class="text-muted small mb-2 mb-sm-0 d-block">Need more guidance time to Talk With Ashu?</span>
              <a href="/user/buy-credits" class="btn btn-brand rounded-pill px-4 py-2 small fw-semibold app-tap-active">
                <i class="bi bi-lightning-charge-fill me-1"></i> Top Up Points
              </a>
            </div>
          </div>

        </div>
      </main>
    </div>
  </div>

  <!-- Mobile Bottom Navigation Bar -->
  <%- include('../partials/app-bottom-nav') %>

  <!-- Shared JavaScript Scripts -->
  <%- include('../partials/scripts') %>
</body>
</html>

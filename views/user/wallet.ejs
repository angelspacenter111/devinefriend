<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body>

  <div class="panel-wrapper">
    <!-- User Sidebar Partial -->
    <%- include('../partials/user-sidebar') %>

    <!-- Main Content Panel -->
    <div class="content-panel">
      <!-- Top Header -->
      <header class="header-panel shadow-sm">
        <div class="d-flex align-items-center gap-3">
          <button class="btn btn-light d-lg-none sidebar-toggle-btn" type="button">
            <i class="bi bi-list fs-4"></i>
          </button>
          <h4 class="mb-0 fw-bold">My Wallet</h4>
        </div>
        
        <div class="d-flex align-items-center gap-3">
          <div class="header-wallet-badge">
            <i class="bi bi-coin me-1"></i>
            <span class="fw-bold"><span class="simulated-balance"><%= user.credits %></span> Credits</span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <div class="rounded-circle bg-light-lavender d-flex align-items-center justify-content-center border" style="width: 38px; height: 38px;">
              <i class="bi bi-person text-purple"></i>
            </div>
            <span class="simulated-name fw-semibold text-dark d-none d-md-block"><%= user.name %></span>
          </div>
        </div>
      </header>

      <!-- Main Contents Canvas -->
      <main class="main-content-inner">
        <!-- Balance Overview Card -->
        <div class="row g-4 mb-4">
          <div class="col-lg-7">
            <div class="card-hero-premium p-4 p-md-5 bg-soft-gradient h-100 d-flex flex-column justify-content-between position-relative overflow-hidden">
              <div class="backdrop-glow"></div>
              <div class="position-relative z-3">
                <span class="text-muted d-block small mb-1">Available Credits Balance</span>
                <div class="d-flex align-items-baseline gap-2 mb-3">
                  <span class="display-3 fw-extrabold text-primary-blue"><span class="simulated-balance"><%= user.credits %></span></span>
                  <span class="fs-4 fw-bold text-dark">Credits</span>
                </div>
                <p class="text-muted small max-width-500 mb-0">
                  This corresponds to approximately <span class="simulated-balance fw-bold text-dark"><%= user.credits %></span> minutes of direct conversation time. Credits are deducted continuously per second during a live voice call.
                </p>
              </div>

              <div class="d-flex flex-column flex-sm-row gap-3 mt-4 pt-3 position-relative z-3">
                <a href="/user/buy-credits" class="btn btn-brand px-4 py-2.5"><i class="bi bi-plus-circle-fill me-1"></i> Top Up Balance</a>
                <a href="/user/transactions" class="btn btn-outline-brand px-4 py-2.5">Transaction Ledger</a>
              </div>
            </div>
          </div>

          <!-- Quick statistics overview -->
          <div class="col-lg-5">
            <div class="card-premium h-100 border-0 bg-white shadow-sm p-4 d-flex flex-column justify-content-between">
              <h5 class="fw-bold mb-4">Account Circulation</h5>
              
              <div class="d-grid gap-3">
                <div class="d-flex align-items-center justify-content-between p-3 rounded-3 bg-light">
                  <span class="text-muted small"><i class="bi bi-arrow-down-left-circle text-success me-2"></i> Total Purchased</span>
                  <span class="fw-bold text-dark"><%= totalPurchased %> Credits</span>
                </div>

                <div class="d-flex align-items-center justify-content-between p-3 rounded-3 bg-light">
                  <span class="text-muted small"><i class="bi bi-arrow-up-right-circle text-danger me-2"></i> Total Used (Calls)</span>
                  <span class="fw-bold text-dark"><%= totalUsed %> Credits</span>
                </div>

                <div class="d-flex align-items-center justify-content-between p-3 rounded-3 bg-light">
                  <span class="text-muted small"><i class="bi bi-coin text-purple me-2"></i> Current Minutes Value</span>
                  <span class="fw-bold text-dark"><span class="simulated-balance"><%= user.credits %></span> Minutes</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Transactions History Table -->
        <div class="card-premium border-0 bg-white shadow-sm p-4">
          <div class="d-flex align-items-center justify-content-between mb-4">
            <h5 class="fw-bold mb-0">Recent Wallet Transactions</h5>
            <a href="/user/transactions" class="link-primary small fw-semibold text-decoration-underline">View All Transactions</a>
          </div>

          <div class="table-responsive-custom">
            <table class="table table-premium mb-0 align-middle">
              <thead>
                <tr>
                  <th>Transaction ID</th>
                  <th>Date</th>
                  <th>Description</th>
                  <th>Type</th>
                  <th>Credits</th>
                  <th>Amount</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody id="transaction-history-table-body">
                <% if (transactions.length === 0) { %>
                  <tr>
                    <td colspan="7" class="text-center text-muted py-4">No transactions found.</td>
                  </tr>
                <% } else { %>
                  <% transactions.forEach(txn => { %>
                    <%
                      const typeBadge = txn.type === "credit" 
                        ? `<span class="badge bg-success-subtle text-success"><i class="bi bi-arrow-down-left me-1"></i> Recharge</span>`
                        : `<span class="badge bg-danger-subtle text-danger"><i class="bi bi-arrow-up-right me-1"></i> Call Spend</span>`;
                      
                      const creditFormatted = txn.type === "credit"
                        ? `<span class="text-success fw-bold">+${txn.credits} Credits</span>`
                        : `<span class="text-danger fw-bold">-${txn.credits} Credits</span>`;
                    %>
                    <tr>
                      <td><span class="fw-semibold"><%= txn.txnId %></span></td>
                      <td><%= txn.date ? txn.date.toISOString().split('T')[0] : '' %></td>
                      <td><%= txn.desc %></td>
                      <td><%- typeBadge %></td>
                      <td><%- creditFormatted %></td>
                      <td><span class="fw-bold"><%= txn.amount %></span></td>
                      <td><span class="badge bg-success-subtle text-success rounded-pill px-2 py-1"><%= txn.status %></span></td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>

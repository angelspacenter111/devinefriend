<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="app-mode">

  <!-- Mobile-First App Top Bar -->
  <%- include('../partials/app-header', { pageTitle: 'Home', showBack: false }) %>

  <div class="panel-wrapper">
    <!-- Desktop Left Sidebar -->
    <%- include('../partials/user-sidebar') %>

    <!-- Main Content Panel -->
    <div class="content-panel">
      <!-- Desktop Header Panel (Visible on Desktop) -->
      <header class="header-panel shadow-sm d-none d-lg-flex">
        <div class="d-flex align-items-center gap-3">
          <h4 class="mb-0 fw-bold text-dark">Life Advisor Dashboard</h4>
        </div>
        
        <div class="d-flex align-items-center gap-3">
          <div class="header-advisor-badge d-flex align-items-center gap-2 px-3 py-1.5 rounded-pill" title="Live Life Advisor Status">
            <span class="status-indicator-dot <%= typeof isAdvisorOnline !== 'undefined' && isAdvisorOnline ? 'online' : 'offline' %>"></span>
            <span class="small fw-semibold text-muted">Life Advisor:</span>
            <span class="small fw-bold advisor-status-text <%= typeof isAdvisorOnline !== 'undefined' && isAdvisorOnline ? 'text-success' : 'text-secondary' %>">
              <%= typeof isAdvisorOnline !== 'undefined' && isAdvisorOnline ? 'Online Now' : 'Currently Offline' %>
            </span>
          </div>

          <div class="header-wallet-badge">
            <i class="bi bi-coin me-1"></i>
            <span class="fw-bold"><span class="simulated-balance"><%= user.credits %></span> Credits</span>
            <span class="text-muted small ms-1">(≈ <span class="simulated-balance"><%= user.credits %></span> mins)</span>
          </div>

          <a href="/user/profile" class="btn btn-light d-flex align-items-center gap-2 border rounded-pill py-1 px-3">
            <div class="rounded-circle bg-light-lavender d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
              <i class="bi bi-person text-purple"></i>
            </div>
            <span class="simulated-name fw-semibold text-dark small"><%= user.name %></span>
          </a>

          <a href="/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 d-flex align-items-center gap-1.5 fw-semibold" title="Logout">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
          </a>
        </div>
      </header>

      <!-- Main Contents Canvas -->
      <main class="main-content-inner">
        <div class="app-container">

          <!-- 1. Warm Greeting & Guidance Subtitle -->
          <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
              <span class="text-muted small fw-semibold text-uppercase letter-spacing-1">Personal Guidance Space</span>
              <h2 class="fw-extrabold text-dark mb-0">Welcome, <%= user.name %> ✨</h2>
              <p class="text-muted small mb-0 mt-1">Take a deep breath. Speak freely with your personal Life Advisor.</p>
            </div>
            <div class="d-none d-sm-block">
              <span class="badge bg-white text-muted border px-3 py-2 rounded-pill small shadow-sm">
                <i class="bi bi-shield-lock-fill text-success me-1"></i> 100% Confidential • 1-on-1 Audio
              </span>
            </div>
          </div>

          <!-- 2. Classic Life Advisor Hero Card -->
          <div class="life-advisor-hero-card">
            <div class="row align-items-center g-4 position-relative z-3">
              <div class="col-lg-8">
                <!-- Status Pill -->
                <div class="d-flex align-items-center gap-2 mb-3">
                  <span class="advisor-status-glow-pill <%= typeof isAdvisorOnline !== 'undefined' && isAdvisorOnline ? 'online' : 'offline' %> advisor-status-badge" id="dash-advisor-status-badge">
                    <span class="status-indicator-dot <%= typeof isAdvisorOnline !== 'undefined' && isAdvisorOnline ? 'online' : 'offline' %>"></span>
                    <span class="advisor-status-text full-text"><%= typeof isAdvisorOnline !== 'undefined' && isAdvisorOnline ? 'Life Advisor Online Now' : 'Life Advisor Offline' %></span>
                  </span>
                  <span class="badge rounded-pill px-3 py-1.5 small text-white-50" style="background: rgba(255, 255, 255, 0.08);">
                    <i class="bi bi-patch-check-fill text-warning me-1"></i> Certified Guidance
                  </span>
                </div>

                <h3 class="display-6 fw-extrabold text-white mb-2" style="letter-spacing: -0.5px;">Speak With Your Life Advisor</h3>
                <p class="text-white-50 small mb-4" style="max-width: 520px; line-height: 1.7; font-size: 0.95rem;">
                  Navigating relationship crossroads, heavy thoughts, career pressure, or personal dilemmas? Connect 1-on-1 with an experienced Life Advisor for clarity, compassion, and direction.
                </p>

                <!-- Sound Wave & Available Talk Time Bar -->
                <div class="d-flex align-items-center gap-3">
                  <div class="soundwave-visualizer">
                    <span class="soundwave-bar"></span>
                    <span class="soundwave-bar"></span>
                    <span class="soundwave-bar"></span>
                    <span class="soundwave-bar"></span>
                    <span class="soundwave-bar"></span>
                    <span class="soundwave-bar"></span>
                  </div>
                  <span class="text-white-50 small">
                    Available Time: <strong class="text-white"><span class="simulated-balance"><%= user.credits %></span> minutes</strong>
                  </span>
                </div>
              </div>

              <div class="col-lg-4 text-center text-lg-end" id="dash-call-btn-container">
                <% if (user.credits >= 1) { %>
                  <a href="/user/call" class="btn btn-brand btn-lg rounded-pill px-4 py-3.5 shadow-lg w-100 app-tap-active btn-start-call <%= typeof isAdvisorOnline !== 'undefined' && isAdvisorOnline ? '' : 'btn-advisor-offline' %>" id="dash-start-call-btn" style="font-size: 1.1rem;">
                    <i class="bi bi-telephone-fill me-2"></i> Call Life Advisor
                  </a>
                <% } else { %>
                  <a href="/user/buy-credits?lowCredits=true" class="btn btn-warning btn-lg rounded-pill px-4 py-3.5 shadow-lg w-100 app-tap-active" title="Recharge required to talk" style="font-size: 1.1rem;">
                    <i class="bi bi-coin me-2"></i> Add Credits to Call
                  </a>
                <% } %>
                <small class="text-white-50 d-block mt-2 text-center text-lg-end" style="font-size: 0.75rem;">
                  1 Credit = 1 Minute • Pure Audio Privacy
                </small>
              </div>
            </div>
          </div>

          <!-- 3. What's On Your Mind Today? (Curated Life Topics) -->
          <div class="mb-4">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <span class="text-dark fw-bold small">Choose what you wish to discuss:</span>
              <small class="text-muted">Tap to focus</small>
            </div>
            <div class="topic-scroll-row">
              <button class="topic-chip app-tap-active active" type="button">
                <span>🧭 Life Direction & Career</span>
              </button>
              <button class="topic-chip app-tap-active" type="button">
                <span>💔 Relationship Advice</span>
              </button>
              <button class="topic-chip app-tap-active" type="button">
                <span>😰 Stress & Overthinking</span>
              </button>
              <button class="topic-chip app-tap-active" type="button">
                <span>💭 Late Night Thoughts</span>
              </button>
              <button class="topic-chip app-tap-active" type="button">
                <span>☕ Just Need Someone to Listen</span>
              </button>
              <button class="topic-chip app-tap-active" type="button">
                <span>🌱 Emotional Healing</span>
              </button>
            </div>
          </div>

          <!-- 4. Wallet & Usage Quick Stats Cards -->
          <div class="row g-3 g-md-4 mb-4">
            <div class="col-sm-6">
              <div class="app-card mb-0 h-100 d-flex flex-column justify-content-between">
                <div>
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Talk Time Balance</span>
                    <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-1 small">Instant Call</span>
                  </div>
                  <div class="d-flex align-items-baseline gap-2">
                    <h2 class="display-6 fw-extrabold text-primary mb-0"><span class="simulated-balance"><%= user.credits %></span></h2>
                    <span class="text-muted fw-semibold">Credits</span>
                  </div>
                  <p class="text-muted small mt-2 mb-0">
                    Allows approximately <strong><span class="simulated-balance"><%= user.credits %></span> minutes</strong> of live voice conversation with your Life Advisor.
                  </p>
                </div>
                <div class="mt-3 pt-3 border-top">
                  <a href="/user/buy-credits" class="btn btn-outline-brand btn-sm rounded-pill w-100 py-2.5 fw-semibold app-tap-active">
                    <i class="bi bi-plus-circle-fill me-1"></i> Quick Recharge Balance
                  </a>
                </div>
              </div>
            </div>

            <div class="col-sm-6">
              <div class="app-card mb-0 h-100 d-flex flex-column justify-content-between">
                <div>
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Your Consultation History</span>
                    <i class="bi bi-clock-history text-purple fs-5"></i>
                  </div>
                  <div class="d-flex align-items-baseline gap-2">
                    <h2 class="display-6 fw-extrabold text-purple mb-0"><%= totalMins %></h2>
                    <span class="text-muted fw-semibold">Minutes Talked</span>
                  </div>
                  <div class="d-flex align-items-center gap-3 mt-2 text-muted small">
                    <span><i class="bi bi-telephone-outbound me-1 text-primary"></i> <%= totalCalls %> Consultations</span>
                    <span><i class="bi bi-shield-check me-1 text-success"></i> Private</span>
                  </div>
                </div>
                <div class="mt-3 pt-3 border-top">
                  <a href="/user/call-history" class="btn btn-light btn-sm rounded-pill w-100 py-2.5 text-dark fw-semibold app-tap-active border">
                    View Call History Log
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- 5. Recent Consultations Log Feed -->
          <div class="app-card p-0 overflow-hidden mb-4">
            <div class="p-3.5 px-4 d-flex align-items-center justify-content-between border-bottom bg-white">
              <div>
                <h5 class="fw-bold mb-0 text-dark">Recent Consultations</h5>
                <small class="text-muted">Previous talks with your Life Advisor</small>
              </div>
              <a href="/user/call-history" class="small fw-semibold text-primary text-decoration-none">View All</a>
            </div>

            <% if (calls.length === 0) { %>
              <div class="text-center py-5 px-3">
                <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                  <i class="bi bi-telephone-heart text-muted fs-4"></i>
                </div>
                <h6 class="fw-bold text-dark mb-1">No Consultations Yet</h6>
                <p class="text-muted small mb-0">Whenever you're ready, tap "Call Life Advisor" to begin.</p>
              </div>
            <% } else { %>
              <div class="app-list-group border-0 rounded-0">
                <% calls.slice(0, 5).forEach(call => { %>
                  <% 
                    let badgeClass = "bg-success-subtle text-success";
                    let iconClass = "bi-telephone-inbound-fill text-success";
                    if (call.status === "Cancelled" || call.status === "Missed" || call.status === "Rejected") {
                      badgeClass = "bg-warning-subtle text-warning";
                      iconClass = "bi-telephone-x-fill text-warning";
                    }
                    if (call.status === "Failed" || (call.status && call.status.includes("No Credits"))) {
                      badgeClass = "bg-danger-subtle text-danger";
                      iconClass = "bi-exclamation-circle-fill text-danger";
                    }
                  %>
                  <div class="app-list-item">
                    <div class="d-flex align-items-center">
                      <div class="app-list-icon <%= badgeClass %>">
                        <i class="bi <%= iconClass %>"></i>
                      </div>
                      <div>
                        <strong class="d-block text-dark small"><%= call.receiverName || 'Life Advisor' %></strong>
                        <small class="text-muted">
                          <%= call.date ? call.date.toISOString().split('T')[0] : '' %> • <%= call.time %>
                        </small>
                      </div>
                    </div>
                    <div class="text-end">
                      <span class="badge <%= badgeClass %> rounded-pill px-2.5 py-1 small mb-1 d-inline-block"><%= call.status %></span>
                      <small class="d-block text-muted font-monospace"><%= call.duration %> (<%= call.credits %> cr)</small>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>

        </div>
      </main>
    </div>
  </div>

  <!-- Mobile Bottom Navigation Bar -->
  <%- include('../partials/app-bottom-nav') %>

  <!-- Shared JavaScript Scripts -->
  <%- include('../partials/scripts') %>
</body>
</html>

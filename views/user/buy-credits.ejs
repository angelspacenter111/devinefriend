<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="app-mode">

  <!-- Mobile-First App Top Bar -->
  <%- include('../partials/app-header', { pageTitle: 'Recharge Credits', showBack: true, backUrl: '/user/wallet' }) %>

  <div class="panel-wrapper">
    <!-- Desktop Left Sidebar -->
    <%- include('../partials/user-sidebar') %>

    <!-- Main Content Panel -->
    <div class="content-panel">
      <!-- Desktop Header Panel -->
      <header class="header-panel shadow-sm d-none d-lg-flex">
        <div class="d-flex align-items-center gap-3">
          <h4 class="mb-0 fw-bold">Purchase Credits</h4>
        </div>
        
        <div class="d-flex align-items-center gap-3">
          <div class="header-wallet-badge">
            <i class="bi bi-coin me-1"></i>
            <span class="fw-bold"><span class="simulated-balance"><%= user.credits %></span> Credits</span>
          </div>
          <a href="/user/profile" class="btn btn-light d-flex align-items-center gap-2 border rounded-pill py-1 px-3">
            <div class="rounded-circle bg-light-lavender d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
              <i class="bi bi-person text-purple"></i>
            </div>
            <span class="simulated-name fw-semibold text-dark small"><%= user.name %></span>
          </a>
          <a href="/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 d-flex align-items-center gap-1.5 fw-semibold" title="Logout">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
          </a>
        </div>
      </header>

      <!-- Main Contents Canvas -->
      <main class="main-content-inner">
        <div class="app-container">

          <!-- Low Credits Notice if redirected -->
          <div id="low-credits-alert" class="alert alert-warning border-0 rounded-4 mb-3 p-3 d-none shadow-sm" style="background-color: #FFF9E6; border-left: 4px solid #FFB800 !important;">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
              <div>
                <strong class="text-dark d-block">Credits Needed to Start Call</strong>
                <span class="text-muted small">You need at least 1 credit (1 minute) to connect with an advisor. Select a pack below.</span>
              </div>
            </div>
          </div>

          <!-- Current Balance Pill Banner -->
          <div class="app-card bg-light border-0 p-3 mb-4 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; font-size: 1.25rem;">
                <i class="bi bi-wallet2"></i>
              </div>
              <div>
                <span class="text-muted small d-block">Current Wallet Balance</span>
                <strong class="text-dark fs-5"><span class="simulated-balance"><%= user.credits %></span> Credits</strong>
              </div>
            </div>
            <span class="badge bg-white text-muted border rounded-pill px-3 py-1.5 small">1 Cr = 1 Min</span>
          </div>

          <h5 class="fw-extrabold text-dark mb-3">Select a Talk Pack</h5>

          <!-- Pack Grid (Mobile-friendly App Cards) -->
          <div class="row g-3 mb-4">
            <% if (typeof plans !== 'undefined' && plans && plans.length > 0) { %>
              <% plans.forEach(plan => { %>
                <div class="col-sm-6 col-lg-4">
                  <div class="app-card h-100 d-flex flex-column justify-content-between p-3.5 app-tap-active position-relative <%= plan.isPopular ? 'border-primary shadow-sm' : '' %>" <%= plan.isPopular ? 'style="border-width: 2px !important; background: linear-gradient(180deg, #FFFFFF 0%, #F5F1FF 100%);"' : '' %>>
                    <% if (plan.isPopular) { %>
                      <span class="position-absolute top-0 end-0 bg-primary text-white rounded-bottom-start-3 px-3 py-1 fw-bold" style="font-size: 0.72rem; border-bottom-left-radius: 12px;">MOST POPULAR</span>
                    <% } %>
                    <div>
                      <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge <%= plan.isPopular ? 'bg-purple-subtle text-purple' : 'bg-primary-subtle text-primary' %> rounded-pill px-2.5 py-1 small">
                          <%= plan.badge || plan.name %>
                        </span>
                        <i class="bi <%= plan.credits >= 50 ? 'bi-stars text-warning' : (plan.credits >= 20 ? 'bi-chat-heart text-primary' : 'bi-stopwatch text-muted') %>"></i>
                      </div>
                      <h4 class="fw-bold mb-0 <%= plan.isPopular ? 'text-purple' : 'text-dark' %>"><%= plan.credits %> Credits</h4>
                      <span class="text-muted small d-block mb-2"><%= plan.credits %> Minutes talk time</span>
                      <div class="fs-4 fw-extrabold <%= plan.isPopular ? 'text-purple' : 'text-dark' %> mb-3">₹<%= plan.price.toLocaleString('en-IN') %></div>
                      <p class="text-muted small mb-3"><%= plan.description || 'Seamless consultation with Life Advisor.' %></p>
                    </div>
                    <button class="btn <%= plan.isPopular ? 'btn-brand' : 'btn-outline-brand' %> rounded-pill w-100 py-2.5 fw-bold btn-buy-credits" data-plan-id="<%= plan._id %>" data-credits="<%= plan.credits %>" data-price="₹<%= plan.price.toLocaleString('en-IN') %>">
                      Add ₹<%= plan.price.toLocaleString('en-IN') %>
                    </button>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <div class="col-12 text-center py-4 text-muted">No talk packs available currently.</div>
            <% } %>
          </div>

          <!-- Safe & Secure Guarantee Notice -->
          <div class="app-card bg-white border p-3 d-flex align-items-center gap-3 mb-4">
            <i class="bi bi-shield-check text-success fs-3"></i>
            <div class="small">
              <strong class="text-dark d-block">100% Confidential & Secure Recharges</strong>
              <span class="text-muted">Credits never expire. Deducted continuously per second while connected on a live call.</span>
            </div>
          </div>

        </div>
      </main>
    </div>
  </div>

  <!-- Mobile Bottom Navigation Bar -->
  <%- include('../partials/app-bottom-nav') %>

  <!-- Shared JavaScript Scripts -->
  <%- include('../partials/scripts') %>
  <script>
    if (new URLSearchParams(window.location.search).get('lowCredits') === 'true' || new URLSearchParams(window.location.search).get('insufficient') === 'true') {
      const alertEl = document.getElementById('low-credits-alert');
      if (alertEl) alertEl.classList.remove('d-none');
    }
  </script>
</body>
</html>

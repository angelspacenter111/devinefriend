<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="app-mode">

  <!-- Mobile-First App Top Bar -->
  <%- include('../partials/app-header', { pageTitle: 'Profile & Settings', showBack: true, backUrl: '/user/dashboard' }) %>

  <div class="panel-wrapper">
    <!-- Desktop Left Sidebar -->
    <%- include('../partials/user-sidebar') %>

    <!-- Main Content Panel -->
    <div class="content-panel">
      <!-- Desktop Header Panel -->
      <header class="header-panel shadow-sm d-none d-lg-flex">
        <div class="d-flex align-items-center gap-3">
          <h4 class="mb-0 fw-bold">Profile & Settings</h4>
        </div>
        
        <div class="d-flex align-items-center gap-3">
          <div class="header-wallet-badge">
            <i class="bi bi-coin me-1"></i>
            <span class="fw-bold"><span class="simulated-balance"><%= user.credits %></span> Coins</span>
          </div>
          <a href="/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 d-flex align-items-center gap-1.5 fw-semibold" title="Logout">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
          </a>
        </div>
      </header>

      <!-- Main Contents Canvas -->
      <main class="main-content-inner">
        <div class="app-container">

          <% if (typeof successMessage !== 'undefined' && successMessage) { %>
            <div class="alert alert-success alert-dismissible fade show rounded-4 mb-3" role="alert">
              <i class="bi bi-check-circle-fill me-2"></i><%= successMessage %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% } %>
          <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-3" role="alert">
              <i class="bi bi-exclamation-triangle-fill me-2"></i><%= errorMessage %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% } %>

          <!-- Profile Header Card (App style) -->
          <div class="app-card text-center p-4 mb-4">
            <div class="rounded-circle mx-auto mb-3 text-white d-flex align-items-center justify-content-center shadow" style="width: 80px; height: 80px; font-size: 2.2rem; background: linear-gradient(135deg, #1769E0, #7B4DCE);">
              <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
            </div>
            <h4 class="fw-extrabold text-dark mb-1"><%= user.name %></h4>
            <span class="text-muted small d-block mb-3"><%= user.mobile %></span>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 bg-light rounded-pill border small">
              <span class="status-indicator-dot online"></span>
              <span class="text-muted">Account Active • <strong><%= user.credits %> Coins</strong></span>
            </div>
          </div>

          <!-- Settings Sections Grid -->
          <div class="row g-4">
            
            <!-- Personal Details Card -->
            <div class="col-lg-7">
              <div class="app-card h-100">
                <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                  <i class="bi bi-person-badge text-primary fs-5"></i>
                  <h5 class="fw-bold mb-0 text-dark">Personal Information</h5>
                </div>

                <form action="/user/profile" method="POST" id="user-profile-form">
                  <div class="mb-3">
                    <label for="profile-fullname" class="form-label small fw-semibold text-muted">Full Name / Screen Name</label>
                    <input type="text" class="form-control rounded-3 py-2.5" id="profile-fullname" name="name" value="<%= user.name %>" required>
                  </div>

                  <div class="mb-3">
                    <label for="profile-mobile" class="form-label small fw-semibold text-muted">Mobile Number</label>
                    <input type="text" class="form-control rounded-3 py-2.5" id="profile-mobile" name="mobile" value="<%= user.mobile %>" required>
                  </div>

                  <div class="mb-4">
                    <label for="profile-email" class="form-label small fw-semibold text-muted">Email (Optional)</label>
                    <input type="email" class="form-control rounded-3 py-2.5" id="profile-email" name="email" value="<%= user.email || '' %>" placeholder="name@example.com">
                    <small class="text-muted" style="font-size: 0.75rem;">Used for purchase invoices and critical account alerts.</small>
                  </div>

                  <button type="submit" class="btn btn-brand rounded-pill px-4 py-2.5 fw-semibold app-tap-active">
                    Save Profile Changes
                  </button>
                </form>
              </div>
            </div>

            <!-- Change Password Card -->
            <div class="col-lg-5">
              <div class="app-card h-100">
                <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                  <i class="bi bi-shield-lock text-purple fs-5"></i>
                  <h5 class="fw-bold mb-0 text-dark">Security & Password</h5>
                </div>

                <form action="/user/change-password" method="POST" id="user-password-form">
                  <div class="mb-3">
                    <label for="current-password" class="form-label small fw-semibold text-muted">Current Password</label>
                    <input type="password" class="form-control rounded-3 py-2" id="current-password" name="currentPassword" required placeholder="••••••••">
                  </div>

                  <div class="mb-3">
                    <label for="new-password" class="form-label small fw-semibold text-muted">New Password</label>
                    <input type="password" class="form-control rounded-3 py-2" id="new-password" name="newPassword" required placeholder="••••••••">
                  </div>

                  <div class="mb-4">
                    <label for="confirm-password" class="form-label small fw-semibold text-muted">Confirm New Password</label>
                    <input type="password" class="form-control rounded-3 py-2" id="confirm-password" name="confirmPassword" required placeholder="••••••••">
                  </div>

                  <button type="submit" class="btn btn-outline-brand rounded-pill w-100 py-2.5 fw-semibold app-tap-active">
                    Update Password
                  </button>
                </form>
              </div>
            </div>

          </div>

          <!-- App Guidance & Legal links (iOS grouped style) -->
          <div class="app-card p-0 overflow-hidden mt-4">
            <div class="app-list-group border-0 rounded-0">
              <a href="/faq" class="app-list-item">
                <div class="d-flex align-items-center">
                  <div class="app-list-icon bg-info-subtle text-info">
                    <i class="bi bi-question-circle"></i>
                  </div>
                  <div>
                    <strong class="d-block text-dark small">Help & Support Guides</strong>
                    <small class="text-muted">Frequently asked questions and usage guide</small>
                  </div>
                </div>
                <i class="bi bi-chevron-right text-muted small"></i>
              </a>

              <a href="/logout" class="app-list-item text-danger">
                <div class="d-flex align-items-center">
                  <div class="app-list-icon bg-danger-subtle text-danger">
                    <i class="bi bi-box-arrow-right"></i>
                  </div>
                  <div>
                    <strong class="d-block text-danger small">Log Out</strong>
                    <small class="text-muted">Sign out securely from this device</small>
                  </div>
                </div>
                <i class="bi bi-chevron-right text-danger small"></i>
              </a>
            </div>
          </div>

        </div>
      </main>
    </div>
  </div>

  <!-- Mobile Bottom Navigation Bar -->
  <%- include('../partials/app-bottom-nav') %>

  <!-- Shared JavaScript Scripts -->
  <%- include('../partials/scripts') %>
</body>
</html>

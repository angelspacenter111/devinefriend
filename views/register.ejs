<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body class="bg-soft-gradient min-vh-100 d-flex align-items-center py-5 position-relative">
  <div class="backdrop-glow"></div>

  <div class="container position-relative z-3">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        
        <div class="text-center mb-4">
          <a class="navbar-brand d-inline-flex flex-column align-items-center mb-2" href="/">
            <img src="/images/logo.png" alt="Talk With Ashu Logo" class="brand-logo-img brand-logo-lg mb-2">
            <span class="brand-text text-uppercase fw-extrabold fs-3">Talk With Ashu</span>
          </a>
          <p class="text-muted small">Talk. Be Heard. Feel Lighter.</p>
        </div>

        <div class="card-premium border-0 bg-white shadow-lg p-4 p-md-5">
          <div class="text-center mb-4">
            <h3 class="fw-bold text-dark">Create Account</h3>
            <p class="text-muted small">Choose any name you feel comfortable sharing.</p>
          </div>

          <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div class="alert alert-danger mb-3 py-2.5 rounded-3 text-center small" role="alert">
              <i class="bi bi-exclamation-triangle-fill me-2"></i><%= errorMessage %>
            </div>
          <% } %>

          <form action="/register" method="POST" class="auth-form-validate" id="registration-form" novalidate>
            <div class="mb-3">
              <label for="register-name" class="form-label form-label-custom">Full Name (or Screen Name)</label>
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0 border-1" style="border-radius: 10px 0 0 10px; border-color: rgba(24,32,51,0.1);"><i class="bi bi-person text-muted"></i></span>
                <input type="text" class="form-control form-control-custom border-start-0 ps-2" id="register-name" name="name" value="<%= typeof formData !== 'undefined' && formData && formData.name ? formData.name : '' %>" placeholder="John Doe" required style="border-radius: 0 10px 10px 0;">
              </div>
            </div>

            <!-- Email Address Field -->
            <div class="mb-3">
              <label for="register-email" class="form-label form-label-custom">Email Address</label>
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0 border-1" style="border-radius: 10px 0 0 10px; border-color: rgba(24,32,51,0.1);"><i class="bi bi-envelope text-muted"></i></span>
                <input type="email" 
                       class="form-control form-control-custom border-start-0 ps-2" 
                       id="register-email" 
                       name="email" 
                       value="<%= typeof formData !== 'undefined' && formData && formData.email ? formData.email : '' %>"
                       placeholder="name@example.com" 
                       autocomplete="email"
                       required 
                       style="border-radius: 0 10px 10px 0;">
              </div>
            </div>

            <!-- Contact Number Field -->
            <div class="mb-3">
              <label for="register-mobile" class="form-label form-label-custom">Contact Number</label>
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0 border-1" style="border-radius: 10px 0 0 10px; border-color: rgba(24,32,51,0.1);"><i class="bi bi-telephone text-muted"></i></span>
                <input type="tel" 
                       class="form-control form-control-custom border-start-0 ps-2" 
                       id="register-mobile" 
                       name="mobile" 
                       value="<%= typeof formData !== 'undefined' && formData && formData.mobile ? formData.mobile : '' %>"
                       placeholder="Enter contact number" 
                       maxlength="10"
                       inputmode="numeric"
                       pattern="[0-9]*"
                       autocomplete="tel"
                       required 
                       style="border-radius: 0 10px 10px 0;">
              </div>
            </div>

            <div class="mb-3">
              <label for="register-password" class="form-label form-label-custom">Password</label>
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0 border-1" style="border-radius: 10px 0 0 10px; border-color: rgba(24,32,51,0.1);"><i class="bi bi-lock text-muted"></i></span>
                <input type="password" 
                       class="form-control form-control-custom border-start-0 border-end-0 ps-2" 
                       id="register-password" 
                       name="password" 
                       placeholder="At least 6 characters" 
                       minlength="6" 
                       autocomplete="new-password"
                       autocapitalize="none"
                       autocorrect="off"
                       spellcheck="false"
                       required>
                <button type="button" class="input-group-text bg-white border-start-0 border-1 toggle-password-btn" data-target="register-password" style="border-radius: 0 10px 10px 0; border-color: rgba(24,32,51,0.1); cursor: pointer;">
                  <i class="bi bi-eye text-muted"></i>
                </button>
              </div>
            </div>

            <div class="mb-3">
              <label for="register-confirm" class="form-label form-label-custom">Confirm Password</label>
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0 border-1" style="border-radius: 10px 0 0 10px; border-color: rgba(24,32,51,0.1);"><i class="bi bi-lock-fill text-muted"></i></span>
                <input type="password" 
                       class="form-control form-control-custom border-start-0 border-end-0 ps-2" 
                       id="register-confirm" 
                       name="confirmPassword" 
                       placeholder="••••••••" 
                       minlength="6" 
                       autocomplete="new-password"
                       autocapitalize="none"
                       autocorrect="off"
                       spellcheck="false"
                       required>
                <button type="button" class="input-group-text bg-white border-start-0 border-1 toggle-password-btn" data-target="register-confirm" style="border-radius: 0 10px 10px 0; border-color: rgba(24,32,51,0.1); cursor: pointer;">
                  <i class="bi bi-eye text-muted"></i>
                </button>
              </div>
              <div id="password-match-feedback" class="small mt-1 px-1 fw-medium" style="display: none; font-size: 0.82rem;"></div>
            </div>

            <div class="mb-4">
              <div class="form-check">
                <input type="checkbox" class="form-check-input" id="terms-check" required checked>
                <label class="form-check-label text-muted small" for="terms-check">
                  I agree to the <a href="#" class="text-primary-blue fw-semibold">Terms of Service</a> & <a href="#" class="text-primary-blue fw-semibold">Privacy Policy</a>
                </label>
              </div>
            </div>

            <button type="submit" id="btn-create-account" class="btn btn-brand w-100 py-3 mb-3">Create Account</button>
          </form>

          <div class="text-center mt-3 small">
            <span class="text-muted">Already have an account?</span>
            <a href="/login" class="text-primary-pink fw-semibold ms-1">Login</a>
          </div>
        </div>

        <div class="text-center mt-4">
          <a href="/" class="text-muted small"><i class="bi bi-arrow-left me-1"></i> Back to public home</a>
        </div>

      </div>
    </div>
  </div>

  <%- include('partials/scripts') %>

  <!-- Form Validation & Input Formatting Script -->
  <script>
    (function () {
      const nameInput = document.getElementById('register-name');
      const emailInput = document.getElementById('register-email');
      const mobileInput = document.getElementById('register-mobile');
      const form = document.getElementById('registration-form');
      const passwordInput = document.getElementById('register-password');
      const confirmInput = document.getElementById('register-confirm');
      const passFeedback = document.getElementById('password-match-feedback');

      // Password toggle visibility
      document.querySelectorAll('.toggle-password-btn').forEach(btn => {
        btn.addEventListener('click', function () {
          const targetId = this.getAttribute('data-target');
          const targetInput = document.getElementById(targetId);
          const icon = this.querySelector('i');
          if (targetInput.type === 'password') {
            targetInput.type = 'text';
            icon.classList.remove('bi-eye');
            icon.classList.add('bi-eye-slash');
          } else {
            targetInput.type = 'password';
            icon.classList.remove('bi-eye-slash');
            icon.classList.add('bi-eye');
          }
        });
      });

      // Only numeric values accepted and maximum 10 digits
      if (mobileInput) {
        mobileInput.addEventListener('input', function () {
          this.value = this.value.replace(/\D/g, '').slice(0, 10);
        });
      }

      // Password match validation
      function checkPasswords() {
        const p1 = passwordInput.value.trim();
        const p2 = confirmInput.value.trim();
        if (!p2) {
          passFeedback.style.display = 'none';
          confirmInput.classList.remove('is-valid', 'is-invalid');
          return true;
        }
        if (p1 !== p2) {
          passFeedback.style.display = 'block';
          passFeedback.className = 'small mt-1 px-1 fw-medium text-danger';
          passFeedback.innerHTML = '<i class="bi bi-exclamation-circle-fill me-1"></i>Passwords do not match.';
          confirmInput.classList.remove('is-valid');
          confirmInput.classList.add('is-invalid');
          return false;
        } else {
          passFeedback.style.display = 'block';
          passFeedback.className = 'small mt-1 px-1 fw-medium text-success';
          passFeedback.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>Passwords match.';
          confirmInput.classList.remove('is-invalid');
          confirmInput.classList.add('is-valid');
          return true;
        }
      }

      confirmInput.addEventListener('input', checkPasswords);
      passwordInput.addEventListener('input', function () {
        if (confirmInput.value) checkPasswords();
      });

      // Form Submit Validation
      form.addEventListener('submit', function (e) {
        if (nameInput && !nameInput.value.trim()) {
          e.preventDefault();
          e.stopPropagation();
          nameInput.focus();
          nameInput.classList.add('is-invalid');
          alert('Please enter your full name or screen name.');
          return false;
        }
        if (nameInput) nameInput.classList.remove('is-invalid');

        const emailVal = emailInput ? emailInput.value.trim().toLowerCase() : '';
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailVal || !emailRegex.test(emailVal)) {
          e.preventDefault();
          e.stopPropagation();
          if (emailInput) {
            emailInput.focus();
            emailInput.classList.add('is-invalid');
          }
          alert('Please enter a valid email address.');
          return false;
        }
        if (emailInput) emailInput.classList.remove('is-invalid');

        const val = mobileInput.value.trim();

        if (!val || !/^\d+$/.test(val)) {
          e.preventDefault();
          e.stopPropagation();
          mobileInput.focus();
          mobileInput.classList.add('is-invalid');
          alert('Please enter a valid numeric contact number.');
          return false;
        }

        if (val.length > 10) {
          e.preventDefault();
          e.stopPropagation();
          mobileInput.focus();
          mobileInput.classList.add('is-invalid');
          alert('Contact number cannot exceed 10 digits.');
          return false;
        }

        mobileInput.classList.remove('is-invalid');

        const cleanPass = passwordInput.value.trim();
        const cleanConf = confirmInput.value.trim();

        if (cleanPass.length < 6) {
          e.preventDefault();
          passwordInput.focus();
          passwordInput.classList.add('is-invalid');
          alert('Password must be at least 6 characters long.');
          return false;
        }

        if (cleanPass !== cleanConf) {
          e.preventDefault();
          confirmInput.focus();
          checkPasswords();
          return false;
        }
      });
    })();
  </script>
</body>
</html>

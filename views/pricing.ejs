<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body>

  <%- include('partials/header') %>

  <!-- Hero Section -->
  <section class="section-padding bg-soft-gradient position-relative overflow-hidden text-center">
    <div class="backdrop-glow"></div>
    <div class="container position-relative z-3">
      <div class="max-width-800 mx-auto">
        <span class="badge-category mb-3">Pricing Models</span>
        <h1 class="display-5 fw-extrabold mb-4" style="color: #182033;">
          Pay Only for the <span class="text-primary-blue">Time You Talk.</span>
        </h1>
        <p class="lead text-muted mb-0">
          No subscriptions, no hidden setup fees. Buy coins in packages, use them as conversation minutes, and feel lighter.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Slider Calculator -->
  <section class="section-padding bg-white border-divider">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="card-premium p-4 p-md-5 border-0 bg-light text-center">
            <h3 class="fw-bold mb-3">Conversation Calculator</h3>
            <p class="text-muted small mb-4">Drag the slider below to estimate how many coins you need and check simulated price packs.</p>
            
            <div class="mb-4">
              <label for="pricing-slider" class="form-label fw-bold d-flex justify-content-between">
                <span>Call Duration:</span>
                <span class="text-primary-blue fs-5"><span id="calc-mins">30</span> Minutes / Coins</span>
              </label>
              <input type="range" class="form-range" id="pricing-slider" min="5" max="120" step="5" value="30">
            </div>

            <div class="row g-3 justify-content-center">
              <div class="col-6 col-sm-4">
                <div class="p-3 bg-white rounded-3 shadow-sm">
                  <span class="text-muted small d-block">Required Coins</span>
                  <span class="fw-extrabold fs-4 text-purple" id="calc-credits">30</span>
                </div>
              </div>
              <div class="col-6 col-sm-4">
                <div class="p-3 bg-white rounded-3 shadow-sm">
                  <span class="text-muted small d-block">Estimated Price</span>
                  <span class="fw-extrabold fs-4 text-primary-pink" id="calc-price">AED 60</span>
                </div>
              </div>
            </div>
            
            <a href="/register" class="btn btn-brand px-5 py-3 mt-4">Create Account to Load Balance</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Cards Grid -->
  <section class="section-padding bg-light border-divider">
    <div class="container">
      <div class="text-center max-width-600 mx-auto mb-5">
        <h2 class="fw-bold">Standard Coin Plans</h2>
        <p class="text-muted">Choose a package size that fits your current needs. Loaded coins do not expire.</p>
      </div>

      <div class="row g-4 justify-content-center">
        <% if (typeof plans !== 'undefined' && plans && plans.length > 0) { %>
          <% plans.forEach(plan => { %>
            <div class="col-md-6 col-lg-3">
              <div class="card-premium package-card <%= plan.isPopular ? 'popular' : '' %> bg-white h-100 text-center p-4 position-relative">
                <% if (plan.isPopular) { %>
                  <div class="popular-banner">Popular</div>
                <% } %>
                <span class="badge-category mb-3 <%= plan.isPopular ? 'text-purple' : '' %>" <%= plan.isPopular ? 'style="background-color: #F5F1FF;"' : '' %>>
                  <%= plan.badge || (plan.category === 'Video' ? 'Video Pack' : 'Standard') %>
                </span>
                <h4 class="fw-bold mb-1 <%= plan.isPopular ? 'text-purple' : '' %>"><%= plan.credits %> Coins</h4>
                <span class="text-muted d-block small mb-3">
                  <% if (plan.category === 'Video') { %>
                    <%= Math.floor(plan.credits / 2) %> Minutes of Video Call
                  <% } else if (plan.category === 'All') { %>
                    <%= plan.credits %> Voice or <%= Math.floor(plan.credits / 2) %> Video Mins
                  <% } else { %>
                    <%= plan.credits %> Minutes of Voice Call
                  <% } %>
                </span>
                <div class="package-price mb-3 <%= plan.isPopular ? 'text-purple' : '' %>">AED <%= plan.price.toLocaleString('en-US') %></div>
                <p class="text-muted small mb-4"><%= plan.description || 'Flexible coin pack to connect with Ashu.' %></p>
                <a href="/login" class="btn <%= plan.isPopular ? 'btn-brand' : 'btn-outline-brand' %> w-100 py-2.5 mt-auto">Buy <%= plan.name %></a>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="col-12 text-center py-4 text-muted">No pricing packages currently available.</div>
        <% } %>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
  <%- include('partials/scripts') %>
  <script>
    $(document).ready(function() {
      $("#pricing-slider").on("input", function() {
        const mins = $(this).val();
        $("#calc-mins").text(mins);
        $("#calc-credits").text(mins);
        
        let cost = 0;
        if (mins == 5) cost = 15;
        else if (mins == 10) cost = 25;
        else if (mins == 30) cost = 60;
        else if (mins == 60) cost = 120;
        else {
          cost = Math.round(mins * 2);
        }
        $("#calc-price").text("AED " + cost.toLocaleString());
      });
    });
  </script>
</body>
</html>

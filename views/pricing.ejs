<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body>

  <%- include('partials/header') %>

  <!-- Hero Section -->
  <section class="section-padding bg-soft-gradient position-relative overflow-hidden text-center">
    <div class="backdrop-glow"></div>
    <div class="container position-relative z-3">
      <div class="max-width-800 mx-auto">
        <span class="badge-category mb-3">Pricing Models</span>
        <h1 class="display-5 fw-extrabold mb-4" style="color: #182033;">
          Pay Only for the <span class="text-primary-blue">Time You Talk.</span>
        </h1>
        <p class="lead text-muted mb-0">
          No subscriptions, no hidden setup fees. Buy points in packages, use them as conversation minutes, and feel lighter.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Slider Calculator -->
  <section class="section-padding bg-white border-divider">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="card-premium p-4 p-md-5 border-0 bg-light text-center">
            <h3 class="fw-bold mb-3">Conversation Calculator</h3>
            <p class="text-muted small mb-4">Drag the slider below to estimate how many points you need and check simulated price packs.</p>
            
            <div class="mb-4">
              <label for="pricing-slider" class="form-label fw-bold d-flex justify-content-between">
                <span>Call Duration:</span>
                <span class="text-primary-blue fs-5"><span id="calc-mins">30</span> Minutes / Points</span>
              </label>
              <input type="range" class="form-range" id="pricing-slider" min="5" max="120" step="5" value="30">
            </div>

            <div class="row g-3 justify-content-center">
              <div class="col-6 col-sm-4">
                <div class="p-3 bg-white rounded-3 shadow-sm">
                  <span class="text-muted small d-block">Required Points</span>
                  <span class="fw-extrabold fs-4 text-purple" id="calc-credits">30</span>
                </div>
              </div>
              <div class="col-6 col-sm-4">
                <div class="p-3 bg-white rounded-3 shadow-sm">
                  <span class="text-muted small d-block">Estimated Price</span>
                  <span class="fw-extrabold fs-4 text-primary-pink" id="calc-price">₹799</span>
                </div>
              </div>
            </div>
            
            <a href="/register" class="btn btn-brand px-5 py-3 mt-4">Create Account to Load Balance</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Cards Grid -->
  <section class="section-padding bg-light border-divider">
    <div class="container">
      <div class="text-center max-width-600 mx-auto mb-5">
        <h2 class="fw-bold">Standard Point Plans</h2>
        <p class="text-muted">Choose a package size that fits your current needs. Loaded points do not expire.</p>
      </div>

      <div class="row g-4 justify-content-center">
        <!-- Plan 1 -->
        <div class="col-md-6 col-lg-3">
          <div class="card-premium package-card bg-white h-100 text-center p-4">
            <span class="badge-category mb-3">Starter</span>
            <h4 class="fw-bold mb-1">5 Points</h4>
            <span class="text-muted d-block small mb-3">5 Minutes of Voice Call</span>
            <div class="package-price mb-3">₹149</div>
            <p class="text-muted small mb-4">Great for a short check-in, talking through a quick challenge or question.</p>
            <a href="/login" class="btn btn-outline-brand w-100 py-2.5 mt-auto">Buy Starter Pack</a>
          </div>
        </div>

        <!-- Plan 2 -->
        <div class="col-md-6 col-lg-3">
          <div class="card-premium package-card popular bg-white h-100 text-center p-4">
            <div class="popular-banner">Popular</div>
            <span class="badge-category mb-3 text-purple" style="background-color: #F5F1FF;">Comfort</span>
            <h4 class="fw-bold mb-1 text-purple">30 Points</h4>
            <span class="text-muted d-block small mb-3">30 Minutes of Voice Call</span>
            <div class="package-price mb-3 text-purple">₹799</div>
            <p class="text-muted small mb-4">Our most recommended option. Allows for a calm, uninterrupted conversation.</p>
            <a href="/login" class="btn btn-brand w-100 py-2.5 mt-auto">Buy Comfort Pack</a>
          </div>
        </div>

        <!-- Plan 3 -->
        <div class="col-md-6 col-lg-3">
          <div class="card-premium package-card bg-white h-100 text-center p-4">
            <span class="badge-category mb-3">Deep Listen</span>
            <h4 class="fw-bold mb-1">60 Points</h4>
            <span class="text-muted d-block small mb-3">60 Minutes of Voice Call</span>
            <div class="package-price mb-3">₹1,499</div>
            <p class="text-muted small mb-4">Ideal for unpacking complex stress and establishing deep conversational steps.</p>
            <a href="/login" class="btn btn-outline-brand w-100 py-2.5 mt-auto">Buy Deep Pack</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
  <%- include('partials/scripts') %>
  <script>
    $(document).ready(function() {
      $("#pricing-slider").on("input", function() {
        const mins = $(this).val();
        $("#calc-mins").text(mins);
        $("#calc-credits").text(mins);
        
        let cost = 0;
        if (mins == 5) cost = 149;
        else if (mins == 10) cost = 299;
        else if (mins == 30) cost = 799;
        else if (mins == 60) cost = 1499;
        else {
          cost = Math.round((mins * 25) * 0.95);
        }
        $("#calc-price").text("₹" + cost.toLocaleString());
      });
    });
  </script>
</body>
</html>

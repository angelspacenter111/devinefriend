<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body class="bg-soft-gradient min-vh-100 d-flex align-items-center py-5 position-relative">
  <div class="backdrop-glow"></div>

  <div class="container position-relative z-3">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        
        <div class="text-center mb-4">
          <a class="navbar-brand d-inline-flex flex-column align-items-center mb-2" href="/">
            <img src="/images/logo.png" alt="Talk With Ashu Logo" class="brand-logo-img brand-logo-lg mb-2">
            <span class="brand-text text-uppercase fw-extrabold fs-3">Talk With Ashu</span>
          </a>
          <p class="text-muted small">Talk. Be Heard. Feel Lighter.</p>
        </div>

        <div class="card-premium border-0 bg-white shadow-lg p-4 p-md-5">
          <div class="text-center mb-4">
            <h3 class="fw-bold text-dark">Reset Password</h3>
            <p class="text-muted small">Enter your UAE mobile number. We will send you a verification code to reset your password.</p>
          </div>

          <form action="/login" method="GET" class="auth-form-validate">
            <div class="mb-4">
              <label for="forgot-mobile" class="form-label form-label-custom">UAE Mobile Number</label>
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0 border-1" style="border-radius: 10px 0 0 10px; border-color: rgba(24,32,51,0.1);"><i class="bi bi-telephone text-muted"></i></span>
                <input type="text" class="form-control form-control-custom border-start-0 ps-2" id="forgot-mobile" placeholder="e.g. 50 123 4567 or 050 123 4567" required style="border-radius: 0 10px 10px 0;">
              </div>
              <div class="form-text text-muted small mt-1" style="font-size: 0.78rem;">
                Supported prefixes: 050, 052, 054, 055, 056, 058.
              </div>
            </div>

            <button type="submit" class="btn btn-brand w-100 py-3 mb-3">Send Reset Code</button>
          </form>

          <div class="text-center mt-3 small">
            <span class="text-muted">Remembered your password?</span>
            <a href="/login" class="text-primary-pink fw-semibold ms-1">Login</a>
          </div>
        </div>

        <div class="text-center mt-4">
          <a href="/" class="text-muted small"><i class="bi bi-arrow-left me-1"></i> Back to public home</a>
        </div>

      </div>
    </div>
  </div>

  <%- include('partials/scripts') %>
</body>
</html>
